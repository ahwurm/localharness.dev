---
// /plugins/image/ — the image plugin (PluginPage template). Rows trace to localharness main @
// 582b69c: tools/builtin/image_plugin.py + generate_image_tool.py docstrings, spec 09 "The
// bundled plugins" + "Artifacts", SECURITY.md "Plugins", README plugins table.
import PluginPage from '../../layouts/PluginPage.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import Rows, { type Row } from '../../components/Rows.astro';
import ImagePlate from '../../components/ImagePlate.astro';

const blob = (p: string) => `https://github.com/ahwurm/localharness/blob/main/${p}`;

const how: Row[] = [
  ['studio', 'one tool', 'generate_image takes a prompt and a size; the server and workflow are settings, not arguments.'],
  ['server', 'your server', 'it sends a workflow template to your ComfyUI and waits up to timeout_s; the first picture also loads the model.'],
  ['box', 'never overwritten', 'each picture gets its own id, in a folder core assigns.'],
  ['shield', 'machine-level', 'a project folder cannot change the server or the workflow.'],
  ['check', 'doctor', 'checks that ComfyUI answers and has the template’s model files.'],
];
const surfaces: Row[] = [
  ['prompt', 'generate_image', 'the tool the agent calls in a session.'],
  ['box', 'localharness generate-image', 'makes a picture from the shell.'],
  ['doc', 'image.comfyui_url · image.workflow · image.timeout_s', 'the server, your own workflow, and how long to wait.'],
  ['repeat', 'slash commands', 'none.'],
  ['meter-off', 'localharness plugins enable image', 'off by default; disable turns it off again.'],
];
const receipts: [string, string][] = [
  ['image_plugin.py', blob('src/localharness/tools/builtin/image_plugin.py')],
  ['generate_image_tool.py', blob('src/localharness/tools/builtin/generate_image_tool.py')],
  ['core/artifacts.py', blob('src/localharness/core/artifacts.py')],
  ['spec 09 — artifacts', blob('docs/specs/09-hooks-plugins.md#artifacts')],
  ['SECURITY.md — plugins', blob('SECURITY.md#plugins')],
];
---

<PluginPage
  name="image"
  label="Image"
  icon="studio"
  description="The LocalHarness image plugin lets an agent make pictures with local models on your own ComfyUI server; one command turns it on and checks that the server answers."
  lead="Off by default — turn it on with your ComfyUI address and the agent can make pictures."
  surfaces={surfaces}
  receipts={receipts}
>
  <div class="mt-10">
    <FigureFrame num="01" caption="PLATE IMAGE — what the plugin owns, what core provides: one picture">
      <ImagePlate />
    </FigureFrame>
  </div>
  <p class="eyebrow mt-10">how it works</p>
  <Rows rows={how} class="grid gap-x-12 gap-y-2.5 xl:grid-flow-col xl:grid-rows-3" />
</PluginPage>
