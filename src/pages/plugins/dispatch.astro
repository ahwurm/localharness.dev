---
// /plugins/dispatch/ — the dispatch plugin, Discord as a channel (PluginPage template). Rows trace
// to localharness main @ 582b69c: dispatch/plugin.py + config.py docstrings, spec 09 "The bundled
// plugins", README plugins table + "Answering a permission prompt in Discord".
import PluginPage from '../../layouts/PluginPage.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import Rows, { type Row } from '../../components/Rows.astro';
import DispatchPlate from '../../components/DispatchPlate.astro';

const blob = (p: string) => `https://github.com/ahwurm/localharness/blob/main/${p}`;

const how: Row[] = [
  ['prompt', 'allowlisted messages', 'a message from an allowed user becomes a turn; the reply posts back.'],
  ['shield', 'questions in the chat', 'when the gate needs you, the bot asks and you answer with a reaction.'],
  ['layers', 'machine-level settings', 'the token, allow list and channels; a project cannot change who drives the agent.'],
  ['doc', 'the token', 'never printed; doctor checks it without logging in.'],
  ['repeat', 'no network at start', 'the bot connects when the session starts the channel, not before.'],
];
const surfaces: Row[] = [
  ['box', 'localharness start --channel discord', 'runs a session from Discord.'],
  ['doc', 'dispatch.discord.token · allow · channels · ack', 'the bot, who may drive it, where it listens, and the reaction it leaves.'],
  ['prompt', 'mode <name>', 'typed in the chat, works as /mode.'],
  ['repeat', 'commands and tools', 'none; it adds only a channel.'],
  ['meter-off', 'localharness plugins enable dispatch', 'enable asks the token (hidden) and your user id; --set does the same in a script.'],
  ['prompt', '/plugins enable dispatch', 'inside a running session: until it is set up, asks what it needs and checks it; then restarts with your conversation kept.'],
];
const receipts: [string, string][] = [
  ['dispatch/plugin.py', blob('src/localharness/dispatch/plugin.py')],
  ['dispatch/config.py', blob('src/localharness/dispatch/config.py')],
  ['dispatch/channel.py', blob('src/localharness/dispatch/channel.py')],
  ['adapters/discord.py', blob('src/localharness/dispatch/adapters/discord.py')],
  ['spec 09 — bundled plugins', blob('docs/specs/09-hooks-plugins.md#the-bundled-plugins')],
];
---

<PluginPage
  name="dispatch"
  label="Dispatch"
  icon="prompt"
  description="The LocalHarness dispatch plugin lets you drive your local agent from Discord: give it a bot token and your user id, and answer permission questions in the chat."
  lead="On once the dispatch extra is installed; turning it off leaves the terminal as it was."
  surfaces={surfaces}
  receipts={receipts}
>
  <div class="mt-10">
    <FigureFrame num="01" caption="PLATE DISPATCH — Discord as a channel, its settings on the machine: one session">
      <DispatchPlate />
    </FigureFrame>
  </div>
  <p class="eyebrow mt-10">how it works</p>
  <Rows rows={how} class="grid gap-x-12 gap-y-2.5 xl:grid-flow-col xl:grid-rows-3" />
</PluginPage>
