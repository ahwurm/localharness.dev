---
// /plugins/memory/ — the memory plugin (PluginPage template). The plates moved here from
// /architecture/#memory and were rebuilt against localharness main (memory unchanged from 98682e4
// to 582b69c, v0.16.0). Every row traces to docs/specs/09-hooks-plugins.md "The memory slot",
// memory/*.py docstrings, README.
import PluginPage from '../../layouts/PluginPage.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import Rows, { type Row } from '../../components/Rows.astro';
import MemoryPlateII from '../../components/MemoryPlateII.astro';
import MemoryDetailPlate from '../../components/MemoryDetailPlate.astro';

const blob = (p: string) => `https://github.com/ahwurm/localharness/blob/main/${p}`;

const scales: Row[] = [
  ['clock', 'each turn', 'it adds what it knows to the prompt, within a budget core sets.'],
  ['search', 'on demand', 'the agent searches by meaning, or pulls one fact in full.'],
  ['book', 'each session', 'ends with a one-line summary in memory.'],
  ['layers', 'for good', 'facts outlive the session, in a database per agent and a file you can read.'],
];
const learns: Row[] = [
  ['prompt', 'new facts', 'start as trusted as their writer has earned.'],
  ['check', 'repeats and updates', 'a fact seen again gains weight; a new value replaces the old, which stays on file.'],
  ['repeat', 'consolidation while idle', 'it replays what happened and strengthens the facts involved.'],
  ['gauge', 'one ranking', 'facts reach the prompt ranked by need, truth and stakes, until the budget runs out.'],
  ['shield', 'forgetting is opt-in', 'archiving unused facts is off by default; nothing is deleted.'],
  ['check', 'checked writes', 'each write is read back, and a failed one fails loudly.'],
];
const surfaces: Row[] = [
  ['prompt', '/memory', 'in a session: browse by tag, show, search, forget or promote.'],
  ['box', 'localharness memory', 'from the shell: list, show, edit, remove, archive or restore.'],
  ['search', 'memory_search · memory_get · remember', 'the tools the agent calls in a session.'],
  ['meter-off', 'memory.enabled', 'false removes the memory section, the tools and /memory.'],
];
const receipts: [string, string][] = [
  ['memory/plugin.py', blob('src/localharness/memory/plugin.py')],
  ['memory/sqlite.py', blob('src/localharness/memory/sqlite.py')],
  ['memory/consolidation.py', blob('src/localharness/memory/consolidation.py')],
  ['memory/salience.py', blob('src/localharness/memory/salience.py')],
  ['memory/resonance.py', blob('src/localharness/memory/resonance.py')],
  ['plugins/slot.py', blob('src/localharness/plugins/slot.py')],
  ['spec 09 — the memory slot', blob('docs/specs/09-hooks-plugins.md#the-memory-slot')],
];
---

<PluginPage
  name="memory"
  label="Memory"
  icon="layers"
  description="The LocalHarness memory plugin gives a local agent facts that outlive the session, recalled into each turn within a budget core sets and consolidated while idle."
  lead="On by default; it runs a small embedding model on your CPU, and turning it off leaves core’s memory slot empty."
  surfaces={surfaces}
  receipts={receipts}
>
  <div class="mt-10">
    <FigureFrame num="01" caption="PLATE M — the memory plugin behind the slot: what core calls, what the plugin owns">
      <MemoryPlateII />
    </FigureFrame>
  </div>
  <div class="mt-10 grid gap-x-12 gap-y-8 xl:grid-cols-2">
    <div>
      <p class="eyebrow">over time</p>
      <Rows rows={scales} />
    </div>
    <div>
      <p class="eyebrow">how it learns</p>
      <Rows rows={learns} />
    </div>
  </div>
  <div class="mt-12">
    <FigureFrame num="02" caption="DETAIL M·A — inside the store: one fact’s life">
      <MemoryDetailPlate />
    </FigureFrame>
  </div>
</PluginPage>
