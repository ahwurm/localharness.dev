---
// /plugins/web/ — the web plugin, the phone app (PluginPage template). Rows trace to
// localharness main @ 582b69c: cli/web_plugin.py, channels/web/protocol.py, SECURITY.md
// "`localharness web`", README plugins table + docs/web.md, CHANGELOG [0.16.0] Known limitations.
import PluginPage from '../../layouts/PluginPage.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import Rows, { type Row } from '../../components/Rows.astro';
import WebPlate from '../../components/WebPlate.astro';

const blob = (p: string) => `https://github.com/ahwurm/localharness/blob/main/${p}`;

const how: Row[] = [
  ['server', 'one command', 'localharness web serves the page and its event API; the server lives as long as that command.'],
  ['shield', 'this machine only', 'it listens on loopback unless you pass --allow-unsafe-bind; a proxy you run publishes it.'],
  ['prompt', 'a token on every request', 'pairing is a QR code that carries the token where no server log sees it, so you never type it.'],
  ['clock', 'it taps you', 'a lock-screen notification arrives when a long turn finishes or the gate needs you.'],
  ['search', 'untrusted, marked', 'results from the built-in web tools carry an untrusted label on the phone — a label, never a filter.'],
  ['check', 'one grant, two requests', 'an always-allow needs a second, single-use request, so one mis-tap cannot write it.'],
];
const surfaces: Row[] = [
  ['box', 'localharness web', 'serves the phone app; --rotate-token cuts off every paired phone.'],
  ['repeat', '--incognito · --replay · --ui-dir', 'pictures kept out of the phone’s cache, a recorded session, or your own page.'],
  ['prompt', 'slash commands', 'none of its own, and the phone page has no command menu.'],
  ['doc', 'settings', 'none yet — the port and the bind are flags.'],
  ['meter-off', 'localharness plugins disable web', 'on by default once the web extra is installed; disable takes the command away.'],
];
const notYet: Row[] = [
  ['globe', 'a reference page', 'the page it ships is bare — not a finished chat app.', 'shipped'],
  ['shield', 'no per-device revoke', 'rotating the token cuts off every phone at once.', 'shipped'],
  ['search', 'the label covers web tools only', 'a plugin tool that reads untrusted text is not labeled on the phone.', 'shipped'],
  ['layers', 'the memory screen', 'it has no promote button, and it has not yet been checked on a phone.', 'shipped'],
  ['clock', 'incognito is not private', 'memory, sessions and pictures are still written to the box.', 'shipped'],
];
const receipts: [string, string][] = [
  ['cli/web_plugin.py', blob('src/localharness/cli/web_plugin.py')],
  ['channels/web/protocol.py', blob('src/localharness/channels/web/protocol.py')],
  ['channels/web/channel.py', blob('src/localharness/channels/web/channel.py')],
  ['docs/web.md', blob('docs/web.md')],
  ['SECURITY.md — localharness web', blob('SECURITY.md#localharness-web')],
];
---

<PluginPage
  name="web"
  label="Web"
  icon="globe"
  description="The LocalHarness web plugin is the phone app: localharness web serves a token-locked page and event stream from your own machine, and marks web-tool results as untrusted."
  lead="The phone app is a plugin — it adds the web channel and the command that serves it, and switching it off removes both."
  surfaces={surfaces}
  notYet={notYet}
  receipts={receipts}
>
  <div class="mt-10">
    <FigureFrame num="01" caption="PLATE WEB — the phone channel and what it marks untrusted: one message">
      <WebPlate />
    </FigureFrame>
  </div>
  <p class="eyebrow mt-10">how it works</p>
  <Rows rows={how} class="grid gap-x-12 gap-y-2.5 xl:grid-flow-col xl:grid-rows-3" />
</PluginPage>
