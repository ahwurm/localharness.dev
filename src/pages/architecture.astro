---
// The engineer deep-dive — v3 "drawn to scale" (DRAWING-SPEC, 2026-07-09 evening).
// Five sections, each led by an LH-ARCH engineering plate emulating Alex's reference
// drawing (plate-full.png): PLATE I runtime (fig 01) → LoopPlate zoom (fig 02, kept
// verbatim — "great") → PLATE II memory + DETAIL A store-internals (figs 03-04) →
// PLATE III autoresearch (fig 05). A clean I·II·III in page order (Alex 2026-07-09
// night: delegation section + the over-window figure + the forward/pips REMOVED —
// bands open straight onto plates). Legacy anchors resolve via invisible alias divs:
// #delegation/#hard-parts/#security/#yaml nested in #system (Plate I carries the
// fenced-helpers story), #over-window in #memory, #scope + #run around GetInvolved;
// #context stays on #memory's container. DelegationPlate.astro + OverWindowDiagram
// .astro stay on disk unimported (cut for focus, not superseded).
// Every plate label verified against localharness PUBLIC origin/main @ v0.9.0 (2026-07-11);
// any branch-only work would appear ONLY inside plates as hatched `landing` boxes (none
// drawn as of v0.9.0 — the key carries the honesty). Explainer rows are icon-led (no numeral badges —
// the plates' circled numbers trace FLOW order, not row order).
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import FigureFrame from '../components/FigureFrame.astro';
import Interstitial from '../components/Interstitial.astro';
import SectionBand from '../components/SectionBand.astro';
import RuntimePlate from '../components/RuntimePlate.astro';
import LoopPlate from '../components/LoopPlate.astro';
import MemoryPlateII from '../components/MemoryPlateII.astro';
import MemoryDetailPlate from '../components/MemoryDetailPlate.astro';
import AutoresearchPlate from '../components/AutoresearchPlate.astro';
import GetInvolved from '../components/GetInvolved.astro';

// Receipt href builders — full GitHub blob/tree URLs on PUBLIC main.
const REPO = 'https://github.com/ahwurm/localharness';
const blob = (p: string) => `${REPO}/blob/main/${p}`;
const tree = (p: string) => `${REPO}/tree/main/${p}`;

// Explainer rows: [icon, keyword, clause] — the plain-language layer under each
// plate. Icon-led (parallel facts); last row of each list is the failure path.

// #system — the parts (what's on Plate I, in request-path order)
const parts: [IconName, string, string][] = [
  ['prompt', 'you', 'a terminal or a chat app; every conversation comes in the same way.'],
  ['agent', 'the orchestrator', 'one main agent reads your task and runs the loop: think, act, check, repeat.'],
  ['gauge', 'tools', 'read, write, run, search — an agent holds only the tools you allow.'],
  ['search', 'the helpers', 'specialists take delegated pieces, each in a fresh window, fenced to its job.'],
  ['server', 'the model server', 'the thinking runs on the server you already have — vLLM, llama.cpp, Ollama, LM Studio.'],
  ['repeat', 'the bus', 'every step is written down in order; the live view and the replay read it.'],
  ['layers', 'memory', 'what it learns outlives the session — gated on the way in, filed while idle.'],
];

// #loop — the gates that keep a turn honest (kept verbatim; last = failure path)
const loopGates: [IconName, string, string][] = [
  ['gauge', 'Budgets', 'every run gets a ceiling on how many actions it may take and how long it may run, checked before each step.'],
  ['prompt', 'Act-guard', 'if the model announces a plan but then stalls without doing anything, the harness nudges it once to actually take the step.'],
  ['check', 'Self-check', 'before a plain answer goes out, the model is asked to review its own work and confirm it, or fix it.'],
  ['repeat', 'Parse-repair', 'when the model’s tool request comes out garbled, the harness repairs the format and retries instead of crashing.'],
  ['shield', 'Stuck-detector', 'if it keeps repeating the same move without progress, the harness first nudges it, then stops the run rather than spin forever.'],
];

// #memory — at every scale (last = failure path across both groups)
const scales: [IconName, string, string][] = [
  ['doc', 'the window', 'big results park as short notes; one call pulls the full text back.'],
  ['search', 'the task', 'a document bigger than the window is read in sections — and the section notes persist.'],
  ['clock', 'the sitting', 'every step is recorded in order; each sitting ends with a short summary on the shelf.'],
  ['layers', 'for good', 'facts survive across sittings, in a database and a file you can read.'],
];
const learns: [IconName, string, string][] = [
  ['prompt', 'two ways in', 'it saves what you tell it to, and what surprises it.'],
  ['gauge', 'surprise, measured', 'it learns each tool’s usual result; a surprising failure is worth remembering.'],
  ['clock', 'new memories wait', 'fresh notes stay out of view until idle time confirms them.'],
  ['repeat', 'it sleeps on it', 'while idle, it files recurring lessons and lets stale ones fade.'],
  ['book', 'lessons become chapters', 'related lessons are written up as one chapter that keeps its identity as it grows.'],
  ['shield', 'corrections stay careful', 'when you say “that’s wrong,” the fix is saved separately and can be undone.'],
  ['check', 'it never pretends', 'every write is read back and checked; a failed write fails loudly.'],
];

// #autoresearch — the gate (last = failure path)
const gate: [IconName, string, string][] = [
  ['studio', 'a stronger model proposes', 'a separate, stronger model suggests one change at a time.'],
  ['box', 'tested in a throwaway copy', 'the change runs a fixed task set in a disposable checkout; your setup is never touched.'],
  ['gauge', 'held to a real bar', 'kept only if it clearly beats the current version, not if it just edges ahead by luck.'],
  ['clock', 'a sealed set it never sees', 'a final exam it cannot study for, checked only at the end.'],
  ['repeat', 'adopted as a commit', 'a win lands as a git commit; undoing it is one command.'],
  ['shield', 'the gate can say no', 'a change that misses the bar is archived, never adopted.'],
];

// Receipts per section: [label, href, external?]. Demo cross-links carry their own _pip.
const sysReceipts: [string, string, boolean][] = [
  ['src/localharness/', tree('src/localharness'), true],
  ['SECURITY.md', blob('SECURITY.md'), true],
  ['_getting started', '/#demo-startup', false],
];
const loopReceipts: [string, string, boolean][] = [
  ['agent/loop.py', blob('src/localharness/agent/loop.py'), true],
  ['_demo', '/#demo-research', false],
];
const memoryReceipts: [string, string, boolean][] = [
  ['memory/sqlite.py', blob('src/localharness/memory/sqlite.py'), true],
  ['memory/consolidation.py', blob('src/localharness/memory/consolidation.py'), true],
  ['memory/gate.py', blob('src/localharness/memory/gate.py'), true],
  ['agent/context.py', blob('src/localharness/agent/context.py'), true],
  ['_quality > speed', '/#demo-overwindow', false],
];
const autoresearchReceipts: [string, string, boolean][] = [
  ['autoresearch/experiment.py', blob('src/localharness/autoresearch/experiment.py'), true],
  ['autoresearch/proposer.py', blob('src/localharness/autoresearch/proposer.py'), true],
  ['autoresearch/archive.py', blob('src/localharness/autoresearch/archive.py'), true],
];
---

<Base
  title="LocalHarness — architecture"
  description="How LocalHarness works, drawn to scale: the shipped runtime on one plate, the agent loop and its gates, memory at every scale down to one fact's life, and the self-improving autoresearch loop."
>
  <h1 class="sr-only">LocalHarness — architecture</h1>

  <!-- #system — PLATE I: the whole shipped runtime, one request finding its way through. -->
  <section id="system" data-reveal>
    <SectionBand icon="box" title="The System" />
    <div class="container-site py-16 sm:py-20">
      <!-- legacy alias anchors for the removed delegation section (Plate I carries
           the fenced-helpers story): #delegation #hard-parts #security #yaml -->
      <div id="delegation"><div id="hard-parts"><div id="security"><div id="yaml"></div></div></div></div>
      <FigureFrame num="01" caption="PLATE I — the shipped runtime: one request finding its way through">
        <RuntimePlate />
      </FigureFrame>
      <p class="eyebrow mt-10">the parts</p>
      <ul class="mt-3 grid gap-x-12 gap-y-2.5 xl:grid-flow-col xl:grid-rows-4">
        {parts.map(([icon, kw, clause]) => (
          <li class="flex items-start gap-3">
            <Icon name={icon} class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">{kw}</span>
              <span class="text-sm text-dim">{clause}</span>
            </span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
        <span class="text-dim">_deeper</span>
        {sysReceipts.map(([label, href, ext]) => (
          <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} class="text-accent/80 transition-colors hover:text-accent">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>

  <!-- #loop — one turn and the gates that keep it honest (kept verbatim — fig. 02). -->
  <section id="loop" data-reveal>
    <SectionBand icon="repeat" title="The Loop" />
    <div class="container-site py-16 sm:py-20">
      <p class="measure text-dim">
        One turn at a time — read, act, check. Gates keep a run honest and stop it running away.
      </p>
      <div class="mt-10 grid gap-10 xl:grid-cols-[2fr_3fr] xl:items-start">
        <div class="min-w-0 xl:order-last">
          <FigureFrame num="02" caption="one turn — and the gates that keep it honest">
            <LoopPlate />
          </FigureFrame>
        </div>
        <div>
          <p class="eyebrow">the gates</p>
          <ul class="mt-3 space-y-2.5">
            {loopGates.map(([icon, kw, clause]) => (
              <li class="flex items-start gap-3">
                <Icon name={icon} class="size-4" />
                <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                  <span class="font-mono text-[13px] text-ink">{kw}</span>
                  <span class="text-sm text-dim">{clause}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
        <span class="text-dim">_deeper</span>
        {loopReceipts.map(([label, href, ext]) => (
          <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} class="text-accent/80 transition-colors hover:text-accent">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>

  <Interstitial icon="layers" lead="Each turn ends; what it learned doesn't" rest="— memory carries it to the next one." />

  <!-- #memory — PLATE II + DETAIL A (figs 03-04). #context on the container;
       #over-window alias div inside (its figure was removed). -->
  <section id="memory" data-reveal>
    <SectionBand icon="layers" title="Memory" topBorder={false} />
    <div id="context" class="container-site py-16 sm:py-20">
      <div id="over-window"></div>
      <p class="measure text-dim">
        It takes notes while it works, and files them while it sleeps — memory at every scale,
        from one window to forever.
      </p>
      <div class="mt-10">
        <FigureFrame num="03" caption="PLATE II — hierarchical memory: fast capture, slow consolidation, recall">
          <MemoryPlateII />
        </FigureFrame>
      </div>
      <div class="mt-10 grid gap-x-12 gap-y-8 xl:grid-cols-2">
        <div>
          <p class="eyebrow">at every scale</p>
          <ul class="mt-3 space-y-2.5">
            {scales.map(([icon, kw, clause]) => (
              <li class="flex items-start gap-3">
                <Icon name={icon} class="size-4" />
                <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                  <span class="font-mono text-[13px] text-ink">{kw}</span>
                  <span class="text-sm text-dim">{clause}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow">how it learns</p>
          <ul class="mt-3 space-y-2.5">
            {learns.map(([icon, kw, clause]) => (
              <li class="flex items-start gap-3">
                <Icon name={icon} class="size-4" />
                <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                  <span class="font-mono text-[13px] text-ink">{kw}</span>
                  <span class="text-sm text-dim">{clause}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-12">
        <FigureFrame num="04" caption="DETAIL A — inside the memory store: one fact's life">
          <MemoryDetailPlate />
        </FigureFrame>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
        <span class="text-dim">_deeper</span>
        {memoryReceipts.map(([label, href, ext]) => (
          <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} class="text-accent/80 transition-colors hover:text-accent">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>

  <Interstitial icon="repeat" lead="The settings are just a starting point" rest="— the harness tunes them itself and keeps only what measurably helps." />

  <!-- #autoresearch — PLATE III: the loop that tunes the harness (fig. 07). -->
  <section id="autoresearch" data-reveal>
    <SectionBand icon="gauge" title="Autoresearch" topBorder={false} />
    <div class="container-site py-16 sm:py-20">
      <p class="measure text-dim">It tries one change at a time and keeps it only if it measurably helps.</p>
      <div class="mt-10">
        <FigureFrame num="05" caption="PLATE III — the autoresearch loop: propose, gate, adopt — against its own corpus">
          <AutoresearchPlate />
        </FigureFrame>
      </div>
      <p class="eyebrow mt-10">the gate</p>
      <ul class="mt-3 grid gap-x-12 gap-y-2.5 xl:grid-flow-col xl:grid-rows-3">
        {gate.map(([icon, kw, clause]) => (
          <li class="flex items-start gap-3">
            <Icon name={icon} class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">{kw}</span>
              <span class="text-sm text-dim">{clause}</span>
            </span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
        <span class="text-dim">_deeper</span>
        {autoresearchReceipts.map(([label, href, ext]) => (
          <a href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} class="text-accent/80 transition-colors hover:text-accent">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Legacy alias anchors for the dropped sections (Base.astro redirect ids + old
       llms.txt links): #scope ("what it isn't") and #run ("run it") land on the close. -->
  <div id="scope">
    <div id="run">
      <GetInvolved />
    </div>
  </div>
</Base>
