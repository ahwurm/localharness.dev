---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Chip from '../../components/Chip.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Icon from '../../components/Icon.astro';
import SectionBand from '../../components/SectionBand.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import ReplayTerminal from '../../components/ReplayTerminal.astro';
import ShiftFlow from '../../components/ShiftFlow.astro';
import FigureFrame from '../../components/FigureFrame.astro';
import GetInvolved from '../../components/GetInvolved.astro';

const install = `/plugin marketplace add ahwurm/localshift
/plugin install localshift@localshift`;

// REAL captured run — no fabricated terminal output (site rule).
// Provenance: captured 2026-07-02 from a fresh worktree of
// github.com/ahwurm/localshift @ origin/main, vLLM at localhost:8000 serving
// qwen3.6-27b. Commands verbatim; the only normalizations are the sandbox path
// (/tmp/ls-demo → repo-relative) in the trace path. Raw captures in
// .planning/captures/ (untracked).
const runnerDemo = [
  { kind: 'cmd' as const, text: 'bin/localshift validate tasks/smoke.yaml', d: 300 },
  { kind: 'good' as const, text: 'OK tasks/smoke.yaml', d: 350 },
  { kind: 'cmd' as const, text: 'bin/localshift run tasks/smoke.yaml --engine local --date 2026-07-02', d: 700 },
  {
    kind: 'good' as const,
    text: 'OK smoke [local] model=qwen3.6-27b tokens=1358/52 dur=6.3s artifacts_ok=True trace=runs/smoke/local-20260702T124801Z.jsonl',
    d: 1600,
  },
  { kind: 'cmd' as const, text: 'bin/localshift check smoke --date 2026-07-02', d: 700 },
  { kind: 'out' as const, text: 'PASS [hard] artifact-present (artifact_exists): exists (19 bytes)', d: 500 },
  { kind: 'out' as const, text: 'PASS [soft] fixture-parses (artifact_parses): parses as json', d: 200 },
  { kind: 'out' as const, text: "PASS [hard] has-marker (contains): substring found: 'smoke ok'", d: 200 },
  { kind: 'out' as const, text: "PASS [soft] shape-ok (regex): pattern matched: 'localshift\\s+smoke'", d: 200 },
  {
    kind: 'out' as const,
    text: "PASS [hard] no-fabrication (forbid_regex): forbidden pattern absent: 'FABRICATED|PLACEHOLDER|TODO'",
    d: 200,
  },
  { kind: 'out' as const, text: 'PASS [soft] json-count (file_glob_count): matched 1 files (need >=1)', d: 200 },
  { kind: 'good' as const, text: '6/6 passed', d: 400 },
  { kind: 'cmd' as const, text: 'bin/localshift ledger', d: 700 },
  {
    kind: 'dim' as const,
    text: '2026-07-02T12:48:09.851195+00:00 smoke [local] model=qwen3.6-27b tokens=1358/52 exit=0 artifacts_ok=True',
    d: 400,
  },
];

const shiftRepo = 'https://github.com/ahwurm/localshift';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalShift',
    description:
      'Claude Code plugin that migrates recurring frontier-AI workloads to local LLMs — derived per-workload evals, blind 1v1 judging, and a no-fallback cutover. Migrated jobs run claude-free on the LocalHarness runtime.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    url: 'https://localharness.dev/localshift/',
    codeRepository: 'https://github.com/ahwurm/localshift',
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Python',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'LocalHarness', url: 'https://localharness.dev' },
  },
];
---

<Base
  title="LocalShift — migrate frontier-AI workloads to local LLMs"
  description="A Claude Code plugin that replicates headless AI jobs on local models, judges them blind against frontier, and cuts over what passes."
  ogImage="/og/localshift.png"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-14 text-center sm:pt-20">
      <div class="focus-in flex flex-wrap items-center justify-center gap-2">
        <Chip icon="prompt" label="Claude Code plugin" href="https://claude.com/product/claude-code" />
      </div>
      <h1
        class="focus-in mt-6 max-w-3xl text-[clamp(2.5rem,5.5vw,3.75rem)] font-semibold leading-[1.05] tracking-[-0.03em] [--fi-delay:100ms]"
      >
        Same workflow. Same output.<br /><span class="whitespace-nowrap text-accent">Much lower cost.</span>
      </h1>
      <p class="focus-in mt-5 max-w-xl text-dim [--fi-delay:220ms]">
        Point Claude Code at an AI job you pay for on repeat. It comes back running on your own
        model — free, with receipts.
      </p>
      <CodeBlock
        code={install}
        label="setup — two lines, in Claude Code"
        class="focus-in mt-9 w-full max-w-xl text-left [--fi-delay:340ms] [&_pre]:text-[13px]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:460ms]">
        <Button href={shiftRepo} external>view on github</Button>
        <Button href="#demo" variant="outline">watch it work</Button>
      </div>
    </div>
  </section>

  <!-- Getting Started (#pipeline) — the six-skill flow + the journey in plain words -->
  <section id="pipeline" data-reveal>
    <SectionBand icon="prompt" title="Getting Started" />
    <div class="container-site py-16 sm:py-20">
      <FigureFrame num="01" caption="six skills, one flow — every run leaves a receipt" class="max-w-4xl">
        <ShiftFlow />
      </FigureFrame>
      <div class="mt-10 grid max-w-4xl gap-x-10 gap-y-8 sm:grid-cols-2">
        <div>
          <p class="eyebrow">the journey</p>
          <ol class="mt-3 space-y-2.5">
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">1</span>
              <Icon name="download" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">install</span>
                <span class="text-sm text-dim">two lines, inside Claude Code</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">2</span>
              <Icon name="prompt" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">point</span>
                <span class="text-sm text-dim">name the job you pay for on repeat</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">3</span>
              <Icon name="gauge" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">prove</span>
                <span class="text-sm text-dim">builds the test, judges local against the original — blind</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">4</span>
              <Icon name="cloud-off" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">cut over</span>
                <span class="text-sm text-dim">the job runs on your model, claude-free</span>
              </span>
            </li>
          </ol>
          <p class="mt-5 font-mono text-xs">
            <a
              href={`${shiftRepo}/blob/main/docs/JOURNEY.md`}
              target="_blank"
              rel="noopener"
              class="text-accent/80 transition-colors hover:text-accent"
              >one job, start to finish ↗</a
            >
          </p>
        </div>

        <div>
          <p class="eyebrow">what you need</p>
          <ul class="mt-3 space-y-2.5">
            <li class="flex items-start gap-3">
              <Icon name="prompt" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">Claude Code</span>
                <span class="text-sm text-dim">the plugin runs inside it</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="server" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">a local model server</span>
                <span class="text-sm text-dim">vLLM · Ollama · llama.cpp</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="download" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">Python + uv</span>
                <span class="text-sm text-dim">one sync inside the plugin dir</span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo (#demo) — the migrated job's claude-free loop, replayed from a real capture -->
  <section id="demo" data-reveal>
    <SectionBand icon="server" title="Demo" />
    <div class="container-site py-16 sm:py-20">
      <div class="gap-10 xl:grid xl:grid-cols-[3fr_2fr]">
        <div class="min-w-0">
          <p class="mb-2 font-mono text-xs">
            <span class="text-accent/80">fig. 02</span> <span class="text-ink">— the migrated job, running claude-free</span>
          </p>
          <ReplayTerminal title="~/localshift — real smoke run · qwen3.6-27b on vLLM" lines={runnerDemo} />
          <p class="mt-2 font-mono text-[11px] text-dim">
            the whole claude-free loop — one of the checks: <span class="text-ink">no-fabrication</span>
          </p>
        </div>
        <div class="mt-6 xl:mt-0">
          <p class="eyebrow">what you're watching</p>
          <ol class="mt-3 space-y-2.5">
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">1</span>
              <Icon name="check" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">validate</span>
                <span class="text-sm text-dim">the task file is checked before anything runs</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">2</span>
              <Icon name="server" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">run</span>
                <span class="text-sm text-dim">your model does the work — no paid calls</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">3</span>
              <Icon name="shield" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">check</span>
                <span class="text-sm text-dim">hard pass-or-fail rules — one of them: no-fabrication</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">4</span>
              <Icon name="doc" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">ledger</span>
                <span class="text-sm text-dim">every run appends one receipt line</span>
              </span>
            </li>
          </ol>

          <p class="eyebrow mt-8">proven, not assumed</p>
          <ul class="mt-3 space-y-2.5">
            <li class="flex items-start gap-3">
              <Icon name="book" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">the author's own jobs</span>
                <span class="text-sm text-dim">production pipelines, migrated end-to-end and cut over — failures included</span>
              </span>
            </li>
          </ul>
          <p class="mt-5 font-mono text-xs">
            <a
              href={`${shiftRepo}/blob/main/docs/receipts/DOGFOOD-REPORT.md`}
              target="_blank"
              rel="noopener"
              class="text-accent/80 transition-colors hover:text-accent"
              >what broke and what held ↗</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Verdicts — honest outcomes, not a router -->
  <section id="verdicts" data-reveal>
    <SectionBand icon="shield" title="Verdicts" />
    <div class="container-site py-16 sm:py-20">
      <h3 class="text-xl font-medium tracking-[-0.01em] text-ink">It's not a router.</h3>
      <p class="measure mt-3 text-dim">
        Routers keep the paid model in the loop by design. LocalShift ends with the paid calls
        deleted, not proxied. Every job earns one of three verdicts:
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <VerdictCard name="migrate" tone="green" desc="Passes every check, judged blind against the original. Cut over." />
        <VerdictCard name="conditional" tone="amber" desc="Specific, fixable gaps. Migrate after the fix list." />
        <VerdictCard
          name="keep-frontier"
          tone="neutral"
          desc="Local can't meet the bar yet — said plainly. A first-class outcome, not a failure."
        />
      </div>
    </div>
  </section>

  <!-- Fast or Slow — the two cutover modes -->
  <section id="cutover" data-reveal>
    <SectionBand icon="gauge" title="Fast or Slow" />
    <div class="container-site py-16 sm:py-20">
      <h3 class="text-xl font-medium tracking-[-0.01em] text-ink">Same test underneath.</h3>
      <p class="measure mt-3 text-dim">Your call on how fast the paid calls go away.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="border border-edge bg-surface/60 p-8">
          <h3 class="text-xl font-semibold tracking-tight">Cut over now, optimize after</h3>
          <div class="mt-2 inline-block border border-accent/40 bg-accent/10 px-2 py-0.5 font-mono text-xs text-accent">fast</div>
          <p class="mt-3 text-sm text-dim">
            Move the whole job local in one pass. What breaks fails loudly — fix it on the
            receipts. Least effort, free from day one.
          </p>
        </div>
        <div class="border border-edge bg-surface/60 p-8">
          <h3 class="text-xl font-semibold tracking-tight">Migrate piece by piece</h3>
          <div class="mt-2 inline-block border border-amber/40 bg-amber/10 px-2 py-0.5 font-mono text-xs text-amber">slow</div>
          <p class="mt-3 text-sm text-dim">
            Judge each piece blind, one at a time. Flip only what passes — the rest stays where
            it is until it does.
          </p>
        </div>
      </div>
      <p class="mt-5 font-mono text-xs">
        <a
          href={`${shiftRepo}/blob/main/docs/CUTOVER.md`}
          target="_blank"
          rel="noopener"
          class="text-accent/80 transition-colors hover:text-accent"
          >the cutover recipe ↗</a
        >
      </p>
    </div>
  </section>

  <!-- Runs on LocalHarness -->
  <section class="border-t border-edge/70" data-reveal>
    <div class="container-site py-14 sm:py-16">
      <Card class="border-l-2 border-l-accent p-8 sm:p-10">
        <h2 class="text-2xl font-semibold tracking-tight">
          Runs on local<span class="text-accent">_</span>harness
        </h2>
        <p class="measure mt-3 text-dim">
          Migrated jobs run claude-free on LocalHarness — the open-source harness on the front
          page. It drives the model you're already running.
        </p>
        <div class="mt-6">
          <Button href="/" variant="outline">about localharness</Button>
        </div>
      </Card>
    </div>
  </section>

  <GetInvolved
    repo={shiftRepo}
    docsHref={`${shiftRepo}/tree/main/docs`}
    docsDesc="The journey, the cutover recipe, the receipts."
  />
</Base>
