---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PipelineStep from '../../components/PipelineStep.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import ReplayTerminal from '../../components/ReplayTerminal.astro';

const install = `/plugin marketplace add ahwurm/localshift
/plugin install localshift@localshift`;

// REAL captured run — no fabricated terminal output (site rule).
// Provenance: captured 2026-07-02 from a fresh worktree of
// github.com/ahwurm/localshift @ origin/main, vLLM at localhost:8000 serving
// qwen3.6-27b. Commands verbatim; the only normalizations are the sandbox path
// (/tmp/ls-demo → repo-relative) in the trace path. Raw captures in
// .planning/captures/ (untracked).
const runnerDemo = [
  { kind: 'cmd' as const, text: 'bin/localshift validate tasks/smoke.yaml', d: 300 },
  { kind: 'good' as const, text: 'OK tasks/smoke.yaml', d: 350 },
  { kind: 'cmd' as const, text: 'bin/localshift run tasks/smoke.yaml --engine local --date 2026-07-02', d: 700 },
  {
    kind: 'good' as const,
    text: 'OK smoke [local] model=qwen3.6-27b tokens=1358/52 dur=6.3s artifacts_ok=True trace=runs/smoke/local-20260702T124801Z.jsonl',
    d: 1600,
  },
  { kind: 'cmd' as const, text: 'bin/localshift check smoke --date 2026-07-02', d: 700 },
  { kind: 'out' as const, text: 'PASS [hard] artifact-present (artifact_exists): exists (19 bytes)', d: 500 },
  { kind: 'out' as const, text: 'PASS [soft] fixture-parses (artifact_parses): parses as json', d: 200 },
  { kind: 'out' as const, text: "PASS [hard] has-marker (contains): substring found: 'smoke ok'", d: 200 },
  { kind: 'out' as const, text: "PASS [soft] shape-ok (regex): pattern matched: 'localshift\\s+smoke'", d: 200 },
  {
    kind: 'out' as const,
    text: "PASS [hard] no-fabrication (forbid_regex): forbidden pattern absent: 'FABRICATED|PLACEHOLDER|TODO'",
    d: 200,
  },
  { kind: 'out' as const, text: 'PASS [soft] json-count (file_glob_count): matched 1 files (need >=1)', d: 200 },
  { kind: 'good' as const, text: '6/6 passed', d: 400 },
  { kind: 'cmd' as const, text: 'bin/localshift ledger', d: 700 },
  {
    kind: 'dim' as const,
    text: '2026-07-02T12:48:09.851195+00:00 smoke [local] model=qwen3.6-27b tokens=1358/52 exit=0 artifacts_ok=True',
    d: 400,
  },
];

// Six numbered stages — matches the shipped skills (skills/*/SKILL.md on main),
// plus the anytime `savings` receipts skill noted below the list.
const steps = [
  {
    title: 'Explore the workflow',
    skill: '/localshift:explore',
    output: 'WORKLOAD.md',
    desc: 'Goal, dataflow, tools, context footprint.',
  },
  {
    title: 'Design the eval',
    skill: '/localshift:design-eval',
    output: 'EVAL.md',
    desc: 'Quality dimensions, the good-enough bar, a feasibility verdict.',
  },
  {
    title: 'Build the framework',
    skill: '/localshift:build',
    output: 'task.yaml + checks.yaml + judge.md',
    desc: 'The task, its hard checks, the judging rubric.',
  },
  {
    title: 'Replicate locally',
    skill: '/localshift:replicate',
    output: 'runs + traces + artifacts',
    desc: 'The claude-free runner executes on your local endpoint.',
  },
  {
    title: 'Evaluate 1v1',
    skill: '/localshift:evaluate',
    output: 'EVAL-REPORT.md',
    desc: 'Blind local-vs-frontier judging ends in a verdict.',
  },
  {
    title: 'Cut over',
    skill: '/localshift:shift fast|slow',
    output: 'CUTOVER-<mode>.md',
    desc: 'The no-fallback cutover — frontier calls deleted, not proxied.',
  },
];
---

<Base
  title="LocalShift — migrate frontier-AI workloads to local LLMs"
  description="A Claude Code plugin that replicates headless AI jobs on local models, judges them blind against frontier, and cuts over what passes."
  ogImage="/og/localshift.png"
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-16 text-center sm:pt-24">
      <div class="focus-in flex flex-wrap items-center justify-center gap-2 font-mono text-xs text-dim">
        <span class="border border-edge px-2.5 py-1">Claude Code plugin</span>
      </div>
      <h1
        class="focus-in mt-6 max-w-3xl text-[clamp(2.5rem,5.5vw,3.75rem)] font-semibold leading-[1.05] tracking-[-0.03em] [--fi-delay:100ms]"
      >
        Same workflow. Same output.<br /><span class="whitespace-nowrap text-accent">Much lower cost.</span>
      </h1>
      <p class="focus-in mt-5 max-w-xl text-dim [--fi-delay:220ms]">
        Point Claude Code at a recurring headless workload — a scheduled job, a skill, a prompt. It
        comes back a local replica that runs for free on your hardware — with the receipts to
        trust it.
      </p>
      <CodeBlock
        code={install}
        label="in Claude Code"
        class="focus-in mt-9 w-full max-w-xl text-left [--fi-delay:340ms]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:460ms]">
        <Button href="https://github.com/ahwurm/localshift" external>view on github</Button>
        <Button href="#pipeline" variant="outline">how it works</Button>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section id="pipeline" class="border-y border-edge/70 bg-surface/40" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="pipeline" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        How it works.
      </h2>
      <p class="measure mt-3 text-dim">
        Claude Code explores, designs the eval, and judges each seat 1v1. The migrated job runs
        claude-free.
      </p>
      <ol class="mt-10 grid max-w-4xl gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          steps.map((s, i) => (
            <PipelineStep
              num={i + 1}
              title={s.title}
              skill={s.skill}
              output={s.output}
              desc={s.desc}
              last={true}
            />
          ))
        }
      </ol>
      <p class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-dim">
        <span class="border border-edge/70 bg-bg px-1.5 py-0.5 text-accent">/localshift:savings</span>
        <span>→ receipts from the run ledger — anytime</span>
      </p>
    </div>
  </section>

  <!-- The runner, live -->
  <section id="receipts" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="receipts" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        The runner, live.
      </h2>
      <p class="measure mt-3 text-dim">
        Validate, run on your endpoint, deterministic checks, an append-only receipt — the whole
        claude-free loop.
      </p>
      <ReplayTerminal
        title="~/localshift — real smoke run · qwen3.6-27b on vLLM"
        lines={runnerDemo}
        class="mt-8 max-w-4xl"
      />
      <p class="mt-4 font-mono text-xs text-dim">
        <span class="text-accent/80">fig. 01</span> — captured 2026-07-02 from a clean checkout,
        replayed verbatim. Even the checks are honest: <span class="text-ink">no-fabrication</span> is one of them.
      </p>
    </div>
  </section>

  <!-- Honest verdicts / not a router -->
  <section class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="verdicts" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Honest verdicts — it's not a router.
      </h2>
      <p class="measure mt-3 text-dim">
        Routers keep frontier in the loop by design. LocalShift ends in a no-fallback cutover —
        frontier calls deleted, not proxied — and every seat earns one of three verdicts,
        <em class="not-italic text-ink">good enough, and works</em> as the bar:
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <VerdictCard name="migrate" tone="green" desc="Passes every check and judged dimension. Cut over." />
        <VerdictCard name="conditional" tone="amber" desc="Specific, fixable gaps. Migrate after the fix list." />
        <VerdictCard
          name="keep-frontier"
          tone="neutral"
          desc="Local can't meet it yet — said plainly. A first-class outcome, not a failure."
        />
      </div>
    </div>
  </section>

  <!-- Two modes -->
  <section class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="cutover" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Two ways to shift.
      </h2>
      <p class="measure mt-3 text-dim">
        Same eval underneath — your call on how fast the frontier calls go away.
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="border border-edge bg-surface/60 p-8">
          <div class="font-mono text-xs text-accent">fast</div>
          <h3 class="mt-2 text-xl font-semibold tracking-tight">Cut over now, optimize after</h3>
          <p class="mt-3 text-sm text-dim">
            Move the whole workload local in one pass. Honest-fail seams catch what breaks, and
            the optimize-on-receipts loop closes the gap on your schedule. Least effort upfront,
            free from day one.
          </p>
        </div>
        <div class="border border-edge bg-surface/60 p-8">
          <div class="font-mono text-xs text-amber">slow</div>
          <h3 class="mt-2 text-xl font-semibold tracking-tight">Migrate seat by seat</h3>
          <p class="mt-3 text-sm text-dim">
            Judge each component blind 1v1 and flip only what passes — the rest stays frontier
            until it's ready. Higher day-one fidelity, more deliberate.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Runs on LocalHarness -->
  <section class="border-t border-edge/70" data-reveal>
    <div class="container-site py-14 sm:py-16">
      <Card class="border-l-2 border-l-accent p-8 sm:p-10">
        <h2 class="text-2xl font-semibold tracking-tight">
          Runs on local<span class="text-accent">_</span>harness
        </h2>
        <p class="measure mt-3 text-dim">
          Migrated jobs run claude-free on the LocalHarness runtime — any OpenAI-compatible
          endpoint: vLLM, Ollama, llama.cpp.
        </p>
        <div class="mt-6">
          <Button href="/" variant="outline">about localharness</Button>
        </div>
      </Card>
    </div>
  </section>
</Base>
