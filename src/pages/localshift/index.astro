---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PipelineStep from '../../components/PipelineStep.astro';
import VerdictCard from '../../components/VerdictCard.astro';

const install = `/plugin marketplace add ahwurm/localshift
/plugin install localshift@localshift`;

const steps = [
  {
    title: 'Explore the workflow',
    skill: '/localshift:explore',
    output: 'WORKLOAD.md',
    desc: 'Goal, dataflow, tools, context footprint.',
  },
  {
    title: 'Design the eval',
    skill: '/localshift:design-eval',
    output: 'EVAL.md',
    desc: 'Quality dimensions, the good-enough bar, a feasibility verdict.',
  },
  {
    title: 'Build the framework',
    skill: '/localshift:build',
    output: 'task.yaml + checks.yaml + judge.md',
    desc: 'The task, its hard checks, the judging rubric.',
  },
  {
    title: 'Replicate locally',
    skill: '/localshift:replicate',
    output: 'runs + traces + artifacts',
    desc: 'The claude-free runner executes on your local endpoint.',
  },
  {
    title: 'Evaluate 1v1',
    skill: '/localshift:evaluate',
    output: 'EVAL-REPORT.md',
    desc: 'Blind local-vs-frontier judging ends in a verdict.',
  },
];
---

<Base
  title="LocalShift — migrate frontier-AI workloads to local LLMs"
  description="A Claude Code plugin that replicates headless AI jobs on local models, judges them blind against frontier, and cuts over what passes."
  ogImage="/og/localshift.png"
>
  <!-- Hero -->
  <section class="container-site rise-in flex flex-col items-center pb-20 pt-24 text-center sm:pt-32">
    <div class="flex flex-wrap items-center justify-center gap-2 font-mono text-xs text-dim">
      <span class="rounded-full border border-edge px-2.5 py-1">Claude Code plugin</span>
    </div>
    <h1 class="mt-6 max-w-3xl text-balance text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.1] tracking-tight">
      Same workflow. Same output. <span class="whitespace-nowrap text-accent">Much lower cost.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-dim">
      Point Claude Code at a recurring headless workload — a scheduled job, a skill, a prompt. It
      comes back a local replica that runs for free on your hardware — with the receipts to trust it.
    </p>
    <CodeBlock code={install} label="in Claude Code" class="mt-8 w-full max-w-xl text-left" />
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <Button href="https://github.com/ahwurm/localshift" external>View on GitHub ↗</Button>
      <Button href="#pipeline" variant="outline">How it works</Button>
    </div>
  </section>

  <!-- Pipeline -->
  <section id="pipeline" class="border-y border-edge bg-surface/50">
    <div class="container-site py-24">
      <h2 class="text-3xl font-semibold tracking-tight">How it works</h2>
      <p class="mt-3 max-w-2xl text-dim">
        Claude Code explores, designs the eval, and judges each seat 1v1. Then you cut over — the
        frontier calls deleted, not proxied — and the migrated job runs claude-free.
      </p>
      <ol class="mt-12 max-w-2xl">
        {
          steps.map((s, i) => (
            <PipelineStep
              num={i + 1}
              title={s.title}
              skill={s.skill}
              output={s.output}
              desc={s.desc}
              last={i === steps.length - 1}
            />
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Honest verdicts -->
  <section class="container-site py-24">
    <h2 class="text-3xl font-semibold tracking-tight">Honest verdicts are the product</h2>
    <p class="mt-3 max-w-2xl text-dim">
      The bar is not frontier parity — it's <em class="text-ink">good enough, and works</em>,
      proven not assumed. Every seat earns one of three verdicts:
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <VerdictCard
        name="migrate"
        tone="green"
        desc="Passes every check and judged dimension. Cut over."
      />
      <VerdictCard
        name="conditional"
        tone="amber"
        desc="Specific, fixable gaps. Migrate after the fix list."
      />
      <VerdictCard
        name="keep-frontier"
        tone="neutral"
        desc="Local can't meet it yet — said plainly. A first-class outcome, not a failure."
      />
    </div>
  </section>

  <!-- Two modes -->
  <section class="container-site py-24">
    <h2 class="text-3xl font-semibold tracking-tight">Two ways to shift</h2>
    <p class="mt-3 max-w-2xl text-dim">
      Same eval underneath — your call on how fast the frontier calls go away.
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-edge bg-surface/50 p-8">
        <div class="font-mono text-xs uppercase tracking-wide text-accent">fast</div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Cut over now, optimize after</h3>
        <p class="mt-3 text-sm text-dim">
          Move the whole workload local in one pass. Honest-fail seams catch what breaks, and the
          optimize-on-receipts loop closes the gap to frontier on your schedule. Least effort
          upfront, free from day one.
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-surface/50 p-8">
        <div class="font-mono text-xs uppercase tracking-wide text-accent">slow</div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Migrate seat by seat</h3>
        <p class="mt-3 text-sm text-dim">
          Judge each component blind 1v1 and flip only what passes — the rest stays frontier until
          it's ready. Higher day-one fidelity, more deliberate.
        </p>
      </div>
    </div>
  </section>

  <!-- Runs on LocalHarness -->
  <section class="container-site py-24">
    <Card class="border-l-2 border-l-accent p-8 sm:p-10">
      <h2 class="text-2xl font-semibold tracking-tight">
        Runs on local<span class="text-accent">_</span>harness
      </h2>
      <p class="mt-3 max-w-2xl text-dim">
        Migrated jobs run claude-free on LocalHarness — vLLM, Ollama, llama.cpp.
      </p>
      <div class="mt-6">
        <Button href="/" variant="outline">About LocalHarness</Button>
      </div>
    </Card>
  </section>
</Base>
