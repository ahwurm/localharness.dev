  <script>
    // Ledger replay: server renders the complete list; JS (motion permitting)
    // hides rows then appends them at ledger cadence. No-JS / reduced-motion
    // always see the full static list. Pane height is fixed — it never grows.
    document.querySelectorAll<HTMLElement>('[data-ledger]').forEach((root) => {
      if (root.dataset.lgInit) return;
      root.dataset.lgInit = '1';
      const list = root.querySelector<HTMLElement>('[data-lg-list]');
      const count = root.querySelector<HTMLElement>('[data-lg-count]');
      const rows = [...root.querySelectorAll<HTMLElement>('[data-lg-row]')];
      if (!list || !rows.length) return;
      const anchor = () => (list.scrollTop = list.scrollHeight);
      anchor();
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let played = false;
      new IntersectionObserver(
        (entries, io) => {
          if (!entries.some((e) => e.isIntersecting) || played) return;
          played = true;
          io.disconnect();
          rows.forEach((r) => (r.style.display = 'none'));
          if (count) count.textContent = '0';
          list.scrollTop = 0;
          rows.forEach((r, i) =>
            setTimeout(() => {
              r.style.display = '';
              if (count) count.textContent = String(i + 1);
              anchor();
            }, 400 + i * 280)
          );
        },
        { threshold: 0.35 }
      ).observe(root);
    });
  </script>
