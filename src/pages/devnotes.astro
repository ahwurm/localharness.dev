    entries: [
      { tag: 'Added', title: 'Start offers to create a workspace', body: 'When your project has no workspace folder, start offers to make one, and a declined offer is remembered for that directory.' },
      { tag: 'Added', title: 'Live reasoning stream', body: 'A new start option and terminal setting let you watch the model\'s reasoning as it streams.' },
      { tag: 'Added', title: 'Platform support section in the README', body: 'The README now documents what is supported on Linux and on Windows.' },
      { tag: 'Fixed', title: 'Empty completions no longer count as success', body: 'A reply that comes back empty no longer ends the turn as if the task had finished.' },
      { tag: 'Fixed', title: 'Windows shell commands work from PowerShell', body: 'The bash_exec tool now has the coreutils it needs on Windows when the harness is started from PowerShell, and a command that could not run is reported as a tool failure.' },
      { tag: 'Fixed', title: 'Startup summary keeps its warnings', body: 'The startup summary no longer deletes its own warnings, and an agent name containing brackets no longer breaks the agent picker.' },
    ],
  },
  {
    v: 'v0.13.0',
    date: 'Sep 4, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.13.0',
    entries: [
      { tag: 'Added', title: 'Workspace layers', body: 'A .localharness folder in your project now carries its own config, agents, memory and state layered over your global setup, with the workspace value winning on conflicts.' },
      { tag: 'Added', title: 'Trust prompt for outside config', body: 'You are asked before configuration that reaches in from outside your project is applied.' },
      { tag: 'Added', title: 'Per-project memory with a recall scope', body: 'A recall scope setting chooses workspace or global memory, and /memory promote moves a single memory across that line on purpose.' },
      { tag: 'Added', title: 'Workspace commands', body: 'Init --workspace scaffolds the project folder, doctor reports the layering, and config show prints the effective merged config.' },
      { tag: 'Changed', title: 'Filesystem confinement defaults to the project', body: 'In a workspace session the file tools are confined to the project root by default, and config errors now name the file that set the bad key.' },
      { tag: 'Fixed', title: 'Deny patterns in overrides are enforced', body: 'Deny patterns written in an overrides file and in org-level config now reach enforcement instead of only being stored.' },
    ],
  },
