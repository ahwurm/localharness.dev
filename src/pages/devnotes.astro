---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';

// Real shipped changes grouped by release, newest first. Versions on this page are
// a user directive (2026-07-02); entry bodies stay number-free. Each entry traces
// to a commit or CHANGELOG entry in github.com/ahwurm/localharness. A body may carry
// inline links as [text](href); `url` is the release's GitHub page.
const releases: { v: string; date: string; url?: string; entries: { tag: string; title: string; body: string }[] }[] = [
  {
    v: 'v0.16.0',
    date: 'Oct 3, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.16.0',
    entries: [
      {
        tag: 'Added',
        title: 'Core and plugins',
        body: 'Core now holds the loop, the tools, the config and the permissions, while [image](/plugins/image/), [mobile](/plugins/mobile/), [memory](/plugins/memory/), [dispatch](/plugins/dispatch/) and [autoresearch](/plugins/autoresearch/) ship as plugins you switch on or off behind one additive plugin API.',
      },
      {
        tag: 'Added',
        title: 'The memory slot',
        body: 'One memory plugin fills a section of every turn\'s prompt, and with [memory](/plugins/memory/) off that section stays empty and no memory tool is registered.',
      },
      {
        tag: 'Changed',
        title: 'Discord runs as the dispatch plugin',
        body: 'Discord now runs as the [dispatch](/plugins/dispatch/) plugin with its own settings in the config file, and the old environment variables still fill an unset setting, with a warning, until a later release removes them.',
      },
      {
        tag: 'Changed',
        title: 'Plugin commands, and a hint when one is off',
        body: 'The [autoresearch](/plugins/autoresearch/) plugin now mounts the autoresearch, experiment and propose commands, and a command whose plugin is off exits with a hint naming the command that turns it on.',
      },
      {
        tag: 'Fixed',
        title: 'A project can no longer switch off the capability floor',
        body: 'A project\'s own config can no longer switch the capability floor off; only the global config can, and start warns when a project tries.',
      },
      {
        tag: 'Added',
        title: 'Docs and code checked against each other',
        body: 'A test now reads the docs and the code and fails when they disagree.',
      },
    ],
  },
  {
    v: 'v0.15.0',
    date: 'Sep 19, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.15.0',
    entries: [
      { tag: 'Changed', title: 'Memory rebuilt around an embedding model', body: 'Search ranking, idle replay and duplicate detection now all judge similarity with a local embedding model instead of rule-based gates, tag graphs and keyword heuristics.' },
      { tag: 'Added', title: 'Dreaming and a writers ledger', body: 'Idle consolidation replays the session\'s own history to rank memories and group related ones, and each new memory starts with the track record of whoever wrote it.' },
      { tag: 'Added', title: 'Gated forgetting with restore', body: 'With archival enabled, memories that score below the store\'s own usefulness line are archived and can be brought back exactly with the memory restore command.' },
      { tag: 'Changed', title: 'Blacklisted calls are parked, not blocking', body: 'In auto mode a call on the blacklist is queued for a human while the turn carries on, and you answer later with /pending, /approve and /deny, ctrl+y and ctrl+n, or Discord reactions.' },
      { tag: 'Changed', title: 'Long sessions keep their compaction summary', body: 'A summary is written back into the session history, so later requests stop re-summarizing, and a context-window overflow from the server is recognized and retried against the window it named.' },
      { tag: 'Changed', title: 'Clearer tool and eviction messages', body: 'Evicted tool results now say which tool and path they replaced, an unknown tool name suggests the nearest match, and hard refusals state that nobody can approve them.' },
    ],
  },
  {
    v: 'v0.14.1',
    date: 'Sep 11, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.14.1',
    entries: [
      { tag: 'Changed', title: 'Default permission mode is now auto', body: 'The first time a workspace is opened you are asked once whether you trust it, and after that everything runs except a named blacklist of risky calls.' },
      { tag: 'Changed', title: 'Folders you have used are never asked about', body: 'A workspace with earlier LocalHarness sessions behind it is recognized and trusted with a one-line notice instead of a dialog.' },
      { tag: 'Changed', title: 'Startup asks a single question', body: 'The separate offer to create a project workspace folder is gone, and answering yes to the trust question now records trust and creates the folder together.' },
      { tag: 'Added', title: 'System directories are protected', body: 'Writes to system locations such as /etc, /usr and the Windows system folders now ask every time, while temporary directories are exempt.' },
      { tag: 'Added', title: 'Unattended mode is settable from a channel', body: 'You can now switch to unattended with /mode in the terminal, with mode in Discord, or from the Zed picker, where before it was config-only.' },
      { tag: 'Changed', title: 'Guarded mode is now opt-in', body: 'The ask-and-remember behavior is unchanged but you now choose it in config or with /mode, and an older config naming auto now simply loads as auto.' },
    ],
  },
  {
    v: 'v0.14.0',
    date: 'Sep 11, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.14.0',
    entries: [
      { tag: 'Added', title: 'Human approval gate on every tool call', body: 'A single deterministic check, subagents included, asks you when a call crosses your project boundary or looks destructive and stays quiet otherwise.' },
      { tag: 'Added', title: 'Remembered answers in grants.yaml', body: 'Your always and never answers are stored per workspace in your home folder, and a grants file inside a project is never read, so a cloned repo cannot approve itself.' },
      { tag: 'Added', title: 'Session modes and /mode', body: 'You can switch between guarded, trusted and read-only per session from the terminal or Discord, while unattended stays config-only.' },
      { tag: 'Added', title: 'LocalHarness in Zed\'s agent panel', body: 'The new acp command runs an Agent Client Protocol server so replies stream into Zed, edits land in its review pane, and permission prompts use its own dialog.' },
      { tag: 'Added', title: 'Permission prompts in Discord', body: 'The bot posts the question and you answer with a reaction for allow once, always in this workspace, or no.' },
      { tag: 'Fixed', title: 'Dangerous chmod block now works mid-command', body: 'The shipped deny list only caught the world-writable chmod form at the start of a command, so forms like find with exec or a command after && slipped through.' },
    ],
  },
  {
    v: 'v0.13.3',
    date: 'Sep 9, 2026',
    url: 'https://github.com/ahwurm/localharness/releases/tag/v0.13.3',
    entries: [
      { tag: 'Added', title: 'Status row shows what the model is doing', body: 'The row now shows the current phase such as thinking, writing or tool call with a live token tally, elapsed time, and a red silent marker when no output has arrived for a while.' },
      { tag: 'Added', title: 'Repetition loops are stopped mid-stream', body: 'A generation that locks into repeating itself is aborted as it happens, retried with a repetition penalty, and ends the turn with an explanation if it happens again.' },
      { tag: 'Changed', title: 'No turn time limit by default', body: 'The maximum turn duration now defaults to no limit, so slow hardware is no longer cut off mid-task, and you can still set a number to pin one.' },
      { tag: 'Changed', title: 'Edit now comes with write', body: 'A subagent given write also gets edit, edit returns a diff of its change, and write over an existing file reports how many lines changed.' },
    ],
  },
  {
    v: 'v0.13.2',
