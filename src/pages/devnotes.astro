      { tag: 'Changed', title: 'A cut-off reply now means the window is full', body: 'With no cap in the request, a truncated reply is reported as a full context window and points you to compaction rather than offering to raise a cap.' },
    ],
  },
  {
    v: 'v0.13.1',
