// Splits a body on [text](href) into plain and link parts.
const parts = (body: string) =>
  body.split(/(\[[^\]]+\]\([^)]+\))/).map((s) => {
    const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1], href: m[2] } : { text: s };
  });

const tagStyle = (tag: string) =>
  tag === 'Added'
    ? 'border-accent/30 bg-accent/10 text-accent'
    : 'border-amber/30 bg-amber/10 text-amber';

// Icon-led rows: glyph + color follow the tag. Icon.astro bakes stroke-accent into
// every glyph, so text-amber alone can't recolor it — the descendant stroke override
// carries the amber for Changed/Fixed without touching the shared component.
const iconGlyph = (tag: string): IconName =>
  tag === 'Added' ? 'download' : tag === 'Changed' ? 'repeat' : 'check';
const iconColor = (tag: string) =>
  tag === 'Added' ? 'text-accent' : 'text-amber [&_*]:stroke-amber';
---

<Base
  title="Devnotes — LocalHarness"
  description="What's new in LocalHarness — releases, fixes, and added features."
>
  <section class="container-site max-w-2xl py-16 sm:py-24">
    <Eyebrow label="devnotes" />
    <h1 class="mt-3 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]">
      What's new.
    </h1>
    <p class="mt-4 text-dim">Release by release, newest first. The full history lives on GitHub.</p>

    <div class="relative mt-12">
      <span class="absolute inset-y-0 left-0 w-px bg-accent/25" aria-hidden="true"></span>
      <div class="flex flex-col gap-12">
        {
          releases.map((r, i) => (
            <section aria-label={r.v} data-reveal class="pl-5 sm:pl-6">
              <details class="release group" open={i === 0}>
                <summary class="-ml-5 flex cursor-pointer items-baseline gap-3 border-b border-edge pb-3 transition-colors duration-200 hover:border-accent/40 sm:-ml-6">
                  <span class="bg-bg">
                    <span class="border border-accent/40 bg-accent/10 px-2 py-0.5 font-mono text-sm text-accent">
                      {r.v}
                    </span>
                  </span>
                  <span class="font-mono text-xs text-dim">{r.date}</span>
                  {/* `latest` rides index 0 — the releases array must stay newest-first */}
                  {i === 0 && (
                    <span class="border border-accent/30 bg-accent/10 px-1.5 py-0.5 font-mono text-[11px] uppercase tracking-wide text-accent">
                      latest
                    </span>
                  )}
                  <span class="ml-auto font-mono text-sm text-dim" aria-hidden="true">
                    <span class="group-open:hidden">+</span>
                    <span class="hidden group-open:inline">−</span>
                  </span>
                </summary>
                <div class="divide-y divide-edge/60">
                {r.entries.map((n) => (
                  <article class="flex items-start gap-3 py-4">
                    <Icon name={iconGlyph(n.tag)} class={`mt-1 size-4 shrink-0 ${iconColor(n.tag)}`} />
                    <div class="min-w-0 flex-1">
                      <h2 class="text-base font-medium text-ink">
                        <span
                          class:list={[
                            'mr-2.5 inline-block border px-1.5 py-0.5 align-[0.1em] font-mono text-[11px] uppercase tracking-wide',
                            tagStyle(n.tag),
                          ]}
                        >
                          {n.tag}
                        </span>
                        {n.title}
                      </h2>
                      <p class="mt-2 text-sm leading-relaxed text-dim">
                        {parts(n.body).map((p) =>
                          p.href ? (
                            <a href={p.href} class="text-accent/80 underline decoration-accent/30 underline-offset-2 transition-colors hover:text-accent">{p.text}</a>
                          ) : (
                            p.text
                          ),
                        )}
                      </p>
                    </div>
                  </article>
                ))}
                </div>
                {r.url && (
                  <p class="pt-2 font-mono text-xs">
                    <a href={r.url} target="_blank" rel="noopener" class="text-accent/80 transition-colors hover:text-accent">release on github ↗</a>
                  </p>
                )}
              </details>
            </section>
          ))
        }
      </div>
      <p class="mt-12 pl-5 font-mono text-xs sm:pl-6">
        <a
          href="https://github.com/ahwurm/localharness/commits/main"
          target="_blank"
          rel="noopener"
          class="text-accent/80 transition-colors hover:text-accent"
          >full history on github ↗</a
        >
      </p>
    </div>
  </section>
</Base>

<style>
  /* releases collapse via native <details> — no JS, no-JS visitors get working
     disclosure. Marker stripped (the +/− glyph is the affordance, Nav's idiom). */
  .release > summary {
    list-style: none;
  }
  .release > summary::-webkit-details-marker {
    display: none;
  }

  /* entries fade in on open — pure CSS; instant under reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    .release > div {
      transition: opacity 0.18s var(--ease-reveal);
    }
    @starting-style {
      .release[open] > div {
        opacity: 0;
      }
    }
  }
</style>
