---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';

// Real shipped changes grouped by release, newest first. Versions on this page are
// a user directive (2026-07-02); entry bodies stay number-free. Each entry traces
// to a commit or CHANGELOG entry in github.com/ahwurm/localharness.
const releases = [
  {
    v: 'v0.5.3',
    date: 'Jul 2, 2026',
    entries: [
      {
        tag: 'Changed',
        title: 'Built-in subagents: quarantined or read-only, no exceptions',
        body: 'Two shell-holding specialist roles left the default roster after a live quality pass — one hung on an undeclared dependency on its first run, the other worked but had no business holding a shell by default. Both remain as documented opt-in examples. What ships now is exactly the set whose fences the security model can vouch for. (Released ahead of the in-progress memory milestone, which keeps the number below.)',
      },
      {
        tag: 'Fixed',
        title: 'Memory search survives real-world queries',
        body: 'Hyphenated terms, tickers, and slashes used to leak into the search syntax and error out. Query text is now quoted term-by-term, so punctuation is content, never an operator.',
      },
      {
        tag: 'Fixed',
        title: 'Instant answers end as answers',
        body: 'A question the model could answer without tools sometimes ended on a self-referential note instead of the answer. The loop now tells the model only its last reply is shown, and unchanged answers are confirmed with a sentinel the summary resolves back to the real text.',
      },
    ],
  },
  {
    v: 'v0.5.2',
    date: 'Jul 2, 2026',
    entries: [
      {
        tag: 'Added',
        title: 'Serial-by-default inference gate',
        body: 'Overlapping local runs used to stack prefills toward one shared GPU — the freeze-the-box failure mode. Inference toward a local endpoint is now serialized by default, in-process and across processes. Decode is engine-serialized anyway, so serial costs roughly nothing in wall-clock.',
      },
      {
        tag: 'Added',
        title: 'A download cap on web_fetch',
        body: 'Fetches stream to a hard body cap instead of buffering unbounded responses — one pathological URL can no longer eat the box. When the cap engages it is surfaced in the retained page, never silent.',
      },
      {
        tag: 'Changed',
        title: 'Cruncher chunks sized at the measured knee',
        body: 'Over-window chunks got bigger, to where recall peaks before lost-in-the-middle sets in: better recall and fewer leaves to reduce, at neutral wall-clock. A recall-and-cost win, not a speedup — scope stated honestly.',
      },
    ],
  },
  {
    v: 'v0.5.1',
    date: 'Jun 26, 2026',
    entries: [
      {
        tag: 'Added',
        title: 'Number provenance for big-document answers',
        body: 'When a document bigger than the context window is combined in stages, every figure in the final answer is checked back against the verbatim section notes. Anything untraceable is surfaced as a warning — never silently rewritten.',
      },
      {
        tag: 'Added',
        title: 'Security model in plain English',
        body: 'The threat model now lives in SECURITY.md: trust boundaries, the structural injection defense, and — plainly — what is not built yet.',
      },
    ],
  },
  {
    v: 'v0.5.0',
    date: 'Jun 25, 2026',
    entries: [
      {
        tag: 'Added',
        title: 'Lossless reading past the context window',
        body: 'A cruncher subagent splits oversize documents structure-aware and reads every section — nothing truncated. Content handles move results between agents without re-inlining the bytes.',
      },
      {
        tag: 'Added',
        title: 'The capability floor',
        body: 'Untrusted-ingested web or tool content can never co-reside with host-mutating tools in the same agent — defense-in-depth above model refusal.',
      },
    ],
  },
  {
    v: 'earlier',
    date: 'Jun 2026',
    entries: [
      {
        tag: 'Fixed',
        title: 'Hermetic test suite',
        body: 'The test suite runs without a configured home directory — a clean checkout is green from the first command.',
      },
      {
        tag: 'Added',
        title: 'Start opens to the default agent',
        body: 'The start command drops you straight into the default agent; the subagent picker moved behind a flag.',
      },
      {
        tag: 'Added',
        title: 'Web search in the box',
        body: 'Web search ships as a core dependency — no extra install to give an agent the web.',
      },
      {
        tag: 'Fixed',
        title: 'Markdown in the terminal',
        body: 'Agent responses render as Markdown instead of raw text.',
      },
      {
        tag: 'Fixed',
        title: 'Steadier context counting',
        body: 'The context counter handles literal special-token text instead of failing the turn.',
      },
    ],
  },
];

const tagStyle = (tag: string) =>
  tag === 'Added'
    ? 'border-accent/30 bg-accent/10 text-accent'
    : 'border-amber/30 bg-amber/10 text-amber';
---

<Base
  title="Devnotes — LocalHarness"
  description="What's new in LocalHarness — releases, fixes, and added features."
>
  <section class="container-site max-w-2xl py-16 sm:py-24">
    <Eyebrow label="devnotes" />
    <h1 class="mt-3 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]">
      What's new.
    </h1>
    <p class="mt-4 text-dim">Release by release, newest first. The full history lives on GitHub.</p>

    <div class="mt-12 flex flex-col gap-12">
      {
        releases.map((r) => (
          <section aria-label={r.v}>
            <header class="flex items-baseline gap-3 border-b border-edge pb-3">
              <span class="border border-accent/40 bg-accent/10 px-2 py-0.5 font-mono text-sm text-accent">
                {r.v}
              </span>
              <span class="font-mono text-xs text-dim">{r.date}</span>
            </header>
            <div class="divide-y divide-edge/60">
              {r.entries.map((n) => (
                <article class="py-4">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    <span
                      class:list={[
                        'shrink-0 border px-1.5 py-0.5 font-mono text-[11px] uppercase tracking-wide',
                        tagStyle(n.tag),
                      ]}
                    >
                      {n.tag}
                    </span>
                    <h2 class="text-base font-medium text-ink">{n.title}</h2>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-dim">{n.body}</p>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <a
      href="https://github.com/ahwurm/localharness/commits/main"
      target="_blank"
      rel="noopener"
      class="mt-12 inline-block font-mono text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >full history on github ↗</a
    >
  </section>
</Base>
