---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog — LocalHarness" description="Notes on local LLMs, agent harnesses, and the economics of AI automation.">
  <section class="container-site py-20 sm:py-24">
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
    <ul class="mt-10 divide-y divide-edge">
      {
        posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="group block py-6">
              <p class="font-mono text-xs text-dim">{fmt(p.data.date)}</p>
              <h2 class="mt-1.5 text-xl font-semibold tracking-tight group-hover:text-accent transition-colors duration-150">
                {p.data.title}
              </h2>
              <p class="mt-1.5 text-sm text-dim">{p.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
