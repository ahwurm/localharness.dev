---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Eyebrow from '../components/Eyebrow.astro';
import DemoSession from '../components/DemoSession.astro';
import Chip from '../components/Chip.astro';
import Icon from '../components/Icon.astro';
import LocalShiftPromo from '../components/LocalShiftPromo.astro';
import GetInvolved from '../components/GetInvolved.astro';

const install = `git clone https://github.com/ahwurm/localharness
cd localharness && uv sync
uv run localharness init
uv run localharness start`;

// The LOCAL_/HARNESS startup banner exactly as `localharness start` prints it —
// extracted mechanically from .planning/captures/start-main.txt into banner.txt.
// The blank separator row is reinserted between the two words.
import bannerRaw from '../data/banner.txt?raw';
const rows = bannerRaw.split('\n');
const banner = [...rows.slice(0, 6), '', ...rows.slice(6)].join('\n');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalHarness',
    description:
      'Open-source, model-agnostic hierarchical agent harness for local LLMs — the agent layer that runs on top of an inference engine (vLLM, Ollama, LM Studio, llama.cpp), not another one. Define agents in YAML and run them against any OpenAI-compatible endpoint.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    url: 'https://localharness.dev',
    codeRepository: 'https://github.com/ahwurm/localharness',
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Python',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'LocalHarness', url: 'https://localharness.dev' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalHarness',
    url: 'https://localharness.dev',
    sameAs: ['https://github.com/ahwurm/localharness'],
  },
];
---

<Base
  title="LocalHarness — AI agents on your own hardware"
  description="Open-source agent harness for local LLMs — the agent layer on top of vLLM, Ollama, LM Studio, or llama.cpp, not an inference engine. Same workflow, same output, much lower cost."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-14 text-center sm:pt-20">
      <h1 class="sr-only">LocalHarness — AI agents on your own hardware</h1>
      <pre
        aria-hidden="true"
        class="ascii-art focus-in overflow-hidden text-left text-[length:clamp(0.42rem,1.9vw,1.05rem)] leading-none text-accent">{banner}</pre>
      <p class="focus-in mt-6 font-mono text-sm text-dim [--fi-delay:120ms]">
        Describe a task, or <span class="text-accent">/help</span> for commands.
      </p>
      <p class="focus-in mt-5 font-mono text-sm text-dim [--fi-delay:240ms]">
        the agent layer for the endpoint you already run — not another inference engine
      </p>
      <div class="focus-in mt-4 flex max-w-[300px] flex-wrap items-center justify-center gap-2 [--fi-delay:320ms] sm:max-w-none">
        <Chip icon="server" label="vLLM" />
        <Chip icon="llama" label="Ollama" />
        <Chip icon="studio" label="LM Studio" />
        <Chip icon="cpp" label="llama.cpp" />
      </div>
      <CodeBlock
        code={install}
        label="install"
        class="focus-in mt-8 w-full max-w-xl text-left [--fi-delay:420ms] [&_pre]:text-[13px]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:540ms]">
        <Button href="https://github.com/ahwurm/localharness" external>view on github</Button>
        <Button href="#demo-section" variant="outline">watch it work</Button>
      </div>
    </div>
  </section>

  <!-- Watch it work -->
  <section id="demo-section" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="watch it work" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        A real session, replayed.
      </h2>
      <div class="mt-8">
        <DemoSession />
      </div>
      <p class="mt-4 font-mono text-xs text-dim">
        <span class="text-accent/80">fig. 01</span> — captured 2026-07-02, vLLM · qwen3.6-27b.
        Replayed from its own bus trace.
        <span class="mt-1 block"
          ><span class="text-ink">Untrusted web content never shares an agent with bash or write.</span>
          <a
            href="https://github.com/ahwurm/localharness/blob/main/SECURITY.md"
            target="_blank"
            rel="noopener"
            class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
            >SECURITY.md →</a
          ></span
        >
      </p>
    </div>
  </section>

  <!-- Tradeoff band -->
  <section class="border-y border-edge/70 bg-surface/40" aria-label="The tradeoff" data-reveal>
    <div class="container-site grid gap-8 py-12 sm:grid-cols-3 sm:gap-6">
      <div>
        <div class="flex items-center justify-between">
          <Icon name="repeat" class="size-5" />
          <span class="font-mono text-xs text-accent/50">01</span>
        </div>
        <h2 class="mt-3 text-lg font-semibold tracking-tight">Same workflow, same output</h2>
        <p class="mt-1.5 text-sm text-dim">The jobs you already run — unchanged.</p>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <Icon name="clock" class="size-5" />
          <span class="font-mono text-xs text-accent/50">02</span>
        </div>
        <h2 class="mt-3 text-lg font-semibold tracking-tight">It takes longer</h2>
        <p class="mt-1.5 text-sm text-dim">Local models are slower. That's the tradeoff.</p>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <Icon name="meter-off" class="size-5" />
          <span class="font-mono text-xs text-accent/50">03</span>
        </div>
        <h2 class="mt-3 text-lg font-semibold tracking-tight">Much lower cost</h2>
        <p class="mt-1.5 text-sm text-dim">Your hardware. No API meter, no telemetry.</p>
      </div>
    </div>
  </section>

  <!-- Built in -->
  <section id="agents" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="agents" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Built in.
      </h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <Card class="p-4">
          <Chip icon="agent" label="default" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">What start gives you — three lines of YAML.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="search" label="web-researcher" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Quarantined web tools; spawns its own fact-checker.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="doc" label="explore" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Read-only codebase scout.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="studio" label="yours" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">One command scaffolds it.</p>
        </Card>
      </div>
      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
        <a href="/architecture/#yaml" class="text-accent/80 transition-colors hover:text-accent">how agents are defined ↗</a>
        <a href="/architecture/#security" class="text-accent/80 transition-colors hover:text-accent">how quarantine works ↗</a>
      </div>
    </div>
  </section>

  <LocalShiftPromo />
  <GetInvolved />
</Base>
