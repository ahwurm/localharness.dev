---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FigureFrame from '../components/FigureFrame.astro';
import DemoSession from '../components/DemoSession.astro';
import AgentYamlTabs from '../components/AgentYamlTabs.astro';
import OverWindowDiagram from '../components/OverWindowDiagram.astro';
import SecurityDiagram from '../components/SecurityDiagram.astro';
import AutoresearchDiagram from '../components/AutoresearchDiagram.astro';
import Chip from '../components/Chip.astro';

const install = `git clone https://github.com/ahwurm/localharness
cd localharness && uv sync
uv run localharness init
uv run localharness start`;

// The LOCAL_/HARNESS startup banner exactly as `localharness start` prints it —
// extracted mechanically from .planning/captures/start-main.txt into banner.txt.
// The blank separator row is reinserted between the two words.
import bannerRaw from '../data/banner.txt?raw';
const rows = bannerRaw.split('\n');
const banner = [...rows.slice(0, 6), '', ...rows.slice(6)].join('\n');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalHarness',
    description:
      'Open-source, model-agnostic hierarchical agent harness for local LLMs — the agent layer that runs on top of an inference engine (vLLM, Ollama, LM Studio, llama.cpp), not another one. Define agents in YAML and run them against any OpenAI-compatible endpoint.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    url: 'https://localharness.dev',
    codeRepository: 'https://github.com/ahwurm/localharness',
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Python',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'LocalHarness', url: 'https://localharness.dev' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalHarness',
    url: 'https://localharness.dev',
    sameAs: ['https://github.com/ahwurm/localharness'],
  },
];
---

<Base
  title="LocalHarness — AI agents on your own hardware"
  description="Open-source agent harness for local LLMs — the agent layer on top of vLLM, Ollama, LM Studio, or llama.cpp, not an inference engine. Same workflow, same output, much lower cost."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-14 text-center sm:pt-20">
      <h1 class="sr-only">LocalHarness — AI agents on your own hardware</h1>
      <pre
        aria-hidden="true"
        class="ascii-art focus-in overflow-hidden text-left text-[length:clamp(0.42rem,1.9vw,1.05rem)] leading-none text-accent">{banner}</pre>
      <p class="focus-in mt-6 font-mono text-sm text-dim [--fi-delay:120ms]">
        Describe a task, or <span class="text-accent">/help</span> for commands.
      </p>
      <p class="focus-in mt-5 font-mono text-sm text-dim [--fi-delay:240ms]">
        the agent layer for the endpoint you already run — not another inference engine
      </p>
      <div class="focus-in mt-4 flex max-w-[300px] flex-wrap items-center justify-center gap-2 [--fi-delay:320ms] sm:max-w-none">
        <Chip icon="server" label="vLLM" />
        <Chip icon="llama" label="Ollama" />
        <Chip icon="studio" label="LM Studio" />
        <Chip icon="cpp" label="llama.cpp" />
      </div>
      <CodeBlock
        code={install}
        label="install"
        class="focus-in mt-8 w-full max-w-xl text-left [--fi-delay:420ms] [&_pre]:text-[13px]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:540ms]">
        <Button href="https://github.com/ahwurm/localharness" external>view on github</Button>
        <Button href="#demo-section" variant="outline">watch it work</Button>
      </div>
    </div>
  </section>

  <!-- Watch it work -->
  <section id="demo-section" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="watch it work" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        A real session, replayed.
      </h2>
      <div class="mt-8">
        <DemoSession />
      </div>
      <p class="mt-4 font-mono text-xs text-dim">
        <span class="text-accent/80">fig. 01</span> — captured 2026-07-02, vLLM · qwen3.6-27b.
        Replayed from its own bus trace.
      </p>
    </div>
  </section>

  <!-- Tradeoff band -->
  <section class="border-y border-edge/70 bg-surface/40" aria-label="The tradeoff" data-reveal>
    <div class="container-site grid gap-8 py-12 sm:grid-cols-3 sm:gap-6">
      <div>
        <p class="font-mono text-xs text-accent/80">01</p>
        <h2 class="mt-2 text-lg font-semibold tracking-tight">Same workflow, same output</h2>
        <p class="mt-1.5 text-sm text-dim">The jobs you already run — unchanged.</p>
      </div>
      <div>
        <p class="font-mono text-xs text-accent/80">02</p>
        <h2 class="mt-2 text-lg font-semibold tracking-tight">It takes longer</h2>
        <p class="mt-1.5 text-sm text-dim">Local models are slower. That's the tradeoff.</p>
      </div>
      <div>
        <p class="font-mono text-xs text-accent/80">03</p>
        <h2 class="mt-2 text-lg font-semibold tracking-tight">Much lower cost</h2>
        <p class="mt-1.5 text-sm text-dim">Your hardware. No API meter.</p>
      </div>
    </div>
  </section>

  <!-- Agents are YAML -->
  <section id="yaml" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="configuration" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        The whole agent is a file you can read.
      </h2>
      <p class="measure mt-3 text-dim">Prompts, tools, permissions, memory — YAML, not Python.</p>
      <div class="mt-10 max-w-3xl">
        <AgentYamlTabs />
      </div>
    </div>
  </section>

  <!-- The hard parts: over-window reading + structural security -->
  <section id="hard-parts" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="the hard parts" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Built for the hard parts.
      </h2>
      <div class="mt-10 grid gap-10 xl:grid-cols-2">
        <div id="over-window" class="flex min-w-0 flex-col">
          <h3 class="text-lg font-semibold tracking-tight">
            Documents bigger than the context window
          </h3>
          <p class="mt-2 text-sm text-dim">
            Every section actually read. Every number traces back to its source.
          </p>
          <FigureFrame num="02" caption="the over-window read path" class="mt-5 xl:mt-auto">
            <OverWindowDiagram />
          </FigureFrame>
        </div>
        <div id="security" class="flex min-w-0 flex-col">
          <h3 class="text-lg font-semibold tracking-tight">Prompt injection, structurally</h3>
          <p class="mt-2 text-sm text-dim">
            Untrusted content never shares an agent with <code class="font-mono text-ink">bash</code>,
            <code class="font-mono text-ink">write</code>, or <code class="font-mono text-ink">edit</code>.
            Fails closed —
            <a
              href="https://github.com/ahwurm/localharness/blob/main/SECURITY.md"
              target="_blank"
              rel="noopener"
              class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
              >SECURITY.md</a
            >.
          </p>
          <FigureFrame num="03" caption="the capability floor" class="mt-5 xl:mt-auto">
            <SecurityDiagram />
          </FigureFrame>
        </div>
      </div>
    </div>
  </section>

  <!-- Autoresearch -->
  <section id="autoresearch" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="autoresearch" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        The harness improves itself — under a gate.
      </h2>
      <p class="measure mt-3 text-dim">
        One mutation at a time, adopted only if the stats say so.
      </p>
      <FigureFrame num="04" caption="propose → bench → gate → adopt" class="mt-8 max-w-3xl">
        <AutoresearchDiagram />
      </FigureFrame>
    </div>
  </section>

  <!-- What it isn't -->
  <section id="scope" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="scope" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        What it isn't.
      </h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <Card class="p-4">
          <Chip icon="box" label="not an inference engine" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Bring your own — LocalHarness is the layer above.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="cloud-off" label="not a cloud service" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Zero telemetry, zero external calls. MIT, yours.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="shield" label="not sandboxed yet" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">
            Deny-first permissions today; OS sandbox on the roadmap — SECURITY.md says so.
          </p>
        </Card>
        <Card class="p-4">
          <Chip icon="gauge" label="not 1.0" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">
            Early, honest about it — see
            <a href="/devnotes/" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">devnotes</a>.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- LocalShift cross-promo -->
  <section class="border-t border-edge/70" data-reveal>
    <div class="container-site py-14 sm:py-16">
      <Card class="border-l-2 border-l-accent p-8 sm:p-10">
        <h2 class="text-2xl font-semibold tracking-tight">
          local<span class="text-accent">_</span>shift
        </h2>
        <p class="measure mt-3 text-dim">
          Migrate metered frontier workloads — proven per workload, not assumed.
        </p>
        <div class="mt-6">
          <Button href="/localshift/" variant="outline">how it works</Button>
        </div>
      </Card>
    </div>
  </section>
</Base>
