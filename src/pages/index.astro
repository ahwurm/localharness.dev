---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import DemoPane from '../components/DemoPane.astro';
import TraceFlow from '../components/TraceFlow.astro';
import SectionBand from '../components/SectionBand.astro';
import { d1Lines, d3Lines, eventTotal } from '../data/demo-session';
import { d4Lines, agentsTailMeter } from '../data/demo-agents';
import Chip from '../components/Chip.astro';
import Card from '../components/Card.astro';
import { PLUGINS } from '../data/plugins';
import Icon from '../components/Icon.astro';
import GetInvolved from '../components/GetInvolved.astro';

// Installs the real `localharness` command from PyPI via uv — published since
// v0.9.9 (trusted publishing fires on every GitHub release), verified by a
// clean-env install test before this swap.
const install = `uv tool install localharness
localharness init
localharness start`;

// The LOCAL_/HARNESS startup banner exactly as `localharness start` prints it —
// extracted mechanically from .planning/captures/start-main.txt into banner.txt.
// The blank separator row is reinserted between the two words.
import bannerRaw from '../data/banner.txt?raw';
const rows = bannerRaw.split('\n');
const banner = [...rows.slice(0, 6), '', ...rows.slice(6)].join('\n');
const d3Events = d3Lines.flatMap((l) => l.ev ?? []);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalHarness',
    description:
      'Run AI agents on the model you already run locally. LocalHarness does not serve models — it sits on top of the server you already have (vLLM, llama.cpp, Ollama, or LM Studio) and gives it real agents: tools, memory, and permissions, written in YAML instead of Python. Free and open source. Nothing leaves your machine, and there is no per-token bill.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    url: 'https://localharness.dev',
    codeRepository: 'https://github.com/ahwurm/localharness',
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Python',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'LocalHarness', url: 'https://localharness.dev' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalHarness',
    url: 'https://localharness.dev',
    sameAs: ['https://github.com/ahwurm/localharness'],
  },
];
---

<Base
  title="LocalHarness — AI agents on your own hardware"
  description="Run AI agents on the model you already run at home. LocalHarness gives vLLM, llama.cpp, Ollama, or LM Studio real agents — tools, memory, and permissions — with no per-token bill and nothing leaving your machine."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-14 text-center sm:pt-20">
      <h1 class="sr-only">LocalHarness — AI agents on your own hardware</h1>
      <pre
        aria-hidden="true"
        class="ascii-art focus-in overflow-hidden text-left text-[length:clamp(0.42rem,1.9vw,1.05rem)] leading-none text-accent">{banner}</pre>
      <p class="focus-in mt-6 font-mono text-sm text-dim [--fi-delay:120ms]">
        The agent harness for the models you run locally
      </p>
      <!-- Chip tint = test status (repo docs/reference-architectures + gaps.md: vLLM AND
           llama.cpp are tier 1, both live-verified end to end — llama.cpp serves the default
           reference config; Ollama + LM Studio auto-detected, same API,
           not yet proven). Green chips lead the row. No "tested" label — the green says it
           (Alex 2026-07-11). -->
      <div class="focus-in mt-4 flex max-w-[300px] flex-wrap items-center justify-center gap-2 [--fi-delay:320ms] sm:max-w-none">
        <Chip icon="server" label="vLLM" tone="accent" href="https://docs.vllm.ai/en/latest/getting_started/installation/" />
        <Chip icon="cpp" label="llama.cpp" tone="accent" href="https://github.com/ggml-org/llama.cpp/releases" />
        <Chip icon="llama" label="Ollama" tone="dim" href="https://ollama.com/download" />
        <Chip icon="studio" label="LM Studio" tone="dim" href="https://lmstudio.ai/download" />
      </div>
      <CodeBlock
        code={install}
        label="install"
        class="focus-in mt-8 w-full max-w-xl text-left [--fi-delay:420ms] [&_pre]:text-[13px]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:540ms]">
        <Button href="https://github.com/ahwurm/localharness" external>view on github</Button>
        <Button href="#demo-section" variant="outline">watch it work</Button>
      </div>
    </div>
  </section>

  <!-- Getting Started (#demo-section > #demo-startup) — cold start to a working agent;
       terminal + get-running journey. FIRST demo section; #demo-section is the hero
       "watch it work" scroll target, so it stays here. -->
  <section id="demo-section" data-reveal>
    <SectionBand icon="prompt" title="Getting Started" />
    <div id="demo-startup" class="container-site py-16 sm:py-20">
      <div class="gap-10 xl:grid xl:grid-cols-[3fr_2fr] xl:min-h-[23rem]">
        <div class="min-w-0 xl:h-0 xl:min-h-full xl:flex xl:flex-col">
          <p class="mb-2 font-mono text-xs"><span class="text-accent/80">fig. 01</span></p>
          <DemoPane key="d1" title="~/localharness — real session · qwen3.6-27b on vLLM" lines={d1Lines} boxClass="xl:flex-1 xl:min-h-0" bodyClass="xl:flex-1 xl:min-h-0" />
        </div>
        <div class="mt-6 xl:mt-0">
          <!-- THE JOURNEY — numbered square-badge strip: model → server → three lines → agent -->
          <p class="eyebrow">the journey</p>
          <ol class="mt-3 space-y-2.5">
            <li class="flex items-center gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">1</span>
              <Icon name="download" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">model</span>
                <span class="text-sm text-dim">download any open-source model</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">2</span>
              <Icon name="server" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">server</span>
                <span class="text-sm text-dim"><span class="text-accent/80">vLLM</span> · <span class="text-accent/80">llama.cpp</span> · Ollama · LM Studio</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">3</span>
              <Icon name="prompt" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">three lines</span>
                <span class="text-sm text-dim">install · init · start</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">4</span>
              <Icon name="agent" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">agent</span>
                <span class="text-sm text-dim">zero to agent</span>
              </span>
            </li>
          </ol>

          <!-- WHAT INIT DOES — icon-led lockups (no numerals), the three init facts -->
          <p class="eyebrow mt-8">what init does</p>
          <ul class="mt-3 space-y-2.5">
            <li class="flex items-center gap-3">
              <Icon name="search" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">probes for what's running</span>
                <span class="text-sm text-dim">checks localhost for a live server</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="check" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">confirms it can act</span>
                <span class="text-sm text-dim">can trigger a command, not just chat</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="gauge" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">sets the limit itself</span>
                <span class="text-sm text-dim">reads it straight off the server</span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- Demo (#demo-research) — the agent loop, out of the box; web search included,
       delegated to a web-quarantined child. -->
  <section id="demo-research" data-reveal>
    <SectionBand icon="search" title="Demo" />
    <div class="container-site py-16 sm:py-20">
      <p class="mb-2 font-mono text-xs">
        <span class="text-accent/80">fig. 02</span> <span class="text-ink">— “Find the best open-weight coding model for an NVIDIA DGX Spark.”</span>
      </p>
      <div data-demo-scope id="demo-research-scope" class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
        <DemoPane
          key="d3"
          title="~/localharness — the agent loop, out of the box"
          lines={d3Lines}
          tailMeter="░░░░░░░░░░ 5%"
          eventTotal={eventTotal}
          boxClass="xl:h-0 xl:min-h-full"
          bodyClass="h-[420px] xl:h-auto xl:min-h-0 xl:flex-1"
        />
        <div class="flex min-w-0 flex-col gap-4">
          <div class="border border-edge bg-surface/60 p-4">
            <TraceFlow />
          </div>
          <div data-node="bus" class="flex min-h-0 flex-1 flex-col overflow-hidden border border-edge bg-surface/60">
            <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2 font-mono text-xs text-dim">
              <span>bus-events.jsonl — append-only</span>
              <span><span data-ev-count>{eventTotal}</span> events</span>
            </div>
            <ol data-ticker class="h-[132px] overflow-y-auto px-4 py-2 font-mono text-[11px] leading-[1.9] text-dim [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {d3Events.map((e, i) => <li data-ev={i}>{e}</li>)}
            </ol>
          </div>
        </div>
      </div>
      <div class="measure mt-6">
        <p class="eyebrow">fenced off</p>
        <ul class="mt-3 space-y-2.5">
          <li class="flex items-start gap-3">
            <Icon name="globe" class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">web search, built in</span>
              <span class="text-sm text-dim">hands it off to a helper walled off from the rest</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="box" class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">each helper is boxed in</span>
              <span class="text-sm text-dim">it starts clean, with only the tools its job needs</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="repeat" class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">a checker re-does the work</span>
              <span class="text-sm text-dim">it fetches the sources again from scratch</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="shield" class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">the web is marked untrusted</span>
              <span class="text-sm text-dim">it can't run commands or change files</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="check" class="size-4" />
            <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-mono text-[13px] text-ink">safe by default</span>
              <span class="text-sm text-dim">if it's unsure, it blocks the action</span>
            </span>
          </li>
        </ul>
        <p class="mt-5 font-mono text-xs">
          <a
            href="https://github.com/ahwurm/localharness/blob/main/SECURITY.md"
            target="_blank"
            rel="noopener"
            class="text-accent/80 transition-colors hover:text-accent"
            >SECURITY.md ↗</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Agents (#agents) — the roster in the box (v0.5.3: every default agent
       quarantined-or-read-only; data-analyst + frontend-designer are opt-in
       examples since the 2026-07-03 quality investigation) -->
  <section id="agents" data-reveal>
    <SectionBand icon="agent" title="Agents" />
    <div class="container-site py-16 sm:py-20">
      <div class="gap-10 xl:grid xl:grid-cols-[3fr_2fr] xl:min-h-[36rem]">
        <div class="min-w-0 xl:h-0 xl:min-h-full xl:flex xl:flex-col">
          <p class="mb-2 font-mono text-xs">
            <span class="text-accent/80">fig. 03</span> <span class="text-ink">— “List the subagents that ship built in…”</span>
          </p>
          <DemoPane
            key="d4"
            title="~/localharness — real session · fresh install"
            lines={d4Lines}
            tailMeter={agentsTailMeter}
            boxClass="xl:flex-1 xl:min-h-0"
            bodyClass="xl:flex-1 xl:min-h-0"
            restAt="top"
          />
        </div>
        <div class="mt-6 xl:mt-0">
          <p class="eyebrow">the roster</p>
          <ol class="mt-3 space-y-2.5">
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">1</span>
              <Icon name="agent" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">a bench of specialists</span>
                <span class="text-sm text-dim">the main agent calls them on its own — each with a clean slate</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">2</span>
              <Icon name="book" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">the cruncher</span>
                <span class="text-sm text-dim">reads text longer than the window in sections and returns a digest</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">3</span>
              <Icon name="shield" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">each fenced to its job</span>
                <span class="text-sm text-dim">only the tools its job needs — none can run commands or change files</span>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex size-5 shrink-0 items-center justify-center border border-accent/50 bg-accent/10 font-mono text-[11px] font-semibold text-accent">4</span>
              <Icon name="doc" class="size-4" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="font-mono text-[13px] text-ink">yours is one YAML file</span>
                <span class="text-sm text-dim">name, role, tools, budget — one command creates it for you</span>
              </span>
            </li>
          </ol>
          <p class="mt-5 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
            <a href="/architecture/#yaml" class="text-accent/80 transition-colors hover:text-accent">how agents are defined ↗</a>
            <a href="/architecture/#security" class="text-accent/80 transition-colors hover:text-accent">how quarantine works ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Customize (#customize) — replaced "Quality > Speed" (#demo-overwindow, now redirected
       to /architecture/#over-window in Base.astro). The bundled plugins in code order from
       src/data/plugins.ts, then the build-your-own receipts. -->
  <section id="customize" data-reveal>
    <SectionBand icon="layers" title="Customize and make it yours" />
    <div class="container-site py-16 sm:py-20">
      <p class="measure text-sm text-dim">
        Core owns the loop, the tools, the config and the permissions; everything else is a plugin you can switch on or off.
      </p>
      <p class="eyebrow mt-8">the bundled plugins</p>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {PLUGINS.map((p) => (
          <li>
            <a href={p.href} class="group block h-full">
              <Card class="h-full p-4 transition-colors duration-200 group-hover:border-accent/50">
                <Chip label={p.name} icon={p.icon} class="group-hover:text-accent" />
                <p class="mt-3 text-sm text-dim">{p.clause} <span class="text-accent/80">→</span></p>
              </Card>
            </a>
          </li>
        ))}
      </ul>
      <p class="eyebrow mt-12">build your own</p>
      <p class="measure mt-3 text-sm text-dim">
        A plugin is a manifest plus a lifecycle, and the harness is yours to shape.
      </p>
      <p class="mt-5 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
        <a href="https://github.com/ahwurm/localharness/tree/main/examples/plugin-template" target="_blank" rel="noopener" class="text-accent/80 transition-colors hover:text-accent">plugin template ↗</a>
        <a href="https://github.com/ahwurm/localharness/blob/main/docs/specs/09-hooks-plugins.md" target="_blank" rel="noopener" class="text-accent/80 transition-colors hover:text-accent">plugins spec ↗</a>
      </p>
    </div>
  </section>

  <GetInvolved />
</Base>
