---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Demo from '../components/Demo.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import AutoresearchDiagram from '../components/AutoresearchDiagram.astro';
import Terminal from '../components/Terminal.astro';

const install = 'git clone https://github.com/ahwurm/localharness && cd localharness && uv sync';

const agentYaml = `# ~/.localharness/agents/morning-briefing.yaml
name: morning-briefing
division: financial
role: >
  Generate the daily morning market report
  and deliver it as structured markdown.

tools:
  inherit: [global, division]
  deny: ["bash(sudo:*)"]

permissions:
  mode: auto
  budget:
    max_actions: 100
    max_duration_minutes: 30

schedule:
  cron: "30 5 * * 1-5"
  timezone: America/New_York`;

const features = [
  { title: 'YAML-defined agents', desc: 'declarative, no Python' },
  { title: 'Any local endpoint', desc: 'vLLM, Ollama, LM Studio, llama.cpp' },
  { title: 'XML tool-call fallback', desc: 'works without native function calling' },
  { title: 'Deny-first permissions', desc: 'policies only narrow' },
  { title: 'Isolated memory', desc: 'SQLite, scoped per agent' },
  { title: 'Benchmarked, not vibes', desc: 'scenario corpus + autoresearch loop' },
];
---

<Base
  title="LocalHarness — AI agents on your own hardware"
  description="Open-source agent harness for local LLMs. Same workflow, same output — longer time, much lower cost."
>
  <!-- Hero -->
  <section class="container-site rise-in flex flex-col items-center pb-20 pt-20 text-center sm:pt-28">
    <h1 class="max-w-3xl text-balance text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.1] tracking-tight">
      AI agents on your <span class="whitespace-nowrap text-accent">own hardware</span>.
    </h1>
    <p class="mt-4 max-w-2xl text-dim">
      Open-source agent harness for local LLMs. One command finds your model server:
    </p>
    <Demo class="mt-8 w-full max-w-2xl" />
    <CodeBlock code={install} label="install" class="mt-4 w-full max-w-2xl text-left [&_pre]:text-[13px]" />
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <Button href="https://github.com/ahwurm/localharness" external>View on GitHub ↗</Button>
      <Button href="#how" variant="outline">How it works</Button>
    </div>
  </section>

  <!-- Tradeoff band -->
  <section class="border-y border-edge bg-surface/50" aria-label="The tradeoff">
    <div class="container-site grid gap-10 py-16 sm:grid-cols-3 sm:gap-6">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Same workflow, same output</h2>
        <p class="mt-2 text-sm text-dim">The jobs you already run — unchanged.</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold tracking-tight">It takes longer</h2>
        <p class="mt-2 text-sm text-dim">Local models are slower. That's the tradeoff.</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Much lower cost</h2>
        <p class="mt-2 text-sm text-dim">Your hardware. No API meter.</p>
      </div>
    </div>
  </section>

  <!-- How: YAML + features -->
  <section id="how" class="container-site py-24">
    <h2 class="text-3xl font-semibold tracking-tight">An agent is a YAML file</h2>
    <div class="mt-10 grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
      <CodeBlock code={agentYaml} label="agent definition" />
      <ul class="divide-y divide-edge">
        {
          features.map((f) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-3.5">
              <span class="font-medium">{f.title}</span>
              <span class="text-sm text-dim">{f.desc}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Architecture -->
  <section id="architecture" class="border-t border-edge bg-surface/50">
    <div class="container-site py-24">
      <h2 class="text-3xl font-semibold tracking-tight">Architecture</h2>
      <p class="mt-3 max-w-2xl text-dim">
        A thin orchestrator routes. Divisions isolate. Everything leaves a trace.
      </p>
      <div class="mt-10 grid items-center gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
        <ArchDiagram />
        <ul class="divide-y divide-edge">
          <li class="py-3.5">
            <span class="font-medium">Thin orchestrator</span>
            <p class="mt-1 text-sm text-dim">Routes, indexes, escalates. Agents do the work with fresh context.</p>
          </li>
          <li class="py-3.5">
            <span class="font-medium">Event bus spine</span>
            <p class="mt-1 text-sm text-dim">Every action and observation is a typed event — persisted append-only.</p>
          </li>
          <li class="py-3.5">
            <span class="font-medium">One guarded loop</span>
            <p class="mt-1 text-sm text-dim">ReAct with stuck detection, budgets, and compaction sized to the model.</p>
          </li>
          <li class="py-3.5">
            <span class="font-medium">Any endpoint</span>
            <p class="mt-1 text-sm text-dim">Provider auto-detected. Native tool calls where supported, XML where not.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Autoresearch -->
  <section id="autoresearch" class="container-site py-24">
    <h2 class="text-3xl font-semibold tracking-tight">Autoresearch</h2>
    <p class="mt-3 max-w-2xl text-dim">
      The harness improves itself — under a gate. Changes ship only if the bench says so.
    </p>
    <div class="mt-10 grid items-center gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
      <AutoresearchDiagram />
      <Terminal
        lines={[
          { cmd: 'uv run localharness autoresearch run', comment: 'one iteration' },
          { cmd: 'uv run localharness autoresearch review', comment: 'inspect' },
          { cmd: 'uv run localharness autoresearch adopt', comment: 'promote' },
          { cmd: 'uv run localharness components list', comment: 'registry' },
        ]}
      />
    </div>
  </section>

  <!-- LocalShift cross-promo -->
  <section class="container-site pb-24">
    <Card class="border-l-2 border-l-accent p-8 sm:p-10">
      <p class="font-mono text-xs text-dim">Part of the Local__ family</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight">
        local<span class="text-accent">_</span>shift
      </h2>
      <p class="mt-3 max-w-2xl text-dim">
        Migrate frontier-AI workloads to local LLMs — proven per workload, not assumed. Launches
        June 15, 2026.
      </p>
      <div class="mt-6">
        <Button href="/localshift/" variant="outline">How it works</Button>
      </div>
    </Card>
  </section>
</Base>
