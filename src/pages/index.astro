---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Eyebrow from '../components/Eyebrow.astro';
import DemoPane from '../components/DemoPane.astro';
import TraceFlow from '../components/TraceFlow.astro';
import Interstitial from '../components/Interstitial.astro';
import { d1Lines, d3Lines, eventTotal } from '../data/demo-session';
import { d2Lines, overwindowTailMeter } from '../data/demo-overwindow';
import Chip from '../components/Chip.astro';
import Icon from '../components/Icon.astro';
import GetInvolved from '../components/GetInvolved.astro';

const install = `git clone https://github.com/ahwurm/localharness
cd localharness && uv sync
uv run localharness init
uv run localharness start`;

// The LOCAL_/HARNESS startup banner exactly as `localharness start` prints it —
// extracted mechanically from .planning/captures/start-main.txt into banner.txt.
// The blank separator row is reinserted between the two words.
import bannerRaw from '../data/banner.txt?raw';
const rows = bannerRaw.split('\n');
const banner = [...rows.slice(0, 6), '', ...rows.slice(6)].join('\n');
const d3Events = d3Lines.flatMap((l) => l.ev ?? []);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalHarness',
    description:
      'Open-source, model-agnostic hierarchical agent harness for local LLMs — the agent layer that runs on top of an inference engine (vLLM, Ollama, LM Studio, llama.cpp), not another one. Define agents in YAML and run them against any OpenAI-compatible endpoint.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    url: 'https://localharness.dev',
    codeRepository: 'https://github.com/ahwurm/localharness',
    license: 'https://opensource.org/licenses/MIT',
    programmingLanguage: 'Python',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'LocalHarness', url: 'https://localharness.dev' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalHarness',
    url: 'https://localharness.dev',
    sameAs: ['https://github.com/ahwurm/localharness'],
  },
];
---

<Base
  title="LocalHarness — AI agents on your own hardware"
  description="Open-source agent harness for local LLMs — the agent layer on top of vLLM, Ollama, LM Studio, or llama.cpp, not an inference engine. Same workflow, same output, much lower cost."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="glow">
    <div class="container-site flex flex-col items-center pb-14 pt-14 text-center sm:pt-20">
      <h1 class="sr-only">LocalHarness — AI agents on your own hardware</h1>
      <pre
        aria-hidden="true"
        class="ascii-art focus-in overflow-hidden text-left text-[length:clamp(0.42rem,1.9vw,1.05rem)] leading-none text-accent">{banner}</pre>
      <p class="focus-in mt-6 font-mono text-sm text-dim [--fi-delay:120ms]">
        Describe a task, or <span class="text-accent">/help</span> for commands.
      </p>
      <p class="focus-in mt-5 font-mono text-sm text-dim [--fi-delay:240ms]">
        the agent layer for the endpoint you already run — not another inference engine
      </p>
      <div class="focus-in mt-4 flex max-w-[300px] flex-wrap items-center justify-center gap-2 [--fi-delay:320ms] sm:max-w-none">
        <Chip icon="server" label="vLLM" />
        <Chip icon="llama" label="Ollama" />
        <Chip icon="studio" label="LM Studio" />
        <Chip icon="cpp" label="llama.cpp" />
      </div>
      <CodeBlock
        code={install}
        label="install"
        class="focus-in mt-8 w-full max-w-xl text-left [--fi-delay:420ms] [&_pre]:text-[13px]"
      />
      <div class="focus-in mt-6 flex flex-wrap items-center justify-center gap-3 [--fi-delay:540ms]">
        <Button href="https://github.com/ahwurm/localharness" external>view on github</Button>
        <Button href="#demo-section" variant="outline">watch it work</Button>
      </div>
    </div>
  </section>

  <!-- Watch it work: three demos, real sessions -->
  <section id="demo-section" class="border-t border-edge/70" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="watch it work" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Watch it work.
      </h2>
      <p class="mt-3 text-dim">Real sessions, replayed — from cold start to a verified answer.</p>
      <div data-demo-pips class="mt-4 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
        <a href="#demo-startup" class="text-accent/80 transition-colors hover:text-accent">_zero to agent</a>
        <a href="#demo-overwindow" class="text-accent/80 transition-colors hover:text-accent">_bigger than the window</a>
        <a href="#demo-research" class="text-accent/80 transition-colors hover:text-accent">_delegation, quarantined</a>
      </div>

      <!-- Demo 1: zero to agent -->
      <div id="demo-startup" class="mt-12 gap-10 xl:grid xl:grid-cols-[3fr_2fr]">
        <div class="min-w-0">
          <p class="mb-2 font-mono text-xs">
            <span class="text-accent/80">fig. 01</span> <span class="text-ink">— zero to a working agent, cold start</span>
          </p>
          <DemoPane key="d1" title="~/localharness — real session · qwen3.6-27b on vLLM" lines={d1Lines} />
          <p class="mt-2 font-mono text-[11px] text-dim">captured 2026-07-02 · the session continues in fig. 03</p>
        </div>
        <div class="mt-6 xl:mt-0">
          <Eyebrow label="zero to agent" />
          <h3 class="mt-3 text-xl font-semibold tracking-tight">Point it at the endpoint you already run.</h3>
          <ol class="mt-5 space-y-4">
            <li>
              <span class="font-mono text-[13px] text-accent">01 · probes for what's running</span>
              <p class="mt-1 text-sm text-dim">Checks localhost for a live model server: vLLM, Ollama, LM Studio, llama.cpp.</p>
            </li>
            <li>
              <span class="font-mono text-[13px] text-accent">02 · confirms it can act</span>
              <p class="mt-1 text-sm text-dim">Verifies the model can trigger a command, not just chat, before any agent runs.</p>
            </li>
            <li>
              <span class="font-mono text-[13px] text-accent">03 · sets the limit itself</span>
              <p class="mt-1 text-sm text-dim">Reads how much text the model can hold straight off the server. Nothing to hand-write.</p>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <Interstitial icon="server" lead="No API key, no signup" rest="— the model you're already running." />

  <!-- Demo 2: bigger than the window -->
  <section id="demo-overwindow" data-reveal>
    <div class="container-site gap-10 py-16 sm:py-20 xl:grid xl:grid-cols-[3fr_2fr]">
      <div class="min-w-0">
        <p class="mb-2 font-mono text-xs">
          <span class="text-accent/80">fig. 02</span> <span class="text-ink">— “How does Odysseus defeat the Cyclops?”</span>
        </p>
        <DemoPane
          key="d2"
          title="~/localharness — real session · Homer’s Odyssey"
          lines={d2Lines}
          tailMeter={overwindowTailMeter}
        />
        <p class="mt-2 font-mono text-[11px] text-dim">
          the Odyssey whole — 678,822 characters vs a 126,976-token window · answer verified against the text
        </p>
      </div>
      <div class="mt-6 xl:mt-0">
        <Eyebrow label="bigger than the window" />
        <h3 class="mt-3 text-xl font-semibold tracking-tight">It reads what can't fit.</h3>
        <ol class="mt-5 space-y-4">
          <li>
            <span class="font-mono text-[13px] text-accent">01 · the whole epic, one handle</span>
            <p class="mt-1 text-sm text-dim">A context window is how much text the model can hold at once. This epic is a third again bigger.</p>
          </li>
          <li>
            <span class="font-mono text-[13px] text-accent">02 · every section actually read</span>
            <p class="mt-1 text-sm text-dim">The harness cuts the text into sections and reads each one in a fresh window — that's the cascade.</p>
          </li>
          <li>
            <span class="font-mono text-[13px] text-accent">03 · one grounded answer</span>
            <p class="mt-1 text-sm text-dim">The section extracts combine into one reply that quotes the text exactly.</p>
          </li>
        </ol>
        <p class="mt-5 font-mono text-xs">
          <a href="/architecture/#over-window" class="text-accent/80 transition-colors hover:text-accent">the full mechanism ↗</a>
        </p>
      </div>
    </div>
  </section>

  <Interstitial icon="clock" lead="It takes longer" rest="— local models are slower. That's the tradeoff." />

  <!-- Demo 3: delegation, quarantined (the fig. 01 session, continued) -->
  <section id="demo-research" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="delegation, quarantined" />
      <h3 class="mt-3 text-xl font-semibold tracking-tight">Subagents, fenced by construction.</h3>
      <p class="mb-2 mt-8 font-mono text-xs">
        <span class="text-accent/80">fig. 03</span> <span class="text-ink">— “Find the best open-source model for a 128 GB machine.”</span>
      </p>
      <div data-demo-scope id="demo-research-scope" class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
        <DemoPane
          key="d3"
          title="~/localharness — the fig. 01 session, continued"
          lines={d3Lines}
          tailMeter="░░░░░░░░░░ 3%"
          eventTotal={eventTotal}
          boxClass="xl:h-0 xl:min-h-full"
          bodyClass="h-[420px] xl:h-auto xl:min-h-0 xl:flex-1"
        />
        <div class="flex min-w-0 flex-col gap-4">
          <div class="border border-edge bg-surface/60 p-4">
            <TraceFlow />
          </div>
          <div data-node="bus" class="flex min-h-0 flex-1 flex-col overflow-hidden border border-edge bg-surface/60">
            <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2 font-mono text-xs text-dim">
              <span>bus-events.jsonl — append-only</span>
              <span><span data-ev-count>{eventTotal}</span> events</span>
            </div>
            <ol data-ticker class="h-[132px] overflow-y-auto px-4 py-2 font-mono text-[11px] leading-[1.9] text-dim [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {d3Events.map((e, i) => <li data-ev={i}>{e}</li>)}
            </ol>
          </div>
        </div>
      </div>
      <p class="mt-2 font-mono text-[11px] text-dim">
        the fig. 01 session, continued · replayed from its own bus trace
      </p>
      <p class="measure mt-6 text-sm text-dim">
        Continuing the same captured session as fig. 01: one prompt, and the agent hands research to a
        web-quarantined child. Subagents get fresh windows and only the tools their job needs — the
        web-researcher can touch only the web, a verifier re-pulls its sources blind, and every web
        result arrives stamped <span class="text-ink">UNTRUSTED</span>, with no path to
        <code class="font-mono text-ink">bash</code> or <code class="font-mono text-ink">write</code>.
        Fails closed —
        <a
          href="https://github.com/ahwurm/localharness/blob/main/SECURITY.md"
          target="_blank"
          rel="noopener"
          class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
          >SECURITY.md</a
        >.
      </p>
    </div>
  </section>

  <Interstitial icon="repeat" lead="Same workflow, same output" rest="— much lower cost. No meter, no telemetry." />

  <!-- Built in -->
  <section id="agents" data-reveal>
    <div class="container-site py-16 sm:py-20">
      <Eyebrow label="agents" />
      <h2 class="mt-3 text-[clamp(1.75rem,3vw,2.25rem)] font-semibold tracking-[-0.02em]">
        Built in.
      </h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <Card class="p-4">
          <Chip icon="agent" label="default" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">What start gives you — three lines of YAML.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="doc" label="explore" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Read-only codebase scout.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="search" label="web-researcher" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Quarantined web tools; spawns its own fact-checker.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="shield" label="search-verifier" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Blind fact-checker — re-pulls sources, returns a verdict.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="box" label="cruncher" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Reads documents bigger than the window — fig. 02's engine.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="gauge" label="data-analyst" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Computes answers over local files — python, pandas.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="studio" label="frontend-designer" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">Builds a page, screenshots it, iterates.</p>
        </Card>
        <Card class="p-4">
          <Chip icon="prompt" label="yours" class="border-0 bg-transparent px-0 py-0" />
          <p class="mt-1.5 text-sm text-dim">One command scaffolds it.</p>
        </Card>
      </div>
      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
        <a href="/architecture/#yaml" class="text-accent/80 transition-colors hover:text-accent">how agents are defined ↗</a>
        <a href="/architecture/#security" class="text-accent/80 transition-colors hover:text-accent">how quarantine works ↗</a>
      </div>
    </div>
  </section>

  <GetInvolved />
</Base>
