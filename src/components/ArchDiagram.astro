---
// Architecture mockup — verified against docs/specs
---

<svg
  viewBox="0 0 560 632"
  role="img"
  aria-label="LocalHarness architecture: orchestrator delegating to subagents, a typed event bus, the ReAct agent loop, tools under deny-first permissions, and provider auto-detection over local endpoints"
  class="w-full max-w-xl"
>
  <defs>
    <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.2"></path>
    </marker>
  </defs>

  <!-- orchestrator -->
  <rect x="110" y="14" width="340" height="54" rx="10" class="fill-surface stroke-edge" stroke-width="1.5"></rect>
  <text x="280" y="37" text-anchor="middle" class="fill-ink font-mono text-[14px] font-medium">orchestrator</text>
  <text x="280" y="56" text-anchor="middle" class="fill-dim text-[11px]">thin — route · index · escalate</text>

  <line x1="280" y1="68" x2="280" y2="92" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- subagents -->
  <rect x="60" y="98" width="210" height="118" rx="12" class="fill-none stroke-edge" stroke-width="1.3" stroke-dasharray="6 5"></rect>
