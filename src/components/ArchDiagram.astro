  <rect x="76" y="134" width="84" height="56" rx="8" class="fill-surface stroke-edge" stroke-width="1.3"></rect>
  <text x="118" y="158" text-anchor="middle" class="fill-ink font-mono text-[13px]">agent</text>
  <text x="118" y="176" text-anchor="middle" class="fill-dim text-[10px]">yaml</text>
  <rect x="172" y="134" width="84" height="56" rx="8" class="fill-surface stroke-edge" stroke-width="1.3"></rect>
  <text x="214" y="158" text-anchor="middle" class="fill-ink font-mono text-[13px]">agent</text>
  <text x="214" y="176" text-anchor="middle" class="fill-dim text-[10px]">yaml</text>

  <rect x="290" y="98" width="210" height="118" rx="12" class="fill-none stroke-edge" stroke-width="1.3" stroke-dasharray="6 5"></rect>
  <text x="306" y="120" class="fill-dim font-mono text-[11px]">subagents</text>
  <rect x="306" y="134" width="84" height="56" rx="8" class="fill-surface stroke-edge" stroke-width="1.3"></rect>
  <text x="348" y="158" text-anchor="middle" class="fill-ink font-mono text-[13px]">agent</text>
