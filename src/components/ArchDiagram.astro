  <rect x="410" y="590" width="98" height="32" rx="16" class="fill-none stroke-edge" stroke-width="1.3"></rect>
  <text x="459" y="610" text-anchor="middle" class="fill-dim font-mono text-[12px]">llama.cpp</text>
</svg>
