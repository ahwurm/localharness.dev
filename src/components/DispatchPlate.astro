---
// PLATE DISPATCH — the dispatch plugin: Discord as a channel, its settings on the machine (fig. 01 of
// /plugins/dispatch/). Redrawn 2026-10-02 to the PLATE M grammar (MemoryPlateII). Left, what CORE
// provides: the bus (and the capability floor every session tool passed), the one permission gate,
// the artifact folder outbound files come from, `start --channel`, and the config layers with the
// three machine-level fields. Hairline. Middle, what the PLUGIN owns: nearer core the platform-neutral
// side (DispatchChannel, the reaction asks, attachments, DispatchPlugin), nearer Discord the platform
// side (DiscordAdapter, the planned adapters, the env fallback that ends at 0.17.0 — amber). Right,
// OUTSIDE: Discord. Badges ①–⑤ = one message: in from an allowlisted user → a turn → the reply back
// → the gate's ask in the chat → a picture posted as a file. Two lanes as on PLATE MOBILE.
// Sources (localharness main @ 582b69c, v0.16.0): dispatch/{plugin,config,channel}.py and
// adapters/discord.py docstrings, docs/specs/11 "The dispatch plugin", docs/specs/09 "The bundled
// plugins" + "Lifecycle and containment", SECURITY.md "`localharness mobile`" (dispatch bullets) +
// "Machine-level-only settings", README "Answering a permission prompt in Discord", CHANGELOG 0.16.0
// Known limitations. Hue: infra (a channel); Discord in the proposed EXTERNAL hue. Marker ids pd-*. SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';
import Icon, { type IconName, type IconTone } from './Icon.astro';

// 2026-10-02 visual pass: each box = title, source file, then at most three icon clauses (a "\n"
// in a clause wraps it without a second icon). Fill ladder: zone 3.5% → box bg + 8% tint →
// the highlighted clause in the full hue. PROPOSED here only: Discord in its own EXTERNAL hue
// (plateTokens.external) instead of edge-grey — the image and mobile plates keep grey to compare.
type Tone = 'core' | 'plug' | 'out' | 'warn';
const stroke: Record<Tone, string> = { core: 'stroke-accent/70', plug: 'stroke-infra/70', out: 'stroke-[oklch(78%_0.11_340)]/70', warn: 'stroke-amber/70' };
const tint: Record<Tone, string> = { core: 'fill-accent/8', plug: 'fill-infra/8', out: 'fill-[oklch(78%_0.11_340)]/8', warn: 'fill-amber/8' };
const hue: Record<Tone, string> = { core: 'fill-accent', plug: 'fill-infra', out: 'fill-[oklch(78%_0.11_340)]', warn: 'fill-amber' };
const ico: Record<Tone, IconTone> = { core: 'accent', plug: 'infra', out: 'ext', warn: 'amber' };
// clause: [icon, text, 1 = emphasised in the hue · 2 = amber limit · 3 = italic planned]
type C = [IconName, string, number?];
// [x, y, w, tone, title, source file, clauses, coloured title]
type N = [number, number, number, Tone, string, string | null, C[], boolean?];
const nodes: N[] = [
  // CORE
  [28, 114, 296, 'core', 'EventBus', 'core/bus.py', [['chat', 'a UserMessage, channel "discord"'], ['layers', 'a channel sees every event, tool results too', 1], ['shield', 'capability floor on every tool —\ndispatch adds none']], true],
  [28, 214, 296, 'core', 'PermissionGate', 'agent/gate.py', [['shield', 'auto: a blacklisted call posts as pending'], ['clock', 'guarded · trusted: a blocking ask, which\nexpires at permissions.ask.timeout_s → denied'], ['key', 'an always → grants.yaml, held in the terminal too']]],
  [28, 318, 296, 'core', 'artifact folder', 'core/artifacts.py', [['folder', '<state dir>/artifacts/<plugin>/ — core’s'], ['image', 'the only place an outbound file is read from'], ['shield', 'one regular file · no symlink · an image type']]],
  [28, 410, 296, 'core', 'start --channel discord', 'cli/start_cmd.py', [['plug', 'core channels + bundled channel plugins only'], ['issue', 'dispatch off → refused, with how to turn it on'], ['issue', 'refuses: no token, or an empty allow list']]],
  [28, 502, 296, 'core', 'config layers', 'config/loader.py', [['key', 'dispatch.discord.token · allow · channels'], ['lock', 'machine-level only: a project’s value is dropped', 1], ['check', 'ack: any layer · the token shown as **********']]],
  // PLUGIN — platform-neutral side
  [388, 114, 240, 'plug', 'DispatchChannel', 'dispatch/channel.py · platform-neutral', [['key', 'allow list: users · optionally channels', 1], ['check', 'ack at dequeue ·\nreplies chunked to 2000'], ['layers', 'tool calls and results stay silent']], true],
  [388, 232, 240, 'plug', 'asks, by reaction', 'dispatch/channel.py', [['chat', 'allow once · always · no, this once'], ['repeat', 'pending: run it · skip it · /approve N'], ['shield', 'only a user on the allow list can answer', 1]]],
  [388, 326, 240, 'plug', 'attachments', 'dispatch/channel.py', [['image', 'out: a tool’s artifact,\nposted as a file'], ['doc', 'in: name · size · type — metadata only'], ['shield', 'an upload is never passed to the model', 1]]],
  [388, 430, 240, 'plug', 'DispatchPlugin', 'dispatch/plugin.py · channels ("discord",)', [['plug', 'make_channel: its validated settings'], ['box', 'adds no tool and no command'], ['cloud-off', 'opens no network at start']]],
  [388, 522, 240, 'plug', 'doctor()', 'dispatch/plugin.py', [['search', 'never logs in, never the token']]],
  // PLUGIN — platform side
  [664, 114, 236, 'plug', 'DiscordAdapter', 'dispatch/adapters/discord.py', [['plug', 'the only module that imports discord', 1], ['chat', 'send · reply · react · send_file'], ['layers', 'one ChatAdapter per platform']]],
  [664, 420, 236, 'warn', 'env fallback', 'dispatch/config.py · env_fallback', [['key', 'LOCALHARNESS_DISCORD_*, then\nDISCORD_BOT_TOKEN, then a legacy .env'], ['check', 'fills only a field left at its default'], ['clock', 'warns each time · deleted at 0.17.0', 1]], true],
  // OUTSIDE — Discord
  [944, 114, 188, 'out', 'Discord', null, [['key', 'your bot · its token'], ['check', 'Message Content intent on'], ['issue', 'tested offline only —\nnot yet on a live server', 2]], true],
  [944, 208, 188, 'out', 'the allow list', null, [['chat', 'users on the allow list'], ['layers', 'channels — empty = any\nthe bot can see']]],
];
// planned box, same row grammar, hatched + dashed
const planned: N = [664, 232, 236, 'plug', 'Slack · webhook · file', 'docs/specs/11', [['doc', 'the same pattern: one adapter file'], ['check', 'one table line · no edit outside it'], ['clock', 'planned: a second platform needs\nits own settings section', 3]]];
const rowsOf = (cs: C[]) => cs.flatMap(([i, t, k = 0]) => t.split('\n').map((line, j) => ({ icon: j ? null : i, line, k })));
const height = (n: N) => 28 + 12 * ((n[5] ? 1 : 0) + rowsOf(n[6]).length);
---

<figure
  role="img"
  aria-label="Plate dispatch: the dispatch plugin — Discord as a channel, its settings on the machine — one message numbered one to five. On the core side: the event bus, which takes each message as a user message from the discord channel and which a channel reads in full, tool results included, while every session tool has passed the capability floor and dispatch adds none; the permission gate, which in auto mode posts a blacklisted call as a pending decision, and in guarded and trusted modes asks a blocking question that is denied once permissions.ask.timeout_s passes, an always answer being written to grants.yaml and held in the terminal too; the artifact folder, the only place an outbound file is read from, one regular file, no symlink, an image type; start --channel discord, which takes core channels and bundled channel plugins only and is refused, saying how to turn it on, while dispatch is off; and the config layers, where dispatch.discord.token, allow and channels are machine-level only and a project's value is dropped, the token is shown masked, and start refuses with no token or an empty allow list. Across the plugin boundary the dispatch plugin owns, on the platform-neutral side, the dispatch channel — the allow list of user ids and optionally channels, the acknowledgement reaction, replies chunked to two thousand characters, tool activity kept silent; permission asks posted to the chat with reactions as the options, answerable only by a user on the allow list; attachments, where a tool's artifact is posted as a file and an upload is kept as name, size and type only and never passed to the model; and the plugin class, which hands the channel its validated settings and adds no tool, no command and no network at start, and whose doctor check never logs in or prints the token. On the platform side: the Discord adapter, the only module that imports the discord library; and, in amber, the environment fallback — the old LOCALHARNESS_DISCORD variables, DISCORD_BOT_TOKEN and a legacy env file — which fills only a field left at its default, warns each time, and is deleted at version 0.17.0. Planned: Slack, webhook and file adapters on the same pattern, a second platform needing its own settings section. Outside: Discord — your bot and its token with the Message Content intent on, the users on the allow list, and the channels it listens in; tested offline only, not yet against a live server. One: an allowlisted message arrives. Two: it becomes a turn. Three: the reply is posted back. Four: the gate's question goes out to the chat. Five: a picture a tool made is posted as a file."
