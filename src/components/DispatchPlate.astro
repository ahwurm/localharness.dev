---
// PLATE DISPATCH — what the dispatch plugin owns versus what core provides (fig. 01 of
// /plugins/dispatch/). Left: CORE (start --channel, the config layers and their machine-level
// rule, the permission gate). Middle: the DISPATCH PLUGIN (the channel make_channel builds, the
// plugin class, the env fallback that ends at 0.17.0 — amber). Right: OUTSIDE (Discord).
// Badges ①–④ = one session. Sources (localharness main @ 582b69c, v0.16.0): dispatch/plugin.py,
// dispatch/config.py (GLOBAL_ONLY, env_fallback), docs/specs/09 "The bundled plugins" +
// "Settings", README "Answering a permission prompt in Discord", CHANGELOG [0.16.0] Known
// limitations. Marker ids pd-*. SVG at lg+.
import FlowLedger from './FlowLedger.astro';
import { nodeBox, edge } from './plateTokens';

type Tone = 'core' | 'plugin' | 'out' | 'warn';
const stroke: Record<Tone, string> = { core: 'stroke-accent/70', plugin: 'stroke-tool/70', out: 'stroke-edge', warn: 'stroke-amber/70' };
const ink: Record<Tone, string> = { core: 'fill-ink', plugin: 'fill-tool', out: 'fill-ink', warn: 'fill-amber' };
// [x, y, w, h, tone, label, sublabels]
const nodes: [number, number, number, number, Tone, string, string[]][] = [
  [28, 114, 416, 52, 'core', 'start --channel discord', ['builds the channel through make_channel', 'refused when dispatch is off — never the terminal']],
  [28, 190, 416, 52, 'core', 'config layers', ['dispatch.discord.token · allow · channels: machine-level', 'a project’s value is dropped, with a warning']],
  [28, 266, 416, 52, 'core', 'PermissionGate', ['its asks are posted to the chat', 'only a user on the allow list can answer']],
  [512, 114, 380, 52, 'plugin', 'DispatchChannel', ['allowlisted messages become turns', 'replies posted back · an ack reaction (ack, layerable)']],
  [512, 190, 380, 52, 'plugin', 'DispatchPlugin', ['no tool · no command · no network at start', 'doctor: configured or not — never the token, no login']],
  [512, 266, 380, 52, 'warn', 'env fallback · ends 0.17.0', ['LOCALHARNESS_DISCORD_* · DISCORD_BOT_TOKEN · legacy .env', 'fills only an unset field, and warns each time']],
  [938, 114, 194, 204, 'out', 'Discord', ['your bot — Message', 'Content intent on', '', 'users on the allow list', 'channels, or any it sees', '', 'tested offline only —', 'not yet on a live server']],
];
const badge = (cx: number, cy: number, n: number, hollow = false) => ({ cx, cy, n, hollow });
const badges = [badge(478, 134, 1), badge(915, 134, 2), badge(915, 152, 3, true), badge(640, 356, 4)];
---

<figure
  role="img"
  aria-label="A drawing of the dispatch plugin: what it owns and what core provides, one session numbered one to four. Core holds start --channel discord, which builds the channel through the plugin's make_channel and is refused, never falling back to the terminal, when dispatch is off; the config layers, where dispatch.discord.token, allow and channels are machine-level only and a project's value is dropped with a warning; and the permission gate, whose questions are posted to the chat and can be answered only by a user on the allow list. Across the plugin boundary the dispatch plugin owns the Discord channel, where allowlisted messages become turns and replies are posted back with an acknowledgement reaction; the plugin class, which adds no tool and no command, opens no network at start, and whose doctor check never prints the token or logs in; and, in amber, the environment fallback — the old LOCALHARNESS_DISCORD variables, DISCORD_BOT_TOKEN and the legacy env file — which fills only an unset field, warns each time, and is deleted at version 0.17.0. Outside: Discord — your bot with the Message Content intent on, the users on the allow list, and the channels it listens in; tested offline only, not yet against a live server. One: start builds the channel. Two: an allowlisted message arrives. Three: the reply is posted back. Four: the gate's question goes out through the channel and is answered by reaction."
>
  <div class="hidden w-full lg:block" aria-hidden="true">
    <svg viewBox="0 0 1160 424" class="w-full">
      <defs>
        <marker id="pd-solid" viewBox={edge.marker.viewBox} refX={edge.marker.refX} refY={edge.marker.refY} markerWidth={edge.marker.markerWidth} markerHeight={edge.marker.markerHeight} orient={edge.marker.orient}>
          <path d={edge.marker.path} class="fill-none stroke-accent" stroke-width={edge.marker.callArrowStroke}></path>
        </marker>
        <marker id="pd-dash" viewBox={edge.marker.viewBox} refX={edge.marker.refX} refY={edge.marker.refY} markerWidth={edge.marker.markerWidth} markerHeight={edge.marker.markerHeight} orient={edge.marker.orient}>
          <path d={edge.marker.path} class="fill-none stroke-dim" stroke-width={edge.marker.returnArrowStroke}></path>
        </marker>
        <pattern id="pd-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="stroke-dim" stroke-width="1"></line>
        </pattern>
      </defs>

      <!-- ===== header ===== -->
      <rect x="16" y="18" width="20" height="20" class="fill-tool"></rect>
      <text x="26" y="33" text-anchor="middle" class="fill-accent-ink font-mono text-[12px] font-semibold">D</text>
      <text x="46" y="34" class="fill-ink font-sans text-[15px] font-semibold">The dispatch plugin — Discord as a channel, settings on the machine</text>
      <text x="1144" y="16" text-anchor="end" class="fill-dim font-mono text-[8px]">LH-ARCH-001 · PLATE DISPATCH · SHEET 1 OF 1</text>
      <text x="1144" y="27" text-anchor="end" class="fill-dim font-mono text-[8px]">REV 582b69c · v0.16.0 · 2026-10-02</text>
      <text x="1144" y="38" text-anchor="end" class="fill-dim font-mono text-[8px]">kind "channel" · requires_extra "dispatch"</text>
      <text x="1144" y="63" text-anchor="end" class="fill-dim font-mono text-[9px]">what core provides · the boundary · what the plugin owns · outside</text>
      <text x="16" y="62" class="fill-dim font-mono text-[8px]">GROUPS</text>
      <rect x="64" y="53" width="10" height="10" class="fill-accent/20 stroke-accent"></rect>
      <text x="78" y="62" class="fill-dim font-mono text-[8px]">CORE</text>
      <rect x="114" y="53" width="10" height="10" class="fill-tool/20 stroke-tool"></rect>
      <text x="128" y="62" class="fill-dim font-mono text-[8px]">DISPATCH PLUGIN</text>
      <rect x="222" y="53" width="10" height="10" class="fill-none stroke-edge"></rect>
      <text x="236" y="62" class="fill-dim font-mono text-[8px]">OUTSIDE</text>
      <line x1="16" y1="76" x2="1144" y2="76" class="stroke-edge" stroke-width="1"></line>

      <!-- ===== zones ===== -->
      <rect x="16" y="96" width="440" height="238" class="fill-none stroke-accent/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="28" y="89" width="36" height="14" class="fill-bg stroke-accent" stroke-width="1"></rect>
      <text x="46" y="99" text-anchor="middle" class="fill-accent font-mono text-[8px] tracking-[0.08em]">CORE</text>
      <rect x="500" y="96" width="404" height="238" class="fill-none stroke-tool/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="512" y="89" width="104" height="14" class="fill-bg stroke-tool" stroke-width="1"></rect>
      <text x="564" y="99" text-anchor="middle" class="fill-tool font-mono text-[8px] tracking-[0.08em]">DISPATCH PLUGIN</text>
      <rect x="926" y="96" width="218" height="238" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="938" y="89" width="56" height="14" class="fill-bg stroke-edge" stroke-width="1"></rect>
      <text x="966" y="99" text-anchor="middle" class="fill-dim font-mono text-[8px] tracking-[0.08em]">OUTSIDE</text>
      <!-- the plugin boundary -->
      <line x1="478" y1="84" x2="478" y2="342" class="stroke-ink/70" stroke-width="1"></line>
      <text x="478" y="80" text-anchor="middle" class="fill-ink font-mono text-[8px] tracking-[0.08em]">PLUGIN BOUNDARY · IN THROUGH ctx</text>

            <!-- ===== edges (drawn under the boxes) ===== -->
      <g class="fill-none stroke-accent" stroke-width={edge.call.strokeWidth}>
        <line x1="444" y1="134" x2="511" y2="134" marker-end="url(#pd-solid)"></line>
        <line x1="938" y1="134" x2="893" y2="134" marker-end="url(#pd-solid)"></line>
        <path d="M236,318 L236,356 L1035,356 L1035,319" marker-end="url(#pd-solid)"></path>
      </g>
      <g class="fill-none stroke-dim" stroke-width={edge.return.strokeWidth} stroke-dasharray={edge.return.dash}>
        <line x1="893" y1="152" x2="937" y2="152" marker-end="url(#pd-dash)"></line>
        <line x1="444" y1="216" x2="511" y2="216" marker-end="url(#pd-dash)"></line>
      </g>
      <line x1="702" y1="266" x2="702" y2="243" class="fill-none stroke-amber/70" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#pd-dash)"></line>
      <text x="446" y="128" class="fill-dim font-mono text-[8.5px]">builds</text>
      <text x="896" y="128" class="fill-dim font-mono text-[8.5px]">message</text>
      <text x="898" y="166" class="fill-dim font-mono text-[8.5px]">reply</text>
      <text x="448" y="210" class="fill-dim font-mono text-[8.5px]">ctx.config</text>
      <text x="710" y="258" class="fill-amber/80 font-mono text-[8.5px]">fills unset</text>
      <text x="652" y="372" class="fill-dim font-mono text-[8.5px]">the gate’s asks go out through the channel — answered by reaction, allow list only</text>

      <!-- ===== nodes ===== -->
      {nodes.map(([x, y, w, h, tone, label, subs]) => (
        <g>
          <rect x={x} y={y} width={w} height={h} class:list={['fill-bg', stroke[tone]]} stroke-width="1.3"></rect>
          <text x={x + w / 2} y={y + nodeBox.pad.labelFromTop - 1} text-anchor="middle" class:list={[ink[tone], 'font-mono text-[12px]']}>{label}</text>
          {subs.map((s, j) => (
            <text x={x + w / 2} y={y + 33 + j * 12} text-anchor="middle" class="fill-dim font-mono text-[8.5px]">{s}</text>
          ))}
        </g>
      ))}

      <!-- ===== badges ===== -->
      {badges.map(({ cx, cy, n, hollow }) => (
        <g>
          <circle cx={cx} cy={cy} r={edge.badge.radius} class={hollow ? 'fill-surface stroke-accent/60' : 'fill-accent'} stroke-width={hollow ? 1.2 : undefined}></circle>
          <text x={cx} y={cy + edge.badge.textBaselineOffset} text-anchor="middle" class:list={[hollow ? 'fill-accent' : 'fill-accent-ink', 'font-mono text-[9px] font-semibold']}>{n}</text>
        </g>
      ))}

      <!-- ===== KEY ===== -->
      <text x="16" y="406" class="fill-dim font-mono text-[8.5px]">KEY</text>
      <line x1="44" y1="403" x2="64" y2="403" class="stroke-accent" stroke-width="1.4" marker-end="url(#pd-solid)"></line>
      <text x="70" y="406" class="fill-dim font-mono text-[8.5px]">one session</text>
      <line x1="134" y1="403" x2="154" y2="403" class="stroke-dim" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#pd-dash)"></line>
      <text x="160" y="406" class="fill-dim font-mono text-[8.5px]">returns · settings</text>
      <rect x="266" y="399" width="8" height="8" class="fill-none stroke-ink" stroke-width="1.2"></rect>
      <text x="278" y="406" class="fill-dim font-mono text-[8.5px]">shipped</text>
      <rect x="330" y="399" width="8" height="8" class="stroke-dim" fill="url(#pd-hatch)" stroke-width="1"></rect>
      <text x="342" y="406" class="fill-dim font-mono text-[8.5px]">landing</text>
      <rect x="394" y="399" width="8" height="8" class="fill-none stroke-dim" stroke-width="1" stroke-dasharray="2 2"></rect>
      <text x="406" y="406" class="fill-dim font-mono text-[8.5px]">planned</text>
      <text x="1144" y="406" text-anchor="end" class="fill-dim font-mono text-[8.5px]">shipped — every box on this sheet, on main @ 582b69c</text>
    </svg>
  </div>

  <FlowLedger
    class="lg:hidden"
    rows={[
      { n: 1, icon: 'box', title: 'start builds the channel', text: 'start --channel discord → make_channel — refused when dispatch is off', tone: 'accent' },
      { n: 2, icon: 'prompt', title: 'an allowlisted message', text: 'becomes a turn — anyone else is ignored' },
      { n: 3, icon: 'repeat', title: 'the reply is posted back', text: 'with an ack reaction on the message' },
      { n: 4, icon: 'shield', title: 'the gate asks in the chat', text: 'answered by reaction — allow list only' },
      { kind: 'loop', icon: 'doc', title: 'machine-level settings', text: 'dispatch.discord.token · allow · channels — a project cannot set them' },
      { kind: 'blocked', icon: 'clock', title: 'env fallback ends at 0.17.0', text: 'the old variables fill only an unset field, and warn' },
      { kind: 'note', text: 'tested offline against a stand-in — not yet run against a live Discord server.' },
    ]}
  />
</figure>
