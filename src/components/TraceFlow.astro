---
// Message-I/O ledger of the REAL replayed session (eraser-style plates, no arrows).
// Actors and every plate come 1:1 from demo-session.ts `actors`/`flow` — the
// diagram regenerates with the capture. Plates show the actual message content;
// indent = delegation depth (you → agent → web-researcher → search-verifier/web).
// data-node chips + data-edge plates are driven by DemoSession's replay script;
// without JS (or reduced motion) the complete flow renders statically.
import Icon from './Icon.astro';
import { actors, flow } from '../data/demo-session';

// "web-researcher" → ["web-", "researcher"]: prefix hidden below sm to fit 390px
const split = (name: string) => {
  const dash = name.indexOf('-');
  return dash > 0 ? [name.slice(0, dash + 1), name.slice(dash + 1)] : ['', name];
};
---

<figure
  role="img"
  aria-label={`Message flow of the replayed session: ${flow.map((h, i) => `${i + 1}. ${h.from} to ${h.to} — ${h.text}`).join('; ')}. Every hop is appended to the bus-events trace below.`}
>
  <!-- actor strip -->
  <div class="flex items-center" aria-hidden="true">
    {
      actors.map((a, i) => {
        const [pre, rest] = split(a.label);
        return (
          <>
            {i > 0 && <span class="h-px min-w-1.5 flex-1 bg-edge" />}
            <span
              data-node={a.key}
              class="tf-chip inline-flex items-center gap-1 border border-edge bg-surface/70 px-1.5 py-1.5 font-mono text-[9px] text-ink sm:gap-1.5 sm:px-2 sm:text-[10px]"
            >
              <Icon name={a.icon} class="size-3 sm:size-3.5" />
              <span class="tf-chip-label">{pre && <span class="hidden sm:inline">{pre}</span>}{rest}</span>
            </span>
          </>
        );
      })
    }
  </div>

  <!-- message plates: real content, numbered, indented by delegation depth -->
  <ol class="mt-3 space-y-1" aria-hidden="true">
    {
      flow.map((h, i) => (
        <li
          data-edge={i}
          class="flex min-w-0 items-center gap-2"
          style={`margin-left:${h.depth * 14}px`}
        >
          {h.kind === 'call' ? (
            <span class="flex size-[18px] shrink-0 items-center justify-center bg-accent font-mono text-[9.5px] font-semibold text-accent-ink">
              {i + 1}
            </span>
          ) : (
            <span class="flex size-[18px] shrink-0 items-center justify-center border border-accent/50 font-mono text-[9.5px] font-semibold text-accent">
              {i + 1}
            </span>
          )}
          <div
            class:list={[
              'flex min-w-0 flex-1 items-baseline gap-2 border px-2 py-[5px]',
              h.kind === 'call' ? 'border-edge bg-surface/70' : 'border-dashed border-edge/80 bg-surface/40',
            ]}
          >
            <span class="shrink-0 font-mono text-[9.5px] text-dim">
              {split(h.from).map((s, j) => (j === 0 && s ? <span class="hidden sm:inline">{s}</span> : s))}
              <span class="text-accent/70">▸</span>
              {split(h.to).map((s, j) => (j === 0 && s ? <span class="hidden sm:inline">{s}</span> : s))}
            </span>
            <span
              class:list={['truncate font-mono text-[11px]', h.kind === 'call' ? 'text-ink' : 'text-dim']}
              title={h.text}
            >
              {h.text}
            </span>
          </div>
        </li>
      ))
    }
  </ol>

  <figcaption class="mt-3 flex items-center justify-between font-mono text-[10px] text-dim">
    <span>solid → call · dashed → return</span>
    <span class="hidden sm:inline">1 … {flow.length} — real message order</span>
  </figcaption>
</figure>
