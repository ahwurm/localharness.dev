---
// Message flow of the REAL replayed session, drawn in the architectural-plate
// language (Alex's LocalHarness plate reference): sublabeled node boxes inside
// dashed trust-boundary containers, labeled edges with numbered badges
// (solid → call, dashed → return), legend row. The security story is geometry:
// web-researcher / search-verifier live with web tools only; UNTRUSTED web
// content has no path to bash/write/edit.
//
// Two representations, one sync contract:
//   sm+  → the 2D plate (inline SVG below)
//   <sm  → the node-wire rail (FlowLedger; SVG text would microfiche at 390)
// Both carry the SAME data-node keys and data-edge indices 0…8 (flow[] in
// demo-session.ts is the shared source for hop content), so DemoSession's
// replay drives whichever is visible. Without JS (or reduced motion) the
// complete flow renders statically.
import Icon from './Icon.astro';
import FlowLedger from './FlowLedger.astro';
import { actors, flow } from '../data/demo-session';

// "web-researcher" → "researcher": short names for the rail (it only renders below sm)
const short = (name: string) => {
  const dash = name.indexOf('-');
  return dash > 0 ? name.slice(dash + 1) : name;
};
const iconOf = (name: string) => actors.find((a) => a.label === name)?.icon;
const railRows = flow.map((h, i) => ({
  kind: h.kind === 'ret' ? ('loop' as const) : ('step' as const),
  n: i + 1,
  icon: iconOf(h.from),
  header: `${short(h.from)} ▸ ${short(h.to)}`,
  text: h.text,
  depth: h.depth,
  edge: i,
}));
---

<figure
  role="img"
  aria-label={`Message flow of the replayed session: ${flow.map((h, i) => `${i + 1}. ${h.from} to ${h.to} — ${h.text}`).join('; ')}. The web-researcher and search-verifier hold web tools only — untrusted web content has no path to bash, write, or edit. Every hop is appended to the bus-events trace below.`}
>
  <!-- sm+: architectural-plate diagram -->
  <div class="hidden sm:block" aria-hidden="true">
    <svg viewBox="0 0 520 442" class="mx-auto w-full max-w-[560px]">
      <defs>
        <marker id="tf-a" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-accent" stroke-width="1.4"></path>
        </marker>
        <marker id="tf-d" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.3"></path>
        </marker>
      </defs>

      <!-- trust-boundary containers -->
      <rect x="12" y="20" width="332" height="396" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="4 4"></rect>
      <rect x="20" y="14" width="132" height="13" class="fill-surface stroke-edge" stroke-width="1"></rect>
      <text x="26" y="23.5" class="fill-dim font-mono text-[8px] tracking-[0.08em]">YOUR MACHINE · TOOLS</text>
      <rect x="362" y="20" width="146" height="396" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="4 4"></rect>
      <rect x="370" y="14" width="128" height="13" class="fill-surface stroke-edge" stroke-width="1"></rect>
      <text x="376" y="23.5" class="fill-dim font-mono text-[8px] tracking-[0.08em]">OPEN WEB · UNTRUSTED</text>

      <!-- nodes -->
      <g data-node="you">
        <rect x="28" y="48" width="118" height="46" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="87" y="68" text-anchor="middle" class="fill-ink font-mono text-[12px]">you</text>
        <text x="87" y="81" text-anchor="middle" class="fill-dim font-mono text-[9px]">&gt; research task</text>
      </g>
      <g data-node="agent">
        <rect x="198" y="48" width="128" height="46" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="262" y="68" text-anchor="middle" class="fill-ink font-mono text-[12px]">orchestrator</text>
        <text x="262" y="81" text-anchor="middle" class="fill-dim font-mono text-[9px]">qwen3.6-27b · vLLM</text>
      </g>
      <g data-node="researcher">
        <rect x="198" y="162" width="128" height="54" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="262" y="181" text-anchor="middle" class="fill-ink font-mono text-[12px]">web-researcher</text>
        <text x="262" y="194" text-anchor="middle" class="fill-dim font-mono text-[9px]">web tools only</text>
        <text x="262" y="206" text-anchor="middle" class="fill-dim font-mono text-[9px]">no bash · no write</text>
      </g>
      <g data-node="verifier">
        <rect x="198" y="296" width="128" height="54" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="262" y="315" text-anchor="middle" class="fill-ink font-mono text-[12px]">search-verifier</text>
        <text x="262" y="328" text-anchor="middle" class="fill-dim font-mono text-[9px]">blind re-check</text>
        <text x="262" y="340" text-anchor="middle" class="fill-dim font-mono text-[9px]">sees the claim only</text>
      </g>
      <g data-node="web">
        <rect x="386" y="162" width="110" height="188" class="fill-bg stroke-edge" stroke-width="1.4"></rect>
        <text x="441" y="184" text-anchor="middle" class="fill-ink font-mono text-[12px]">web</text>
        <text x="441" y="202" text-anchor="middle" class="fill-dim font-mono text-[9px]">ddgs · live pages</text>
        <text x="441" y="220" text-anchor="middle" class="fill-dim font-mono text-[9px]">web_search ×14</text>
        <text x="441" y="234" text-anchor="middle" class="fill-dim font-mono text-[9px]">web_fetch ×16</text>
        <text x="441" y="248" text-anchor="middle" class="fill-dim font-mono text-[9px]">page_query ×3</text>
        <line x1="398" y1="312" x2="484" y2="312" class="stroke-edge" stroke-width="1"></line>
        <text x="441" y="327" text-anchor="middle" class="fill-dim font-mono text-[9px]">no path to bash</text>
        <text x="441" y="339" text-anchor="middle" class="fill-dim font-mono text-[9px]">/ write / edit</text>
      </g>

      <!-- edges: solid accent = call, dashed dim = return; badges = real message order -->
      <g data-edge="0">
        <text x="172" y="59" text-anchor="middle" class="fill-dim font-mono text-[9px]">task</text>
        <line x1="146" y1="70" x2="190" y2="70" pathLength="1" class="stroke-accent" stroke-width="1.4" marker-end="url(#tf-a)"></line>
        <circle cx="158" cy="70" r="7" class="fill-accent"></circle>
        <text x="158" y="73" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">1</text>
      </g>
      <g data-edge="1">
        <text x="239" y="121" text-anchor="start" class="fill-dim font-mono text-[9px]">delegate</text>
        <line x1="228" y1="94" x2="228" y2="154" pathLength="1" class="stroke-accent" stroke-width="1.4" marker-end="url(#tf-a)"></line>
        <circle cx="228" cy="118" r="7" class="fill-accent"></circle>
        <text x="228" y="121" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">2</text>
      </g>
      <g data-edge="2">
        <text x="356" y="179" text-anchor="middle" class="fill-dim font-mono text-[9px]">queries ×23</text>
        <line x1="326" y1="190" x2="378" y2="190" pathLength="1" class="stroke-accent" stroke-width="1.4" marker-end="url(#tf-a)"></line>
        <circle cx="348" cy="190" r="7" class="fill-accent"></circle>
        <text x="348" y="193" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">3</text>
      </g>
      <g data-edge="3">
        <line x1="386" y1="216" x2="334" y2="216" pathLength="1" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#tf-d)"></line>
        <circle cx="360" cy="216" r="7" class="fill-surface stroke-accent/60" stroke-width="1.2"></circle>
        <text x="360" y="219" text-anchor="middle" class="fill-accent font-mono text-[9px] font-semibold">4</text>
        <text x="360" y="232" text-anchor="middle" class="fill-dim font-mono text-[9px]">UNTRUSTED</text>
      </g>
      <g data-edge="4">
        <text x="239" y="251" text-anchor="start" class="fill-dim font-mono text-[9px]">verify claim ×2</text>
        <line x1="228" y1="216" x2="228" y2="288" pathLength="1" class="stroke-accent" stroke-width="1.4" marker-end="url(#tf-a)"></line>
        <circle cx="228" cy="248" r="7" class="fill-accent"></circle>
        <text x="228" y="251" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">5</text>
      </g>
      <g data-edge="5">
        <text x="356" y="312" text-anchor="middle" class="fill-dim font-mono text-[9px]">re-pull ×7</text>
        <line x1="326" y1="323" x2="378" y2="323" pathLength="1" class="stroke-accent" stroke-width="1.4" marker-end="url(#tf-a)"></line>
        <circle cx="348" cy="323" r="7" class="fill-accent"></circle>
        <text x="348" y="326" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">6</text>
      </g>
      <g data-edge="6">
        <text x="285" y="269" text-anchor="end" class="fill-dim font-mono text-[9px]">verdict=SUPPORTED</text>
        <line x1="296" y1="296" x2="296" y2="224" pathLength="1" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#tf-d)"></line>
        <circle cx="296" cy="266" r="7" class="fill-surface stroke-accent/60" stroke-width="1.2"></circle>
        <text x="296" y="269" text-anchor="middle" class="fill-accent font-mono text-[9px] font-semibold">7</text>
      </g>
      <g data-edge="7">
        <text x="307" y="141" text-anchor="start" class="fill-dim font-mono text-[9px]">findings</text>
        <line x1="296" y1="162" x2="296" y2="102" pathLength="1" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#tf-d)"></line>
        <circle cx="296" cy="138" r="7" class="fill-surface stroke-accent/60" stroke-width="1.2"></circle>
        <text x="296" y="141" text-anchor="middle" class="fill-accent font-mono text-[9px] font-semibold">8</text>
      </g>
      <g data-edge="8">
        <line x1="198" y1="88" x2="154" y2="88" pathLength="1" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#tf-d)"></line>
        <circle cx="176" cy="88" r="7" class="fill-surface stroke-accent/60" stroke-width="1.2"></circle>
        <text x="176" y="91" text-anchor="middle" class="fill-accent font-mono text-[9px] font-semibold">9</text>
        <text x="172" y="106" text-anchor="middle" class="fill-accent font-mono text-[9px]">Qwen 3.6 27B</text>
      </g>

      <!-- legend -->
      <text x="14" y="436" class="fill-dim font-mono text-[9px]">solid → call · dashed → return</text>
      <text x="506" y="436" text-anchor="end" class="fill-dim font-mono text-[9px]">① … ⑨ — real message order</text>
    </svg>
  </div>

  <!-- <sm: node-wire rail (the plate's text would be illegible this small) -->
  <div class="sm:hidden" aria-hidden="true">
    <div class="flex flex-wrap items-center gap-y-2">
      {
        actors.map((a, i) => (
          <>
            {i > 0 && <span class="h-px min-w-1.5 flex-1 bg-edge" />}
            <span
              data-node={a.key}
              class="tf-chip inline-flex items-center gap-1 border border-edge bg-surface/70 px-1.5 py-1.5 font-mono text-[9px] text-ink"
            >
              <Icon name={a.icon} class="size-3" />
              <span class="tf-chip-label">{short(a.label)}</span>
            </span>
          </>
        ))
      }
    </div>

    <FlowLedger class="mt-3" rows={railRows} />
    <div class="mt-3 font-mono text-[10px] text-dim">solid → call · dashed → return</div>
  </div>
</figure>
