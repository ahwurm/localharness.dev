---
// One plugin's setup as a looping typed replay inside a running session (`localharness start`): the
// session's own frame (wordmark, model, Plugins: line), `/plugins enable <name>` at the ❯ prompt, the
// wizard step inline, the Plugins: line gaining the name, the plugin in use, then the copyable
// "paste this into your coding agent" prompt. Data + provenance in src/data/plugins.ts SETUP. The
// in-session step is landing; the caption names today's shell command. Server renders the finished
// state; JS (motion permitting, while on screen) hides-then-types, holds, and restarts. Lines keep
// their box while hidden (visibility), so the frame never jumps.
import CodeBlock from './CodeBlock.astro';
import { SETUP } from '../data/plugins';
import bannerRaw from '../data/banner.txt?raw';
interface Props {
  name: string;
}
const { name } = Astro.props;
const flow = SETUP[name];
if (!flow) throw new Error(`SetupFlow: no SETUP entry for '${name}'`);
const tone: Record<string, string> = { good: 'text-accent/90', dim: 'text-dim', out: 'text-ink/85', ask: 'text-ink/85' };
// the Plugins: line, with the gained name (and its separator) in its own span
const gi = flow.plugins.indexOf(name);
const seg = flow.plugins.map((n, i) => ({ gain: i === gi, text: (i > 0 && !(i === 1 && gi === 0) ? ', ' : '') + n + (i === gi && i === 0 && flow.plugins.length > 1 ? ', ' : '') }));
---

<div data-setup-flow class="mt-6">
  <div class="overflow-hidden border border-edge bg-surface/80">
    <div class="flex items-center justify-between gap-4 border-b border-edge/70 px-4 py-2">
      <span class="min-w-0 truncate font-mono text-xs text-dim">~/project — localharness start</span>
      <span class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[11px] text-dim">
        <span class="inline-block size-2 border border-dim" style="background:repeating-linear-gradient(45deg,var(--color-dim) 0 1px,transparent 1px 3px)"></span>
        landing
      </span>
    </div>
    <div class="p-4 font-mono text-[13px] leading-[1.75]">
      <pre class="ascii-art my-1 overflow-hidden text-[7px] leading-[1.15] text-accent" aria-hidden="true">{bannerRaw}</pre>
      <div class="mt-2 whitespace-pre text-dim">qwen3.6-27b    ~/project</div>
      <div class="whitespace-pre-wrap text-accent/70">  Plugins: {seg.map((s) => (s.gain ? <span data-sf-gain class="sf-gain">{s.text}</span> : s.text))}</div>
      {
        flow.lines.map((l, i) =>
          l.kind === 'gain' ? (
            <span data-sf-line={i} data-sf-gainstep hidden />
          ) : l.kind === 'you' ? (
            <div data-sf-line={i} class="my-2 whitespace-pre-wrap border border-dim/40 px-3 py-1.5 [overflow-wrap:anywhere]"><span class="select-none text-accent">❯ </span><span class="text-ink" data-sf-type={l.text}>{l.text}</span></div>
          ) : (
            <div data-sf-line={i} data-sf-ask={l.kind === 'ask' ? '' : undefined} class:list={['whitespace-pre-wrap [overflow-wrap:anywhere]', tone[l.kind]]}>{l.text}{l.kind === 'ask' && l.answer && <span class="text-ink" data-sf-type={l.answer}>{l.answer}</span>}</div>
          )
        )
      }
    </div>
  </div>
  <p class="mt-3 font-mono text-[11px] text-dim">_in-session step landing · today: <span class="text-ink/80">localharness plugins enable {name}</span></p>
  <CodeBlock class="mt-6" wrap label="paste into your coding agent to set it up for your hardware" code={flow.prompt} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-setup-flow]').forEach((root) => {
    if (root.dataset.sfInit) return;
    root.dataset.sfInit = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines = [...root.querySelectorAll<HTMLElement>('[data-sf-line]')];
    const gain = root.querySelector<HTMLElement>('[data-sf-gain]');
    const typed = () => root.querySelectorAll<HTMLElement>('[data-sf-type]');
    let timers: number[] = [];
    let on = false;
    const at = (t: number, fn: () => void) => timers.push(window.setTimeout(fn, t));
    const finish = () => {
      timers.forEach(clearTimeout);
      lines.forEach((el) => (el.style.visibility = 'visible'));
      typed().forEach((el) => (el.textContent = el.dataset.sfType ?? ''));
      gain?.classList.remove('sf-off', 'sf-new');
    };
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      lines.forEach((el) => (el.style.visibility = 'hidden'));
      typed().forEach((el) => (el.textContent = ''));
      gain?.classList.add('sf-off');
      gain?.classList.remove('sf-new');
      let t = 900; // the session frame sits idle a beat before the user types
      for (const el of lines) {
        if (el.hasAttribute('data-sf-gainstep')) {
          at(t, () => gain?.classList.replace('sf-off', 'sf-new'));
          t += 900;
          continue;
        }
        at(t, () => (el.style.visibility = 'visible'));
        const tp = el.querySelector<HTMLElement>('[data-sf-type]');
        if (tp) {
          const text = tp.dataset.sfType ?? '';
          const lead = el.hasAttribute('data-sf-ask') ? 700 : 200; // a question waits for the answer
          [...text].forEach((c, ci) => at(t + lead + ci * 28, () => (tp.textContent += c)));
          t += lead + text.length * 28 + 450;
        } else t += el.hasAttribute('data-sf-ask') ? 1100 : 380; // a question waits for Enter
      }
      at(t + 4200, () => on && play()); // hold on the finished state, then restart
    };
    new IntersectionObserver(
      (entries) => {
        const vis = entries.some((e) => e.isIntersecting);
        if (vis && !on) {
          on = true;
          play();
        } else if (!vis && on) {
          on = false;
          finish();
        }
      },
      { threshold: 0.3 }
    ).observe(root);
  });
</script>

<style>
  .sf-gain {
    transition: color 1.2s var(--ease-reveal);
  }
  .sf-off {
    display: none;
  }
  .sf-new {
    color: var(--color-ink);
  }
</style>
