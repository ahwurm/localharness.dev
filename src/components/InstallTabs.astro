---
// Hero install block with one thin method-tab row (uv default · curl · pip · git).
// Same box/visual weight as CodeBlock; tab styling mirrors AgentYamlTabs.
interface Tab {
  id: string;
  code: string;
}
interface Props {
  tabs: Tab[];
  class?: string;
}
const { tabs, class: className = '' } = Astro.props;
---

<div data-install-tabs class:list={['overflow-hidden border border-edge bg-surface/80', className]}>
  <div class="flex items-center justify-between border-b border-edge/70 py-1.5 pl-4 pr-2">
    <div class="flex items-center gap-1" role="tablist" aria-label="Install methods">
      <span class="mr-2 font-mono text-xs text-dim">install</span>
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`it-tab-${t.id}`}
            aria-controls={`it-panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-it-tab={t.id}
            class:list={[
              'border px-2 py-0.5 font-mono text-xs transition-colors duration-200',
              i === 0 ? 'border-accent/50 bg-accent/10 text-accent' : 'border-transparent text-dim hover:text-ink',
            ]}
          >
            {t.id}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      data-copy={tabs[0].code}
      aria-label="Copy install commands to clipboard"
      class="border border-transparent px-2 py-0.5 font-mono text-xs text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
    >
      copy
    </button>
  </div>
  {
    tabs.map((t, i) => (
      <pre
        id={`it-panel-${t.id}`}
        role="tabpanel"
        aria-labelledby={`it-tab-${t.id}`}
        data-it-panel={t.id}
        class:list={[
          'overflow-x-auto whitespace-pre-wrap [overflow-wrap:anywhere] p-4 font-mono text-sm leading-relaxed text-ink sm:whitespace-pre',
          i !== 0 && 'hidden',
        ]}
      ><code>{t.code}</code></pre>
    ))
  }
</div>

<script>
  const ACTIVE = ['border-accent/50', 'bg-accent/10', 'text-accent'];
  const INACTIVE = ['border-transparent', 'text-dim', 'hover:text-ink'];
  document.querySelectorAll<HTMLElement>('[data-install-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-it-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-it-panel]')];
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((b) => {
          const on = b === tab;
          b.setAttribute('aria-selected', String(on));
          b.classList.remove(...(on ? INACTIVE : ACTIVE));
          b.classList.add(...(on ? ACTIVE : INACTIVE));
        });
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.itPanel !== tab.dataset.itTab));
        const active = panels.find((p) => p.dataset.itPanel === tab.dataset.itTab);
        if (copyBtn && active) copyBtn.dataset.copy = active.textContent ?? '';
      })
    );
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-install-tabs] [data-copy]');
    if (!btn) return;
    await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    const prev = btn.textContent;
    btn.textContent = 'copied';
    btn.classList.add('text-accent', 'border-accent/40');
    setTimeout(() => {
      btn.textContent = prev;
      btn.classList.remove('text-accent', 'border-accent/40');
    }, 1200);
  });
</script>
