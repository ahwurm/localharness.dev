---
// PLATE MOBILE — the mobile plugin (code name `web`): your phone as a channel (fig. 01 of
// /plugins/mobile/). Redrawn 2026-10-02 to the PLATE M grammar (MemoryPlateII). Left, what CORE
// provides: the event bus, the one permission gate, the artifact roots core computes and serves, the
// memory slot's browse(). Hairline. Middle, what the PLUGIN owns, two columns: nearer core the
// channel side (WebChannel, the untrusted_ingest label, the Pictures and Memory screens, WebPlugin);
// nearer the phone the network side (the `localharness web` server, QR pairing, push). Right, OUTSIDE:
// your phone through your proxy. Badges ①–⑦ = one message: the phone posts → the server hands it to
// the channel → a turn on the bus → every event back → the stream to the phone → the gate parks an
// ask → push. Two lanes (call above, return below) keep the four hops one straight line each.
// Sources (localharness main @ 582b69c, v0.16.0): cli/web_plugin.py, channels/web/{server,channel,
// protocol,push}.py docstrings, docs/web.md, SECURITY.md "`localharness web`", docs/specs/09
// "The bundled plugins" + "Artifacts" + "The memory slot", CHANGELOG 0.16.0 Known limitations.
// Hue: infra (channels are infra on Plate I). Marker ids pw-*. SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';

type Tone = 'core' | 'plug' | 'out';
const stroke: Record<Tone, string> = { core: 'stroke-accent/70', plug: 'stroke-infra/70', out: 'stroke-edge' };
const hue: Record<Tone, string> = { core: 'fill-accent', plug: 'fill-infra', out: 'fill-ink' };
type N = [number, number, number, number, Tone, string, string[], number?, boolean?];
const nodes: N[] = [
  // CORE
  [28, 114, 296, 64, 'core', 'EventBus', ['core/bus.py · typed · ordered', 'UserMessage in · every event out', 'a channel sees every event, tool results too'], 2, true],
  [28, 196, 296, 76, 'core', 'PermissionGate', ['one gate: the orchestrator and every subagent', 'auto: a blacklisted call is parked —', 'the model carries on without that step', 'answer from the phone, terminal or Discord']],
  [28, 290, 296, 64, 'core', 'artifact roots', ['core computes <state dir>/artifacts/<plugin>/', 'serves only the roots this session bound', 'png · jpeg · webp · a core-minted id']],
  [28, 372, 296, 52, 'core', 'MemorySlot · browse()', ['plugins/slot.py · the occupant’s browse API', 'list · search · history · edit · forget']],
  // PLUGIN — channel side
  [388, 114, 240, 76, 'plug', 'WebChannel', ['channels/web/channel.py', 'the bus, faithfully, over one SSE stream', 'asks: a queue with a badge, not a modal', 'an unanswered ask ends in a rejection'], 3, true],
  [388, 236, 240, 52, 'plug', 'untrusted_ingest', ['web_search · web_fetch · web_page_query', 'a label, never a filter — nothing dropped']],
  [388, 306, 240, 88, 'plug', 'Pictures · Memory', ['GET /api/artifacts · 60 a page', 'id · type · size — no path, no prompt', '--incognito: no-store, gallery off', '/api/memory → the slot’s browse()', 'memory off → those routes answer 404']],
  [388, 412, 240, 76, 'plug', 'WebPlugin', ['cli/web_plugin.py · kind channel', 'on by default once the web extra is in', 'channels() → web · command → web_cmd', 'start · stop: no-ops; the command owns it']],
  // PLUGIN — network side
  [664, 114, 236, 76, 'plug', 'localharness web', ['channels/web/server.py · port 8765', 'loopback only — else --allow-unsafe-bind', 'an app token on every request · 0600', 'writes: bearer + application/json only'], 1],
  [664, 208, 236, 52, 'plug', 'QR pairing', ['the token rides the URL fragment —', 'no log sees it · rotation: all or nothing']],
  [664, 278, 236, 52, 'plug', 'push', ['push.py · VAPID keys 0600, on this box', 'payloads encrypted to each device']],
  // OUTSIDE
  [944, 114, 188, 216, 'out', 'your phone', ['reference page · one HTML file', 'fork it — the API is complete', '', 'through your proxy, over HTTPS', 'tailscale serve --bg 8765', '', 'Add to Home Screen → an app', 'lock-screen push, two reasons:', 'a long turn ended · you’re needed', '', 'a picture only from the', 'typed artifact field'], 3],
];
---

<figure
