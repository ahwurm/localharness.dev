---
// The homepage centerpiece: a REAL captured session (src/data/demo-session.ts)
// replayed in a terminal while the architecture diagram + event bus tick in sync.
// Server renders the complete final state — without JS (or with reduced motion)
// everything is simply visible. The script only hides-then-replays.
import TraceFlow from './TraceFlow.astro';
import { lines, eventTotal } from '../data/demo-session';

const allEvents = lines.flatMap((l) => l.ev ?? []);
const program = lines.map((l, i) => ({
  i,
  kind: l.kind,
  d: l.d ?? 350,
  node: l.node ?? null,
  edge: l.edge ?? null,
  ev: (l.ev ?? []).length,
  text: l.kind === 'prompt' ? l.text : null,
}));
---

<div id="demo" class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
  <!-- terminal -->
  <div class="flex min-w-0 flex-col overflow-hidden border border-edge bg-surface/80">
    <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2">
      <span class="truncate font-mono text-xs text-dim">~/localharness — real session · qwen3.6-27b on vLLM</span>
      <button
        type="button"
        data-replay
        class="hidden border border-edge px-2 py-0.5 font-mono text-[11px] text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
        >replay</button
      >
    </div>
    <div
      data-body
      class="h-[420px] overflow-y-auto p-4 font-mono text-[13px] leading-[1.75] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden xl:h-auto xl:min-h-[420px] xl:flex-1"
    >
      {
        lines.map((l, i) => {
          if (l.kind === 'cmd')
            return (
              <div data-dl={i}>
                <span class="select-none text-accent/80">$ </span>
                <span class="text-ink">{l.text}</span>
              </div>
            );
          if (l.kind === 'prompt')
            return (
              <div data-dl={i} class="mt-2">
                <span class="select-none text-accent">&gt; </span>
                <span class="text-ink" data-typed>
                  {l.text}
                </span>
              </div>
            );
          if (l.kind === 'tool')
            return (
              <div data-dl={i} class="pl-2 text-ink/85">
                <span class="text-accent/80">◆ </span>
                {l.text.replace(/^◆ /, '')}
              </div>
            );
          if (l.kind === 'ok')
            return (
              <div data-dl={i} class="pl-2 text-dim">
                <span class="text-accent/70">✓ </span>
                {l.text.replace(/^✓ /, '')}
              </div>
            );
          if (l.kind === 'answer')
            return (
              <div data-dl={i} class="my-2 border border-edge/80 px-3 py-2">
                <span class="block font-mono text-[10px] tracking-wide text-dim">default</span>
                <span class="text-ink">{l.text}</span>
              </div>
            );
          if (l.kind === 'art')
            return (
              <pre
                data-dl={i}
                class="ascii-art my-1 overflow-hidden text-[7px] leading-[1.15] text-accent"
              >{l.text}</pre>
            );
          if (l.kind === 'meta')
            return (
              <div data-dl={i} class="whitespace-pre text-dim">
                {l.text}
              </div>
            );
          return (
            <div data-dl={i} class="text-dim">
              {l.text}
            </div>
          );
        })
      }
      <div data-tail class="mt-2 flex items-baseline justify-between">
        <span
          ><span class="select-none text-accent">&gt; </span><span
            class="inline-block h-[1em] w-[0.6em] translate-y-[2px] bg-accent/80 motion-safe:[animation:blink_1.2s_steps(1)_infinite]"
            aria-hidden="true"></span></span
        >
        <span class="text-[11px] text-dim">░░░░░░░░░░ 2%</span>
      </div>
    </div>
  </div>

  <!-- diagram + event bus -->
  <div class="flex min-w-0 flex-col gap-4">
    <div class="overflow-x-auto border border-edge bg-surface/60 p-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <TraceFlow />
    </div>
    <div class="flex min-h-0 flex-1 flex-col overflow-hidden border border-edge bg-surface/60">
      <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2 font-mono text-xs text-dim">
        <span>bus-events.jsonl — append-only</span>
        <span><span data-ev-count>{eventTotal}</span> events</span>
      </div>
      <ol data-ticker class="h-[132px] overflow-y-auto px-4 py-2 font-mono text-[11px] leading-[1.9] text-dim [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {allEvents.map((e, i) => <li data-ev={i}>{e}</li>)}
      </ol>
    </div>
  </div>
</div>

<script type="application/json" id="demo-program" set:html={JSON.stringify({ program, total: eventTotal })} />

<script>
  (() => {
    const root = document.getElementById('demo');
    const programEl = document.getElementById('demo-program');
    if (!root || !programEl) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // static final state stays

    const { program, total } = JSON.parse(programEl.textContent || '{}') as {
      program: {
        i: number;
        kind: string;
        d: number;
        node: string | null;
        edge: number | null;
        ev: number;
        text: string | null;
      }[];
      total: number;
    };
    if (!program?.length) return;
    const lineEls = [...root.querySelectorAll<HTMLElement>('[data-dl]')];
    const evEls = [...root.querySelectorAll<HTMLElement>('[data-ev]')];
    const typedEl = root.querySelector<HTMLElement>('[data-typed]');
    const tailEl = root.querySelector<HTMLElement>('[data-tail]');
    const countEl = root.querySelector<HTMLElement>('[data-ev-count]');
    const body = root.querySelector<HTMLElement>('[data-body]');
    const ticker = root.querySelector<HTMLElement>('[data-ticker]');
    const btn = root.querySelector<HTMLElement>('[data-replay]');
    if (!typedEl || !tailEl || !countEl || !body || !ticker) return;

    let timers: number[] = [];
    let played = false;
    const at = (t: number, fn: () => void) => timers.push(window.setTimeout(fn, t));
    const setLive = (name: string | null) => {
      root.querySelectorAll('[data-node].is-live').forEach((n) => n.classList.remove('is-live'));
      if (name) root.querySelectorAll(`[data-node="${name}"]`).forEach((n) => n.classList.add('is-live'));
    };

    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      root.classList.add('demo-live');
      lineEls.forEach((el) => el.classList.add('demo-hidden'));
      evEls.forEach((el) => el.classList.add('demo-hidden'));
      root.querySelectorAll('[data-edge]').forEach((el) => el.classList.remove('edge-in'));
      tailEl.classList.add('demo-hidden');
      typedEl.textContent = '';
      countEl.textContent = '0';
      setLive(null);
      body.scrollTop = 0;

      let t = 400;
      let evCursor = 0;
      for (const step of program) {
        t += step.d;
        const reveal = t;
        if (step.kind === 'prompt' && step.text) {
          at(reveal, () => {
            lineEls[step.i].classList.remove('demo-hidden');
            body.scrollTop = body.scrollHeight;
          });
          const chars = step.text.split('');
          chars.forEach((c, ci) =>
            at(reveal + 220 + ci * 13, () => {
              typedEl.textContent += c;
            })
          );
          t = reveal + 220 + chars.length * 13 + 180;
        } else {
          at(reveal, () => {
            lineEls[step.i].classList.remove('demo-hidden');
            body.scrollTop = body.scrollHeight;
          });
        }
        if (step.node) at(t, () => setLive(step.node));
        if (step.edge !== null)
          at(t, () =>
            root.querySelectorAll(`[data-edge="${step.edge}"]`).forEach((el) => el.classList.add('edge-in'))
          );
        for (let k = 0; k < step.ev; k++) {
          const idx = evCursor++;
          at(t + k * 110, () => {
            evEls[idx].classList.remove('demo-hidden');
            countEl.textContent = String(idx + 1);
            ticker.scrollTop = ticker.scrollHeight;
          });
        }
      }
      at(t + 700, () => {
        tailEl.classList.remove('demo-hidden');
        body.scrollTop = body.scrollHeight;
        setLive(null);
        countEl.textContent = String(total); // full turn incl. events the ticker doesn't sample
      });
    };

    btn?.classList.remove('hidden');
    btn?.addEventListener('click', play);
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting) && !played) {
          played = true;
          play();
          io.disconnect();
        }
      },
      { threshold: 0.3 }
    ).observe(root);
  })();
</script>

<style is:global>
  #demo .demo-hidden {
    display: none;
  }
  #demo [data-node] rect,
  #demo [data-node] text {
    transition:
      stroke 0.45s var(--ease-reveal),
      fill 0.45s var(--ease-reveal);
  }
  #demo [data-node].is-live rect {
    stroke: var(--color-accent);
  }
  #demo [data-node].is-live text {
    fill: var(--color-accent);
  }
  /* trace arrows: fully visible statically; during a replay they slide in per step */
  @media (prefers-reduced-motion: no-preference) {
    #demo.demo-live [data-edge] {
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity 0.45s var(--ease-reveal),
        transform 0.45s var(--ease-reveal);
    }
    #demo.demo-live [data-edge].edge-in {
      opacity: 1;
      transform: none;
    }
  }
</style>
