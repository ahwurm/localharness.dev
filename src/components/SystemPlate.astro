---
// fig. 01 — the canonical component view: the whole harness on one machine.
// Numbered badges 1..7 are PART numbers (not message order) and map 1:1 to the
// `_the parts` rows beside the plate. Plate SVG at sm+, FlowLedger rail below sm
// (same content). Marker ids are f01- prefixed (document-global; see plateTokens).
// Vocabulary inlined from plateTokens.ts (do NOT import). Providers render on two
// lines inside the model-server node purely to fit the corridor — same content.
import FlowLedger from './FlowLedger.astro';
---

<figure
  role="img"
  aria-label="The whole harness on one machine. 1, you — a terminal or a chat app. 2, the orchestrator — one main agent that thinks, acts, checks, and repeats. 3, tools — read, write, run, and search, granted deny-first. 4, helpers — explore, web-researcher, search-verifier, and cruncher, each in a fresh window. 5, the model server — vLLM, Ollama, LM Studio, or llama.cpp, an OpenAI-compatible endpoint on your own machine. 6, the event bus — an append-only record of every step, in order. 7, memory — facts, sittings, and MEMORY.md, gated on the way in and filed while idle. The open web is untrusted and sits outside the machine; only the helpers reach it, and what comes back is marked untrusted."
>
  <!-- sm+: architectural-plate diagram -->
  <div class="hidden w-full sm:block" aria-hidden="true">
    <svg viewBox="0 0 560 486" class="mx-auto w-full max-w-[560px]">
      <defs>
        <marker id="f01-a" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-accent" stroke-width="1.4"></path>
        </marker>
        <marker id="f01-d" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.3"></path>
        </marker>
      </defs>

      <!-- containers -->
      <rect x="12" y="20" width="440" height="442" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="4 4"></rect>
      <rect x="20" y="13.5" width="112" height="13" class="fill-surface stroke-edge" stroke-width="1"></rect>
      <text x="26" y="23" class="fill-dim font-mono text-[8px] tracking-[0.08em]">YOUR MACHINE</text>

      <rect x="28" y="300" width="214" height="92" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="4 4"></rect>
      <rect x="36" y="293.5" width="112" height="13" class="fill-surface stroke-edge" stroke-width="1"></rect>
      <text x="42" y="303" class="fill-dim font-mono text-[8px] tracking-[0.08em]">MODEL SERVER</text>

      <!-- web: outside the machine, untrusted -->
      <rect x="466" y="150" width="80" height="64" class="fill-bg stroke-edge" stroke-width="1.4"></rect>
      <text x="506" y="180" text-anchor="middle" class="fill-ink font-mono text-[12px]">web</text>
      <text x="506" y="196" text-anchor="middle" class="fill-dim font-mono text-[9px]">untrusted</text>

      <!-- nodes -->
      <g data-node="you">
        <rect x="32" y="48" width="130" height="46" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="97" y="68" text-anchor="middle" class="fill-ink font-mono text-[12px]">you</text>
        <text x="97" y="81" text-anchor="middle" class="fill-dim font-mono text-[9px]">terminal · chat app</text>
        <circle cx="32" cy="48" r="7" class="fill-accent"></circle>
        <text x="32" y="51" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">1</text>
      </g>
      <g data-node="orchestrator">
        <rect x="216" y="48" width="200" height="46" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="316" y="68" text-anchor="middle" class="fill-ink font-mono text-[12px]">orchestrator</text>
        <text x="316" y="81" text-anchor="middle" class="fill-dim font-mono text-[9px]">think · act · check — repeat</text>
        <circle cx="216" cy="48" r="7" class="fill-accent"></circle>
        <text x="216" y="51" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">2</text>
      </g>
      <g data-node="tools">
        <rect x="32" y="130" width="180" height="54" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="122" y="150" text-anchor="middle" class="fill-ink font-mono text-[12px]">tools</text>
        <text x="122" y="163" text-anchor="middle" class="fill-dim font-mono text-[9px]">read · write · run · search</text>
        <text x="122" y="176" text-anchor="middle" class="fill-dim font-mono text-[9px]">deny-first</text>
        <circle cx="32" cy="130" r="7" class="fill-accent"></circle>
        <text x="32" y="133" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">3</text>
      </g>
      <g data-node="helpers">
        <rect x="232" y="130" width="190" height="68" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="327" y="150" text-anchor="middle" class="fill-ink font-mono text-[12px]">helpers</text>
        <text x="327" y="163" text-anchor="middle" class="fill-dim font-mono text-[9px]">explore · web-researcher</text>
        <text x="327" y="176" text-anchor="middle" class="fill-dim font-mono text-[9px]">search-verifier · cruncher</text>
        <text x="327" y="189" text-anchor="middle" class="fill-dim font-mono text-[9px]">fresh window each</text>
        <circle cx="232" cy="130" r="7" class="fill-accent"></circle>
        <text x="232" y="133" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">4</text>
      </g>
      <g data-node="server">
        <rect x="44" y="316" width="182" height="66" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="135" y="336" text-anchor="middle" class="fill-ink font-mono text-[12px]">model server</text>
        <text x="135" y="349" text-anchor="middle" class="fill-dim font-mono text-[9px]">vLLM · Ollama</text>
        <text x="135" y="362" text-anchor="middle" class="fill-dim font-mono text-[9px]">LM Studio · llama.cpp</text>
        <text x="135" y="375" text-anchor="middle" class="fill-dim font-mono text-[9px]">an OpenAI-compatible endpoint</text>
        <circle cx="44" cy="316" r="7" class="fill-accent"></circle>
        <text x="44" y="319" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">5</text>
      </g>
      <g data-node="memory">
        <rect x="252" y="312" width="190" height="54" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="347" y="332" text-anchor="middle" class="fill-ink font-mono text-[12px]">memory</text>
        <text x="347" y="345" text-anchor="middle" class="fill-dim font-mono text-[9px]">facts · sittings · MEMORY.md</text>
        <text x="347" y="358" text-anchor="middle" class="fill-dim font-mono text-[9px]">gated writes · filed while idle</text>
        <circle cx="252" cy="312" r="7" class="fill-accent"></circle>
        <text x="252" y="315" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">7</text>
      </g>
      <g data-node="bus">
        <rect x="28" y="408" width="410" height="40" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="233" y="428" text-anchor="middle" class="fill-ink font-mono text-[12px]">event bus</text>
        <text x="233" y="441" text-anchor="middle" class="fill-dim font-mono text-[9px]">append-only record — every step, in order</text>
        <circle cx="28" cy="408" r="7" class="fill-accent"></circle>
        <text x="28" y="411" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">6</text>
      </g>

      <!-- edges: solid accent = work, dashed dim = the record -->
      <!-- you -> orchestrator -->
      <g>
        <text x="189" y="63" text-anchor="middle" class="fill-dim font-mono text-[9px]">task</text>
        <line x1="164" y1="71" x2="214" y2="71" class="stroke-accent" stroke-width="1.4" marker-end="url(#f01-a)"></line>
      </g>
      <!-- orchestrator -> tools (elbow through the you/orchestrator channel; a straight
           diagonal would cross the "every step" spine in a bare X) -->
      <g>
        <text x="188" y="112" text-anchor="end" class="fill-dim font-mono text-[9px]">calls</text>
        <path d="M216,86 L196,86 L196,128" class="fill-none stroke-accent" stroke-width="1.4" marker-end="url(#f01-a)"></path>
      </g>
      <!-- orchestrator -> helpers -->
      <g>
        <text x="346" y="115" text-anchor="start" class="fill-dim font-mono text-[9px]">delegates</text>
        <line x1="330" y1="96" x2="328" y2="128" class="stroke-accent" stroke-width="1.4" marker-end="url(#f01-a)"></line>
      </g>
      <!-- helpers -> web (fetch) + untrusted return -->
      <g>
        <text x="444" y="150" text-anchor="middle" class="fill-dim font-mono text-[9px]">fetch</text>
        <line x1="424" y1="158" x2="464" y2="170" class="stroke-accent" stroke-width="1.4" marker-end="url(#f01-a)"></line>
        <line x1="464" y1="190" x2="424" y2="190" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f01-d)"></line>
        <text x="444" y="204" text-anchor="middle" class="fill-dim font-mono text-[9px]">UNTRUSTED</text>
      </g>
      <!-- orchestrator <-> model server (threads the gap between tools and helpers) -->
      <g>
        <text x="228" y="250" text-anchor="start" class="fill-dim font-mono text-[9px]">every step</text>
        <line x1="222" y1="96" x2="222" y2="314" class="stroke-accent" stroke-width="1.4" marker-start="url(#f01-a)" marker-end="url(#f01-a)"></line>
      </g>
      <!-- steps recorded to the bus (representative drop) -->
      <g>
        <text x="141" y="402" text-anchor="start" class="fill-dim font-mono text-[9px]">events</text>
        <line x1="135" y1="392" x2="135" y2="406" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f01-d)"></line>
      </g>
      <!-- bus -> memory (memory consumes the record) -->
      <g>
        <text x="366" y="390" text-anchor="start" class="fill-dim font-mono text-[9px]">listens</text>
        <line x1="360" y1="406" x2="360" y2="368" class="stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f01-d)"></line>
      </g>
      <!-- memory -> orchestrator (recall routed around the outer right margin — the
           inner corridor belongs to the fetch/UNTRUSTED band and must stay clear) -->
      <g>
        <text x="476" y="324" text-anchor="start" class="fill-dim font-mono text-[9px]">recalled</text>
        <path d="M442,332 L553,332 L553,71 L418,71" class="fill-none stroke-accent" stroke-width="1.4" marker-end="url(#f01-a)"></path>
      </g>

      <!-- legend -->
      <text x="16" y="478" class="fill-dim font-mono text-[9px]">solid → work · dashed → the record</text>
      <text x="544" y="478" text-anchor="end" class="fill-dim font-mono text-[9px]">① … ⑦ — the parts</text>
    </svg>
  </div>

  <!-- <sm: node-wire rail -->
  <FlowLedger
    class="sm:hidden"
    rows={[
      { n: 1, icon: 'prompt', title: 'you', text: 'terminal · chat app' },
      { n: 2, icon: 'agent', title: 'orchestrator', text: 'think · act · check — repeat' },
      { n: 3, icon: 'gauge', title: 'tools', text: 'read · write · run · search — deny-first' },
      { n: 4, icon: 'search', title: 'helpers', text: 'explore · web-researcher · search-verifier · cruncher — fresh window each' },
      { n: 5, icon: 'server', title: 'model server', text: 'vLLM · Ollama · LM Studio · llama.cpp — an OpenAI-compatible endpoint' },
      { n: 6, icon: 'repeat', title: 'event bus', text: 'append-only record — every step, in order' },
      { n: 7, icon: 'layers', title: 'memory', text: 'facts · sittings · MEMORY.md — gated writes, filed while idle' },
      { kind: 'note', text: 'the open web is untrusted, outside the machine — only the helpers reach it, and what returns is marked untrusted' },
    ]}
  />
</figure>
