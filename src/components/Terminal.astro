---
interface Line {
  cmd: string;
  comment?: string;
}
interface Props {
  lines: Line[];
  title?: string;
  class?: string;
}
const { lines, title = '~/localharness', class: className = '' } = Astro.props;
const copyPayload = lines.map((l) => l.cmd).join('\n');
---

<div class:list={['overflow-hidden border border-edge bg-surface/80', className]}>
  <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2">
    <span class="font-mono text-xs text-dim">{title}</span>
    <span
      class="size-1.5 bg-accent/80 motion-safe:[animation:blink_2.4s_steps(1)_infinite]"
      aria-hidden="true"></span>
  </div>
  <div class="relative">
    <pre class="overflow-x-auto p-4 pr-16 font-mono text-sm leading-7"><code>{lines.map((l) => (
      <span class="block whitespace-pre"><span class="select-none text-accent/80">$ </span><span class="text-ink">{l.cmd}</span>{l.comment && <span class="text-dim">{'  # ' + l.comment}</span>}</span>
    ))}</code></pre>
    <button
      type="button"
      data-copy={copyPayload}
      aria-label="Copy commands to clipboard"
      class="absolute right-2.5 top-2.5 border border-edge bg-bg/70 px-2 py-1 font-mono text-xs text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
      >copy</button
    >
  </div>
</div>
