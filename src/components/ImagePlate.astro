// PLATE IMAGE — the image plugin behind core's tool and artifact seams (fig. 01 of /plugins/image/).
// Redrawn 2026-10-02 to the PLATE M grammar (MemoryPlateII): left, what CORE provides (the config
// layers with the machine-level fields, the loop, the registry + capability floor, the artifact
// folder, the `plugins enable` setup that runs one reachability check); hairline; right, what the
// PLUGIN owns (ImagePlugin, generate_image, the shipped workflow template, the generate-image command,
// the doctor probe); far right, OUTSIDE — the ComfyUI you run and its model files. Badges ①–⑥ = one
// picture: the model calls → the registry hands the call over → POST the workflow → the picture
// back → write_artifact → the typed ref back to the loop. No phone, no Discord (their own plates).
// Sources (localharness main @ 582b69c, v0.16.0): tools/builtin/image_plugin.py, generate_image_tool.py,
// core/artifacts.py, core/events.py (Observation.artifact), cli/plugins_cmd.py, cli/generate_image_cmd.py,
// docs/specs/09 "The bundled plugins" + "Discovery and enabling" + "Tool declarations" + "Artifacts",
// SECURITY.md "Machine-level-only settings", CHANGELOG 0.16.0 Known limitations. Marker ids pi-*.
// SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';

type Tone = 'core' | 'plug' | 'out';
const stroke: Record<Tone, string> = { core: 'stroke-accent/70', plug: 'stroke-tool/70', out: 'stroke-edge' };
const hue: Record<Tone, string> = { core: 'fill-accent', plug: 'fill-tool', out: 'fill-ink' };
// [x, y, w, h, tone, title, sublabels, emphasised sublabel index, coloured title]
type N = [number, number, number, number, Tone, string, string[], number?, boolean?];
const nodes: N[] = [
  // CORE
  [28, 114, 296, 64, 'core', 'config layers', ['image.comfyui_url · image.workflow', 'machine-level only: a project’s value is dropped', 'reaches the plugin as ctx.config — validated'], 1],
  [28, 196, 296, 52, 'core', 'AgentLoop', ['runs the call · observes the result', 'fills Observation.artifact — validated'], undefined, true],
  [28, 266, 296, 64, 'core', 'ToolRegistry', ['generate_image · bare name · global scope', 'capability floor reads ingest · host', 'applied once every plugin has started']],
  [28, 348, 296, 64, 'core', 'artifact folder', ['core/artifacts.py · ctx.paths.artifact_dir', '<state dir>/artifacts/image/', 'png · jpeg · webp · core-minted id · no overwrite'], 1],
  [28, 430, 296, 76, 'core', 'plugins enable image', ['cli/plugins_cmd.py · on a terminal', 'asks the ComfyUI address', 'writes the machine’s overrides.yaml', 'runs the doctor check once — fails → setup text'], 3],
  // IMAGE PLUGIN
  [388, 114, 356, 64, 'plug', 'ImagePlugin', ['tools/builtin/image_plugin.py', 'kind tools · off by default · wants_artifacts', 'configure(): unconfigured until comfyui_url is set'], undefined, true],
  [388, 258, 356, 76, 'plug', 'generate_image', ['generate_image_tool.py', 'the model sees prompt · width · height · steps · seed', 'ingest none · host safe · result trusted', 'no path argument — core names the file'], 3],
  [388, 356, 356, 52, 'plug', 'workflow template', ['workflows/qwen-image-2.1.json — shipped', 'image.workflow: your own · a new model = a new template']],
  [388, 422, 356, 52, 'plug', 'localharness generate-image', ['the same client and template, from the shell', 'writes to --out — not an artifact, no session']],
  [388, 488, 356, 64, 'plug', 'doctor()', ['GET /system_stats — does ComfyUI answer?', 'GET /object_info per node — model files there?', 'runs only when image is on and configured']],
  // OUTSIDE
  [836, 114, 296, 64, 'out', 'model files', ['diffusion_models · text_encoders · vae', 'for the shipped template · 7.3 · 9.4 · 0.7 GB', 'Qwen Research License · non-commercial']],
  [836, 236, 296, 120, 'out', 'your ComfyUI', ['you start it — default 127.0.0.1:8188', 'POST /prompt → GET /history → GET /view', 'runs whatever graph it is sent', '— so a project cannot choose the', 'server or the graph', '', 'LocalHarness does not start it', 'or download its model files'], 6],
];
---

<figure
  role="img"
  aria-label="Plate image: the image plugin behind core's tool and artifact seams, one picture numbered one to six. On the core side: the config layers, where image.comfyui_url and image.workflow are machine-level only and a project's value is dropped with a warning; the agent loop, which runs the call and fills the result's typed artifact field after validating it; the tool registry, where generate_image registers under its bare name and the capability floor reads its ingest and host declarations once every plugin has started; the artifact folder core computes, state dir slash artifacts slash image, which takes only png, jpeg or webp under a core-minted id and never overwrites; and plugins enable image, which on a terminal asks the ComfyUI address, writes it to the machine's overrides file and runs the doctor check once, printing the setup text if it fails. Across the plugin boundary the image plugin owns the plugin class — kind tools, off by default, asking for artifacts, unconfigured until the address is set; the generate_image tool, which the model sees with only prompt, width, height, steps and seed, declares no untrusted ingest, safe host access and a trusted result, and takes no path; the workflow template, qwen-image-2.1 shipped, or your own; the generate-image command, which writes to a file outside any session; and the doctor probe, which asks ComfyUI whether it answers and whether each node's model files are there. Outside: the model files, about seventeen gigabytes under a non-commercial licence, and your ComfyUI, which you start and which runs whatever graph it is sent. LocalHarness does not start it or download its files. One: the model calls generate_image. Two: the registry hands the call to the plugin's tool. Three: the tool posts the workflow to ComfyUI. Four: the picture comes back. Five: the tool writes it into core's folder through write_artifact. Six: the result carries the artifact reference back to the loop."
