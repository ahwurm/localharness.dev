        <line x1="566" y1="178" x2="566" y2="235" marker-end="url(#pi-tool)"></line>
        <line x1="566" y1="330" x2="566" y2="313" marker-end="url(#pi-tool)"></line>
      </g>
      <g class="fill-none stroke-accent/60" stroke-width="1.2" stroke-dasharray="4 4">
