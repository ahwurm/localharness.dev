      <rect x="824" y="92" width="320" height="488" class="fill-ink/[0.015] stroke-edge" stroke-width="1" stroke-dasharray="5 5"></rect>

      <!-- ===== edges (drawn first; each in the hue of the side it leaves) ===== -->
      <g class="fill-none stroke-accent" stroke-width="1.4">
