---
// PLATE IMAGE — what the image plugin owns versus what core provides (fig. 01 of
// /plugins/image/). Left: CORE (the registry and its capability floor, the config layers
// with the machine-level-only fields, the artifact folder core computes). Hairline: the plugin
// boundary. Middle: the IMAGE PLUGIN (the generate_image tool, the plugin class, the command and
// doctor). Right: OUTSIDE (your ComfyUI server). Badges ①–⑤ =
// one picture. Sources (localharness main @ 582b69c, v0.16.0): tools/builtin/image_plugin.py,
// tools/builtin/generate_image_tool.py, docs/specs/09-hooks-plugins.md "The bundled plugins" +
// "Artifacts", SECURITY.md "Plugins", CHANGELOG [0.16.0] Known limitations. Geometry and colours
// from plateTokens.ts. Marker ids pi-*. SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';
import { nodeBox, edge } from './plateTokens';

type Tone = 'core' | 'plugin' | 'out';
const stroke: Record<Tone, string> = { core: 'stroke-accent/70', plugin: 'stroke-tool/70', out: 'stroke-edge' };
const ink: Record<Tone, string> = { core: 'fill-ink', plugin: 'fill-tool', out: 'fill-ink' };
// [x, y, w, h, tone, label, sublabels]
const nodes: [number, number, number, number, Tone, string, string[]][] = [
  [28, 114, 416, 52, 'core', 'ToolRegistry', ['registers generate_image', 'the capability floor reads its declarations']],
  [28, 190, 416, 52, 'core', 'config layers', ['image.comfyui_url · image.workflow — machine-level only', 'a project’s value is dropped, with a warning']],
  [28, 266, 416, 52, 'core', 'artifact folder', ['<state dir>/artifacts/image/ — core computes it', 'write_artifact: png · jpeg · webp · core-minted id · no overwrite']],
  [512, 114, 380, 52, 'plugin', 'generate_image', ['ingest none · host safe · result trusted', 'the model sees prompt · size · steps · seed — no path']],
  [512, 190, 380, 52, 'plugin', 'ImagePlugin', ['kind tools · off by default · wants_artifacts', 'configure(): unconfigured until comfyui_url is set']],
  [512, 266, 380, 52, 'plugin', 'generate-image · doctor()', ['localharness generate-image — the same, from the shell', 'doctor: does ComfyUI answer, with the model files?']],
  [938, 114, 194, 128, 'out', 'your ComfyUI', ['you start it and fetch the', 'model files — LocalHarness', 'does neither', '', 'runs the workflow template', 'shipped: qwen-image-2.1']],
];
const badge = (cx: number, cy: number, n: number, hollow = false) => ({ cx, cy, n, hollow });
const badges = [badge(478, 134, 1), badge(915, 134, 2), badge(915, 152, 3, true), badge(490, 250, 4)];
---

<figure
  role="img"
  aria-label="Plate image: what the image plugin owns and what core provides, one picture numbered one to four. Core holds the tool registry, which registers generate_image and whose capability floor reads the tool's declarations; the config layers, where image.comfyui_url and image.workflow are machine-level only and a project's value is dropped with a warning; and the artifact folder, state dir slash artifacts slash image, which core computes and writes into only through write_artifact — png, jpeg or webp, a core-minted id, never overwriting. Across the plugin boundary the image plugin owns the generate_image tool, which declares ingest none, host safe and a trusted result and takes no path; the plugin class, kind tools, off by default, unconfigured until comfyui_url is set; and the generate-image command and a doctor check that asks ComfyUI whether it answers and has the model files. Outside: your ComfyUI server, which you start and whose model files you fetch, running the workflow template, by default the shipped qwen-image-2.1. One: the agent calls generate_image. Two: the tool posts the workflow to ComfyUI. Three: the picture comes back. Four: the tool writes it into the artifact folder through write_artifact."
>
  <div class="hidden w-full lg:block" aria-hidden="true">
    <svg viewBox="0 0 1160 424" class="w-full">
      <defs>
        <marker id="pi-solid" viewBox={edge.marker.viewBox} refX={edge.marker.refX} refY={edge.marker.refY} markerWidth={edge.marker.markerWidth} markerHeight={edge.marker.markerHeight} orient={edge.marker.orient}>
          <path d={edge.marker.path} class="fill-none stroke-accent" stroke-width={edge.marker.callArrowStroke}></path>
        </marker>
        <marker id="pi-dash" viewBox={edge.marker.viewBox} refX={edge.marker.refX} refY={edge.marker.refY} markerWidth={edge.marker.markerWidth} markerHeight={edge.marker.markerHeight} orient={edge.marker.orient}>
          <path d={edge.marker.path} class="fill-none stroke-dim" stroke-width={edge.marker.returnArrowStroke}></path>
        </marker>
        <pattern id="pi-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="stroke-dim" stroke-width="1"></line>
        </pattern>
      </defs>

      <!-- ===== header ===== -->
      <rect x="16" y="18" width="20" height="20" class="fill-tool"></rect>
      <text x="26" y="33" text-anchor="middle" class="fill-accent-ink font-mono text-[12px] font-semibold">I</text>
      <text x="46" y="34" class="fill-ink font-sans text-[15px] font-semibold">The image plugin — one tool, one folder core assigns</text>
      <text x="1144" y="16" text-anchor="end" class="fill-dim font-mono text-[8px]">LH-ARCH-001 · PLATE IMAGE · SHEET 1 OF 1</text>
      <text x="1144" y="27" text-anchor="end" class="fill-dim font-mono text-[8px]">REV 582b69c · v0.16.0 · 2026-10-02</text>
      <text x="1144" y="38" text-anchor="end" class="fill-dim font-mono text-[8px]">kind "tools" · enabled_by_default False</text>
      <text x="1144" y="63" text-anchor="end" class="fill-dim font-mono text-[9px]">what core provides · the boundary · what the plugin owns · outside</text>
      <text x="16" y="62" class="fill-dim font-mono text-[8px]">GROUPS</text>
      <rect x="64" y="53" width="10" height="10" class="fill-accent/20 stroke-accent"></rect>
      <text x="78" y="62" class="fill-dim font-mono text-[8px]">CORE</text>
      <rect x="114" y="53" width="10" height="10" class="fill-tool/20 stroke-tool"></rect>
      <text x="128" y="62" class="fill-dim font-mono text-[8px]">IMAGE PLUGIN</text>
      <rect x="200" y="53" width="10" height="10" class="fill-none stroke-edge"></rect>
      <text x="214" y="62" class="fill-dim font-mono text-[8px]">OUTSIDE</text>
      <line x1="16" y1="76" x2="1144" y2="76" class="stroke-edge" stroke-width="1"></line>

      <!-- ===== zones ===== -->
      <rect x="16" y="96" width="440" height="238" class="fill-none stroke-accent/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="28" y="89" width="36" height="14" class="fill-bg stroke-accent" stroke-width="1"></rect>
      <text x="46" y="99" text-anchor="middle" class="fill-accent font-mono text-[8px] tracking-[0.08em]">CORE</text>
      <rect x="500" y="96" width="404" height="238" class="fill-none stroke-tool/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="512" y="89" width="92" height="14" class="fill-bg stroke-tool" stroke-width="1"></rect>
      <text x="558" y="99" text-anchor="middle" class="fill-tool font-mono text-[8px] tracking-[0.08em]">IMAGE PLUGIN</text>
      <rect x="926" y="96" width="218" height="238" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="938" y="89" width="56" height="14" class="fill-bg stroke-edge" stroke-width="1"></rect>
      <text x="966" y="99" text-anchor="middle" class="fill-dim font-mono text-[8px] tracking-[0.08em]">OUTSIDE</text>
      <!-- the plugin boundary -->
      <line x1="478" y1="84" x2="478" y2="342" class="stroke-ink/70" stroke-width="1"></line>
      <text x="478" y="80" text-anchor="middle" class="fill-ink font-mono text-[8px] tracking-[0.08em]">PLUGIN BOUNDARY · IN THROUGH ctx</text>

      <!-- ===== edges (drawn under the boxes) ===== -->
      <g class="fill-none stroke-accent" stroke-width={edge.call.strokeWidth}>
        <line x1="444" y1="134" x2="511" y2="134" marker-end="url(#pi-solid)"></line>
        <line x1="892" y1="134" x2="937" y2="134" marker-end="url(#pi-solid)"></line>
        <path d="M512,158 L490,158 L490,292 L445,292" marker-end="url(#pi-solid)"></path>
      </g>
      <g class="fill-none stroke-dim" stroke-width={edge.return.strokeWidth} stroke-dasharray={edge.return.dash}>
        <line x1="938" y1="152" x2="893" y2="152" marker-end="url(#pi-dash)"></line>
        <line x1="444" y1="216" x2="511" y2="216" marker-end="url(#pi-dash)"></line>
      </g>
      <text x="452" y="128" class="fill-dim font-mono text-[8.5px]">call</text>
      <text x="896" y="128" class="fill-dim font-mono text-[8.5px]">POST</text>
      <text x="898" y="166" class="fill-dim font-mono text-[8.5px]">PNG</text>
      <text x="448" y="210" class="fill-dim font-mono text-[8.5px]">ctx.config</text>
      <text x="398" y="286" class="fill-dim font-mono text-[8.5px]">write</text>

      <!-- ===== nodes ===== -->
      {nodes.map(([x, y, w, h, tone, label, subs]) => (
        <g>
          <rect x={x} y={y} width={w} height={h} class:list={['fill-bg', stroke[tone]]} stroke-width="1.3"></rect>
          <text x={x + w / 2} y={y + nodeBox.pad.labelFromTop - 1} text-anchor="middle" class:list={[ink[tone], 'font-mono text-[12px]']}>{label}</text>
          {subs.map((s, j) => (
            <text x={x + w / 2} y={y + 33 + j * 12} text-anchor="middle" class="fill-dim font-mono text-[8.5px]">{s}</text>
          ))}
        </g>
      ))}

      <!-- ===== badges ===== -->
      {badges.map(({ cx, cy, n, hollow }) => (
        <g>
          <circle cx={cx} cy={cy} r={edge.badge.radius} class={hollow ? 'fill-surface stroke-accent/60' : 'fill-accent'} stroke-width={hollow ? 1.2 : undefined}></circle>
          <text x={cx} y={cy + edge.badge.textBaselineOffset} text-anchor="middle" class:list={[hollow ? 'fill-accent' : 'fill-accent-ink', 'font-mono text-[9px] font-semibold']}>{n}</text>
        </g>
      ))}

      <!-- ===== KEY ===== -->
      <text x="16" y="406" class="fill-dim font-mono text-[8.5px]">KEY</text>
      <line x1="44" y1="403" x2="64" y2="403" class="stroke-accent" stroke-width="1.4" marker-end="url(#pi-solid)"></line>
      <text x="70" y="406" class="fill-dim font-mono text-[8.5px]">one picture</text>
      <line x1="134" y1="403" x2="154" y2="403" class="stroke-dim" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#pi-dash)"></line>
      <text x="160" y="406" class="fill-dim font-mono text-[8.5px]">returns · settings</text>
      <rect x="266" y="399" width="8" height="8" class="fill-none stroke-ink" stroke-width="1.2"></rect>
      <text x="278" y="406" class="fill-dim font-mono text-[8.5px]">shipped</text>
      <rect x="330" y="399" width="8" height="8" class="stroke-dim" fill="url(#pi-hatch)" stroke-width="1"></rect>
      <text x="342" y="406" class="fill-dim font-mono text-[8.5px]">landing</text>
      <rect x="394" y="399" width="8" height="8" class="fill-none stroke-dim" stroke-width="1" stroke-dasharray="2 2"></rect>
      <text x="406" y="406" class="fill-dim font-mono text-[8.5px]">planned</text>
      <text x="1144" y="406" text-anchor="end" class="fill-dim font-mono text-[8.5px]">shipped — every box on this sheet, on main @ 582b69c</text>
    </svg>
  </div>

  <FlowLedger
    class="lg:hidden"
    rows={[
      { n: 1, icon: 'agent', title: 'the agent calls generate_image', text: 'prompt, size, steps, seed — no path argument', tone: 'accent' },
      { n: 2, icon: 'server', title: 'the tool posts the workflow', text: 'to your ComfyUI, at the machine-level image.comfyui_url' },
      { n: 3, icon: 'repeat', title: 'the picture comes back', text: 'from the workflow template — shipped: qwen-image-2.1' },
      { n: 4, icon: 'box', title: 'core’s folder', text: '<state dir>/artifacts/image/ — write_artifact, core-minted id, no overwrite' },
      { kind: 'loop', icon: 'check', title: 'doctor', text: 'does ComfyUI answer, with the template’s model files?' },
      { kind: 'note', text: 'off by default — localharness plugins enable image --set comfyui_url=<url>.' },
    ]}
  />
</figure>
