      <line x1="984" y1="236" x2="984" y2="179" class="fill-none stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#pi-dash)"></line>

      <text x="186" y="283" class="fill-dim font-mono text-[8.5px]">the model calls</text>
      <text x="574" y="210" class="fill-dim font-mono text-[8.5px]">tools() constructs it</text>
      <text x="574" y="325" class="fill-dim font-mono text-[8.5px]">load_template</text>
      <text x="752" y="256" class="fill-dim font-mono text-[8.5px]">POST</text>
      <text x="752" y="308" class="fill-dim font-mono text-[8.5px]">picture</text>
      <text x="327" y="392" class="fill-dim font-mono text-[8.5px]">write</text>
      <text x="752" y="534" class="fill-dim font-mono text-[8.5px]">the reachability probe</text>
      <text x="992" y="212" class="fill-dim font-mono text-[8.5px]">loads</text>

      <!-- ===== zone tabs + the plugin boundary ===== -->
      <rect x="28" y="85" width="36" height="14" class="fill-bg stroke-accent" stroke-width="1"></rect>
      <text x="46" y="95" text-anchor="middle" class="fill-accent font-mono text-[8px] tracking-[0.08em]">CORE</text>
      <line x1="356" y1="92" x2="356" y2="580" class="stroke-ink/70" stroke-width="1"></line>
      <text x="0" y="0" transform="translate(352 576) rotate(-90)" class="fill-ink font-mono text-[8px] tracking-[0.08em]">PLUGIN BOUNDARY</text>
      <rect x="388" y="85" width="182" height="14" class="fill-bg stroke-tool" stroke-width="1"></rect>
      <text x="479" y="95" text-anchor="middle" class="fill-tool font-mono text-[8px] tracking-[0.08em]">IMAGE PLUGIN · tools/builtin/</text>
      <rect x="836" y="85" width="112" height="14" class="fill-bg stroke-edge" stroke-width="1"></rect>
