---
// fig. 04 — memory at every scale. Four rungs stacked hottest-at-top inside one
// dashed container. Down the right: a solid accent rail — work settling into colder
// storage as it happens. Up the left: dashed dim edges — recall when it needs it.
// One gate square guards what becomes permanent. Plate SVG at sm+, FlowLedger rail
// below sm. Marker ids f04- prefixed. Vocabulary inlined from plateTokens.ts (do NOT
// import). Tight-corridor edges are one word; full phrasing lives in rail + aria.
import FlowLedger from './FlowLedger.astro';
---

<figure
  role="img"
  aria-label="Memory at every scale, hottest at the top. 1, the window — what the model holds right now; big results park as stubs a single call pulls back. 2, the task — a document bigger than the window is read in sections, and the section notes persist as gists. 3, the sitting — every step is recorded in order, and each sitting ends with a summary on the shelf. 4, for good — facts survive across sittings, superseded but never erased, in SQLite and a MEMORY.md you can read. Work settles downward into colder storage as it happens; when it needs something it pulls back up — a stub's full text, the shelf, or the index recalled at the start of a sitting. A gate guards what becomes permanent: surprises pass, routine does not, and idle time promotes what recurs and lets stale notes fade."
>
  <!-- sm+: architectural-plate diagram -->
  <div class="hidden w-full sm:block" aria-hidden="true">
    <svg viewBox="0 0 560 334" class="mx-auto w-full max-w-[560px]">
      <defs>
        <marker id="f04-a" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-accent" stroke-width="1.4"></path>
        </marker>
        <marker id="f04-d" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.3"></path>
        </marker>
      </defs>

      <!-- container -->
      <rect x="12" y="20" width="536" height="288" class="fill-none stroke-edge" stroke-width="1" stroke-dasharray="4 4"></rect>
      <rect x="20" y="13.5" width="146" height="13" class="fill-surface stroke-edge" stroke-width="1"></rect>
      <text x="26" y="23" class="fill-dim font-mono text-[8px] tracking-[0.08em]">ONE AGENT'S MEMORY</text>

      <!-- rungs (hottest at top) -->
      <g data-node="window">
        <rect x="72" y="40" width="388" height="50" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="86" y="69" text-anchor="start" class="fill-ink font-mono text-[12px]">the window</text>
        <text x="250" y="61" text-anchor="start" class="fill-dim font-mono text-[9px]">what the model holds right now</text>
        <text x="250" y="77" text-anchor="start" class="fill-dim font-mono text-[9px]">big results park as stubs</text>
        <circle cx="72" cy="40" r="7" class="fill-accent"></circle>
        <text x="72" y="43" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">1</text>
      </g>
      <g data-node="task">
        <rect x="72" y="106" width="388" height="50" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="86" y="135" text-anchor="start" class="fill-ink font-mono text-[12px]">the task</text>
        <text x="250" y="127" text-anchor="start" class="fill-dim font-mono text-[9px]">over-window reads, in sections</text>
        <text x="250" y="143" text-anchor="start" class="fill-dim font-mono text-[9px]">section notes persist as gists</text>
        <circle cx="72" cy="106" r="7" class="fill-accent"></circle>
        <text x="72" y="109" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">2</text>
      </g>
      <g data-node="sitting">
        <rect x="72" y="172" width="388" height="50" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="86" y="201" text-anchor="start" class="fill-ink font-mono text-[12px]">the sitting</text>
        <text x="250" y="193" text-anchor="start" class="fill-dim font-mono text-[9px]">every step recorded, in order</text>
        <text x="250" y="209" text-anchor="start" class="fill-dim font-mono text-[9px]">ends with a summary on the shelf</text>
        <circle cx="72" cy="172" r="7" class="fill-accent"></circle>
        <text x="72" y="175" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">3</text>
      </g>
      <g data-node="forgood">
        <rect x="72" y="238" width="388" height="50" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
        <text x="86" y="267" text-anchor="start" class="fill-ink font-mono text-[12px]">for good</text>
        <text x="250" y="259" text-anchor="start" class="fill-dim font-mono text-[9px]">facts — superseded, never erased</text>
        <text x="250" y="275" text-anchor="start" class="fill-dim font-mono text-[9px]">SQLite · MEMORY.md</text>
        <circle cx="72" cy="238" r="7" class="fill-accent"></circle>
        <text x="72" y="241" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">4</text>
      </g>

      <!-- down rail (right): work settles into colder storage as it happens -->
      <line x1="460" y1="65" x2="500" y2="65" class="stroke-accent" stroke-width="1.4"></line>
      <line x1="500" y1="65" x2="500" y2="263" class="stroke-accent" stroke-width="1.4"></line>
      <line x1="500" y1="131" x2="462" y2="131" class="stroke-accent" stroke-width="1.4" marker-end="url(#f04-a)"></line>
      <line x1="500" y1="197" x2="462" y2="197" class="stroke-accent" stroke-width="1.4" marker-end="url(#f04-a)"></line>
      <line x1="500" y1="263" x2="462" y2="263" class="stroke-accent" stroke-width="1.4" marker-end="url(#f04-a)"></line>
      <text x="506" y="104" text-anchor="start" class="fill-dim font-mono text-[9px]">sections</text>
      <text x="506" y="170" text-anchor="start" class="fill-dim font-mono text-[9px]">recorded</text>
      <!-- gate: what becomes permanent -->
      <rect x="493" y="223" width="14" height="14" class="fill-accent/10 stroke-accent/60" stroke-width="1.2"></rect>
      <text x="512" y="234" text-anchor="start" class="fill-dim font-mono text-[9px]">gate</text>

      <!-- up edges (left): recall when it needs it -->
      <path d="M72,131 L48,131 L48,78 L70,78" class="fill-none stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f04-d)"></path>
      <text x="50" y="128" text-anchor="start" class="fill-dim font-mono text-[9px]">pull</text>
      <path d="M72,197 L34,197 L34,66 L70,66" class="fill-none stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f04-d)"></path>
      <text x="40" y="194" text-anchor="start" class="fill-dim font-mono text-[9px]">shelf</text>
      <path d="M72,263 L20,263 L20,54 L70,54" class="fill-none stroke-dim" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#f04-d)"></path>
      <text x="26" y="260" text-anchor="start" class="fill-dim font-mono text-[9px]">recalled</text>

      <!-- legend -->
      <text x="16" y="324" class="fill-dim font-mono text-[9px]">down → as it works · up → when it needs it</text>
      <text x="544" y="324" text-anchor="end" class="fill-dim font-mono text-[9px]">① … ④ — the scales</text>
    </svg>
  </div>

  <!-- <sm: node-wire rail -->
  <FlowLedger
    class="sm:hidden"
    rows={[
      { n: 1, icon: 'doc', title: 'the window', text: 'what the model holds now — big results park as stubs' },
      { n: 2, icon: 'search', title: 'the task', text: 'over-window reads in sections — notes persist as gists' },
      { n: 3, icon: 'clock', title: 'the sitting', text: 'every step recorded — ends with a summary on the shelf' },
      { n: 4, icon: 'layers', title: 'for good', text: 'facts, superseded not erased — SQLite · MEMORY.md' },
      { kind: 'loop', title: 'the gate', text: 'surprises in, routine out' },
      { kind: 'loop', title: 'sleep', text: 'idle time files lessons and fades stale ones' },
    ]}
  />
</figure>
