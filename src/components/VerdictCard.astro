---
interface Props {
  name: string;
  tone: 'green' | 'amber' | 'neutral';
  desc: string;
}
const { name, tone, desc } = Astro.props;

const toneStyles = {
  green: 'text-accent border-accent/40 bg-accent/5',
  amber: 'text-amber border-amber/40 bg-amber/5',
  neutral: 'text-ink border-edge',
};
---

<div class="border border-edge bg-surface/60 p-6">
  <span class:list={['inline-block border px-2 py-0.5 font-mono text-sm', toneStyles[tone]]}
    >{name}</span
  >
  <p class="mt-3 text-sm text-dim">{desc}</p>
</div>
