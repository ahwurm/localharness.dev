---
import Wordmark from './Wordmark.astro';
---

<footer class="border-t border-edge">
  <div class="container-site flex flex-col gap-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-sm text-dim">MIT License · No analytics. No cookies.</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-dim">
      <a href="https://github.com/ahwurm/localharness" class="hover:text-ink transition-colors duration-150" target="_blank" rel="noopener">LocalHarness on GitHub</a>
      <a href="https://github.com/ahwurm/localshift" class="hover:text-ink transition-colors duration-150" target="_blank" rel="noopener">LocalShift on GitHub</a>
      <a href="/localshift/" class="hover:text-ink transition-colors duration-150">LocalShift</a>
      <span>© 2026</span>
    </div>
  </div>
</footer>
