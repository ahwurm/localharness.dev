---
import Wordmark from './Wordmark.astro';
---

<footer class="border-t border-edge/70">
  <div
    class="container-site flex flex-col gap-4 py-10 text-sm text-dim sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <Wordmark />
      <span class="font-mono text-xs">MIT · No analytics. No cookies.</span>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs">
      <a
        href="https://github.com/ahwurm/localharness"
        class="transition-colors duration-200 hover:text-ink"
        target="_blank"
        rel="noopener">localharness ↗</a
      >
      <a
        href="https://github.com/ahwurm/localshift"
        class="transition-colors duration-200 hover:text-ink"
        target="_blank"
        rel="noopener">localshift ↗</a
      >
      <span>© 2026</span>
    </div>
  </div>
</footer>
