---
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', external = false, class: className = '' } = Astro.props;

const base =
  'group inline-flex min-h-11 items-center gap-2 border px-5 py-2.5 font-mono text-sm transition-colors duration-200';
const styles = {
  primary: 'border-accent/50 bg-accent/10 text-accent hover:border-accent hover:bg-accent/15',
  outline: 'border-edge text-dim hover:border-accent/40 hover:text-ink',
};
---

<a
  href={href}
  class:list={[base, styles[variant], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span
    class="text-accent transition-transform duration-200 ease-reveal group-hover:translate-x-1"
    aria-hidden="true">&gt;</span
  >
  <slot />
</a>
