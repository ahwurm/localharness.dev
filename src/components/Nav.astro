---
// Site nav. Desktop (md+): inline links with a Plugins menu that opens on hover, Enter/Space or
// click — a SaaS-style "Solutions" panel listing the plugin pages. Mobile: the Plugins button opens
// a full-width scroll-over panel under the bar (tap-outside and Escape close it); the hamburger
// keeps architecture / devnotes / github. Both menus are <details>, so they work without JS; the
// script adds hover, aria-expanded, Escape and outside-click. Motion gated on reduced-motion.
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { PLUGINS } from '../data/plugins';

const path = Astro.url.pathname;
const links = [
  { href: '/architecture/', label: 'architecture' },
  { href: '/devnotes/', label: 'devnotes' },
  { href: 'https://github.com/ahwurm/localharness', label: 'github ↗', external: true },
];
const isActive = (href: string) => path === href || path === href.replace(/\/$/, '');
const onPlugin = path.startsWith('/plugins/');
const inline =
  'h-10 items-center px-3 font-mono text-[13px] text-dim transition-colors duration-200 hover:text-ink';
---

<header class="sticky top-0 z-50 border-b border-edge/70 bg-bg/80 backdrop-blur">
  <nav class="container-site flex h-14 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="text-sm text-ink transition-colors duration-200 hover:text-accent sm:text-base">
      <Wordmark />
    </a>

    <div class="flex items-center gap-1">
      <a href={links[0].href} aria-current={isActive(links[0].href) ? 'page' : undefined} class:list={[inline, 'hidden md:inline-flex', isActive(links[0].href) && 'text-ink']}>{links[0].label}</a>

      <details class="plugins md:relative" data-navmenu>
        <summary
          class:list={['plugins-toggle inline-flex cursor-pointer gap-1.5 border border-transparent', inline, onPlugin && 'text-ink']}
          aria-expanded="false"
          aria-controls="plugins-panel"
        >
          plugins
          <svg viewBox="0 0 10 10" class="chev size-2.5" aria-hidden="true"><path d="M2,3.5 L5,6.5 L8,3.5" class="fill-none stroke-current" stroke-width="1.3"></path></svg>
        </summary>
        <div
          id="plugins-panel"
          class="plugins-panel fixed inset-x-0 top-14 z-50 max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-y border-edge bg-surface md:absolute md:inset-x-auto md:right-0 md:top-full md:mt-2 md:max-h-none md:w-[32rem] md:overflow-visible md:border"
        >
          <div class="container-site py-4 md:px-4">
            <p class="eyebrow">bundled plugins</p>
            <ul class="mt-2 grid">
              {PLUGINS.map((p) => (
                <li>
                  <a
                    href={p.href}
                    aria-current={isActive(p.href) ? 'page' : undefined}
                    class="-mx-2 flex min-h-[48px] items-start gap-3 px-2 py-2.5 transition-colors duration-200 hover:bg-surface-2"
                  >
                    <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center border border-accent/40 bg-accent/10">
                      <Icon name={p.icon} class="size-3.5" />
                    </span>
                    <span class="min-w-0">
                      <span class="block font-mono text-[13px] text-ink">{p.name}</span>
                      <span class="block text-sm text-dim">{p.clause}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/architecture/#plugins" class="mt-3 flex min-h-[40px] items-center border-t border-edge/70 pt-3 font-mono text-xs text-accent/80 transition-colors hover:text-accent">
              how plugins compose →
            </a>
          </div>
        </div>
      </details>

      {links.slice(1).map((l) => (
        <a
          href={l.href}
          aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
          class:list={[inline, 'hidden md:inline-flex', !l.external && isActive(l.href) && 'text-ink']}
        >{l.label}</a>
      ))}

      <details class="menu relative md:hidden" data-navmenu>
        <summary
          class="menu-toggle inline-flex size-10 cursor-pointer items-center justify-center border border-transparent transition-colors duration-200 hover:border-edge hover:bg-surface"
          aria-label="Menu"
          aria-expanded="false"
        >
          <span class="menu-icon"><Icon name="menu" class="size-5" /></span>
          <span class="menu-icon-close"><Icon name="close" class="size-5" /></span>
        </summary>
        <div class="menu-panel absolute right-0 top-full z-50 mt-2 flex min-w-[11rem] origin-top-right flex-col border border-edge bg-surface py-1">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class:list={[
                'flex min-h-[40px] items-center px-4 font-mono text-[13px] text-dim transition-colors duration-200 hover:bg-surface-2 hover:text-ink',
                !l.external && isActive(l.href) && 'text-ink',
              ]}
            >{l.label}</a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* no disclosure triangles — the chevron / hamburger glyph is the affordance */
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: inline-flex;
  }
  .menu-icon-close {
    display: none;
  }
  details[open] .menu-icon {
    display: none;
  }
  details[open] .menu-icon-close {
    display: inline-flex;
  }
  details[open] > .menu-toggle,
  details[open] > .plugins-toggle {
    border-color: var(--color-edge);
    background-color: color-mix(in oklab, var(--color-accent) 12%, transparent);
    color: var(--color-ink);
  }
  details[open] .chev {
    transform: rotate(180deg);
  }

  /* active page: hairline accent bar on the left */
  .menu-panel a[aria-current='page'],
  .plugins-panel a[aria-current='page'] {
    box-shadow: inset 2px 0 0 0 var(--color-accent);
  }

  /* reveal on open — instant under reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    .menu-panel,
    .plugins-panel {
      transition:
        opacity 0.18s var(--ease-reveal),
        transform 0.18s var(--ease-reveal);
    }
    .chev {
      transition: transform 0.18s var(--ease-reveal);
    }
    @starting-style {
      details[open] .menu-panel,
      details[open] .plugins-panel {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }
</style>

<script>
  // Progressive enhancement — both <details> menus work without this. Adds: aria-expanded,
  // one menu open at a time, close on outside click / Escape / link follow, and on hover-capable
  // desktops the Plugins panel opens on hover; from the keyboard, Enter or Space opens it (the
  // disclosure pattern) and moving focus out closes it.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details[data-navmenu]')];
  const hoverDesk = matchMedia('(hover: hover) and (min-width: 768px)');
  menus.forEach((menu) => {
    const summary = menu.querySelector('summary')!;
    const close = () => menu.removeAttribute('open');
    menu.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(menu.open));
      if (menu.open) menus.forEach((m) => m !== menu && m.removeAttribute('open'));
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        summary.focus();
      }
    });
    menu.querySelector('summary + div')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    if (!menu.classList.contains('plugins')) return;
    let timer = 0;
    let byHover = false;
    menu.addEventListener('mouseenter', () => {
      if (!hoverDesk.matches) return;
      clearTimeout(timer);
      if (!menu.open) (byHover = true), (menu.open = true);
    });
    menu.addEventListener('mouseleave', () => {
      if (hoverDesk.matches && byHover) timer = window.setTimeout(() => ((byHover = false), close()), 150);
    });
    // a click right after a hover-open keeps the panel open instead of toggling it shut
    summary.addEventListener('click', (e) => {
      if (hoverDesk.matches && byHover) (e.preventDefault(), (byHover = false));
    });
    menu.addEventListener('focusout', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) close();
    });
  });
</script>
