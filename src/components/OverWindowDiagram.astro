---
// Over-window read path — factual vs CHANGELOG 0.5.0/0.5.1 (chunk verb, cruncher
// map-reduce, bounded hierarchical combine, number-provenance check).
// Plate SVG at sm+, FlowLedger below sm (same content — fig 01's dual pattern).
import FlowLedger from './FlowLedger.astro';
---

<FlowLedger
  class="sm:hidden"
  rows={[
    { n: 1, icon: 'doc', title: 'document', text: '> context window', tone: 'amber' },
    { n: 2, icon: 'box', title: 'chunk', text: 'structure-aware' },
    { n: 3, icon: 'search', title: 'cruncher', text: 'every section read' },
    { n: 4, icon: 'repeat', title: 'combine', text: 'bounded reduce' },
    { n: 5, icon: 'prompt', title: 'answer', text: 'figures traced ✓', tone: 'accent' },
    { kind: 'note', text: 'untraceable figures are surfaced as a warning — never silently rewritten' },
  ]}
/>

<svg
  viewBox="0 -29 560 190"
  role="img"
  aria-label="Over-window reading: a document bigger than the context window is split structure-aware, every section is read into notes, the combine is bounded, and every figure in the answer is traced back to its source note"
  class="hidden w-full sm:block"
>
  <defs>
    <marker id="arr-ow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.2"></path>
    </marker>
  </defs>

  <rect x="6" y="36" width="96" height="52" class="fill-surface stroke-amber/60" stroke-width="1.4"></rect>
  <text x="54" y="58" text-anchor="middle" class="fill-ink font-mono text-[11px]">document</text>
  <text x="54" y="74" text-anchor="middle" class="fill-dim text-[9.5px]">&gt; context window</text>

  <line x1="102" y1="62" x2="122" y2="62" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-ow)"></line>

  <rect x="124" y="36" width="88" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
  <text x="168" y="58" text-anchor="middle" class="fill-ink font-mono text-[11px]">chunk</text>
  <text x="168" y="74" text-anchor="middle" class="fill-dim text-[9.5px]">structure-aware</text>

  <line x1="212" y1="62" x2="232" y2="62" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-ow)"></line>

  <rect x="234" y="36" width="96" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
  <text x="282" y="58" text-anchor="middle" class="fill-ink font-mono text-[11px]">cruncher</text>
  <text x="282" y="74" text-anchor="middle" class="fill-dim text-[9.5px]">every section read</text>

  <line x1="330" y1="62" x2="350" y2="62" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-ow)"></line>

  <rect x="352" y="36" width="88" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
  <text x="396" y="58" text-anchor="middle" class="fill-ink font-mono text-[11px]">combine</text>
  <text x="396" y="74" text-anchor="middle" class="fill-dim text-[9.5px]">bounded reduce</text>

  <line x1="440" y1="62" x2="460" y2="62" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-ow)"></line>

  <rect x="462" y="36" width="92" height="52" class="fill-surface stroke-accent/70" stroke-width="1.4"></rect>
  <text x="508" y="58" text-anchor="middle" class="fill-accent font-mono text-[11px]">answer</text>
  <text x="508" y="74" text-anchor="middle" class="fill-dim text-[9.5px]">figures traced ✓</text>

  <text x="280" y="118" text-anchor="middle" class="fill-dim text-[10px]">untraceable figures are surfaced as a warning — never silently rewritten</text>
</svg>
