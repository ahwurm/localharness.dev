---
// The out-of-the-box story, felt: three REAL artifacts, tabbable. No fabricated
// content — `orchestrator.yaml` is what `localharness start` generates; `web-researcher`
// is verbatim-abridged from src/localharness/agent/subagent.py @ main (built-ins
// ship as code — YOUR agents are the YAML); the third tab is a real
// `agent create --dry-run` invocation + its verbatim output.
const tabs = [
  {
    id: 'orchestrator',
    file: '~/.localharness/agents/orchestrator.yaml',
    note: 'What start gives you — a working agent is three lines.',
    lang: 'yaml',
  },
  {
    id: 'web-researcher',
    file: 'src/localharness/agent/subagent.py — built in (abridged)',
    note: 'In the box: quarantined to web tools, and it spawns its own blind fact-checker. explore ships alongside.',
    lang: 'py',
  },
  {
    id: 'yours',
    file: 'your terminal',
    note: 'One command scaffolds the next one.',
    lang: 'sh',
  },
];
---

<div id="yaml-tabs" class="overflow-hidden border border-edge bg-surface/80">
  <div class="flex flex-wrap items-center gap-1 border-b border-edge/70 px-2 py-1.5" role="tablist" aria-label="Agent YAML examples">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`yt-tab-${t.id}`}
          aria-controls={`yt-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-yt-tab={t.id}
          class:list={[
            'border px-3 py-1.5 font-mono text-xs transition-colors duration-200',
            i === 0 ? 'border-accent/50 bg-accent/10 text-accent' : 'border-transparent text-dim hover:text-ink',
          ]}
        >
          {t.id}
        </button>
      ))
    }
  </div>

  <div data-yt-panel="orchestrator" id="yt-panel-orchestrator" role="tabpanel" aria-labelledby="yt-tab-orchestrator">
    <div class="border-b border-edge/60 px-4 py-1.5 font-mono text-[11px] text-dim">~/.localharness/agents/orchestrator.yaml</div>
    <pre class="overflow-x-auto whitespace-pre-wrap [overflow-wrap:anywhere] p-4 font-mono text-[13px] leading-relaxed text-ink sm:whitespace-pre"><code><span class="text-dim">model:</span> inherit
<span class="text-dim">name:</span> orchestrator
<span class="text-dim">role:</span> General-purpose assistant</code></pre>
  </div>

  <div data-yt-panel="web-researcher" id="yt-panel-web-researcher" role="tabpanel" aria-labelledby="yt-tab-web-researcher" hidden>
    <div class="border-b border-edge/60 px-4 py-1.5 font-mono text-[11px] text-dim">src/localharness/agent/subagent.py — built in (abridged)</div>
    <pre class="overflow-x-auto whitespace-pre-wrap [overflow-wrap:anywhere] p-4 font-mono text-[13px] leading-relaxed text-ink sm:whitespace-pre"><code><span class="text-dim"># Web-research child: searches + reads pages in ITS OWN context, …</span>
<span class="text-dim"># … raw pages never enter the parent's context window.</span>
WEB_TOOLS: list[str] = [<span class="text-accent/90">"web_search"</span>, <span class="text-accent/90">"web_fetch"</span>, <span class="text-accent/90">"web_page_query"</span>]
WEB_MAX_ACTIONS = 28

<span class="text-dim"># …so it can nest a grandchild (e.g. web-researcher -> search-verifier…)</span>
NON_LEAF_AGENTS: dict[str, list[str]] = &lbrace;<span class="text-accent/90">"web-researcher"</span>: [<span class="text-accent/90">"search-verifier"</span>]&rbrace;</code></pre>
  </div>

  <div data-yt-panel="yours" id="yt-panel-yours" role="tabpanel" aria-labelledby="yt-tab-yours" hidden>
    <div class="border-b border-edge/60 px-4 py-1.5 font-mono text-[11px] text-dim">your terminal</div>
    <pre class="overflow-x-auto whitespace-pre-wrap [overflow-wrap:anywhere] p-4 font-mono text-[13px] leading-relaxed text-ink sm:whitespace-pre"><code><span class="text-accent/80">$</span> localharness agent create repo-auditor \
    --role "Audits a repository and reports findings" --global --dry-run
<span class="text-dim">name:</span> repo-auditor
<span class="text-dim">role:</span> Audits a repository and reports findings
<span class="text-dim">model:</span> inherit</code></pre>
  </div>

  <div class="border-t border-edge/70 px-4 py-2.5 font-mono text-xs text-dim">
    {
      tabs.map((t, i) => (
        <span data-yt-note={t.id} hidden={i !== 0}>
          {t.note}
        </span>
      ))
    }
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('yaml-tabs');
    if (!root) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-yt-tab]')];
    const activate = (id: string) => {
      tabs.forEach((b) => {
        const on = b.dataset.ytTab === id;
        b.setAttribute('aria-selected', String(on));
        b.classList.toggle('border-accent/50', on);
        b.classList.toggle('bg-accent/10', on);
        b.classList.toggle('text-accent', on);
        b.classList.toggle('border-transparent', !on);
        b.classList.toggle('text-dim', !on);
      });
      root.querySelectorAll<HTMLElement>('[data-yt-panel]').forEach((p) => (p.hidden = p.dataset.ytPanel !== id));
      root.querySelectorAll<HTMLElement>('[data-yt-note]').forEach((n) => (n.hidden = n.dataset.ytNote !== id));
    };
    tabs.forEach((b) => b.addEventListener('click', () => activate(b.dataset.ytTab!)));
  })();
</script>
