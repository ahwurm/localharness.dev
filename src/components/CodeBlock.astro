---
interface Props {
  code: string;
  label?: string;
  class?: string;
}
const { code, label, class: className = '' } = Astro.props;
---

<div class:list={['overflow-hidden border border-edge bg-surface/80', className]}>
  {
    label && (
      <div class="flex items-center justify-between border-b border-edge/70 py-1.5 pl-4 pr-2">
        <span class="font-mono text-xs text-dim">{label}</span>
        <button
          type="button"
          data-copy={code}
          aria-label="Copy to clipboard"
          class="border border-transparent px-2 py-0.5 font-mono text-xs text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
        >
          copy
        </button>
      </div>
    )
  }
  <div class="relative">
    <pre class="overflow-x-auto p-4 font-mono text-sm leading-relaxed text-ink"><code>{code}</code></pre>
    {
      !label && (
        <button
          type="button"
          data-copy={code}
          aria-label="Copy to clipboard"
          class="absolute right-2.5 top-2.5 border border-edge bg-bg/70 px-2 py-1 font-mono text-xs text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
        >
          copy
        </button>
      )
    }
  </div>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    const prev = btn.textContent;
    btn.textContent = 'copied';
    btn.classList.add('text-accent', 'border-accent/40');
    setTimeout(() => {
      btn.textContent = prev;
      btn.classList.remove('text-accent', 'border-accent/40');
    }, 1200);
  });
</script>
