---
// Generic replayed-terminal (lighter sibling of DemoSession): server renders the
// complete static transcript; JS (motion permitting) hides-then-replays, typing
// command lines. Content must be REAL captured output — provenance at call site.
export interface RLine {
  kind: 'cmd' | 'out' | 'good' | 'dim';
  text: string;
  d?: number;
}
interface Props {
  lines: RLine[];
  title?: string;
  class?: string;
}
const { lines, title = 'terminal', class: className = '' } = Astro.props;
const uid = `rt-${Math.random().toString(36).slice(2, 8)}`;
const program = lines.map((l, i) => ({ i, kind: l.kind, d: l.d ?? 300, text: l.kind === 'cmd' ? l.text : null }));
---

<div id={uid} data-replay-terminal class:list={['overflow-hidden border border-edge bg-surface/80', className]}>
  <div class="flex items-center justify-between border-b border-edge/70 px-4 py-2">
    <span class="truncate font-mono text-xs text-dim">{title}</span>
    <button
      type="button"
      data-rt-replay
      class="hidden border border-edge px-2 py-0.5 font-mono text-[11px] text-dim transition-colors duration-200 hover:border-accent/40 hover:text-ink"
      >replay</button
    >
  </div>
  <div data-rt-body class="h-[420px] overflow-y-auto p-4 font-mono text-[13px] leading-[1.75] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {
      lines.map((l, i) => {
        if (l.kind === 'cmd')
          return (
            <div data-rt-line={i}>
              <span class="select-none text-accent/80">$ </span>
              <span class="text-ink" data-rt-typed={i}>{l.text}</span>
            </div>
          );
        if (l.kind === 'good')
          return (
            <div data-rt-line={i} class="whitespace-pre-wrap text-accent/90">{l.text}</div>
          );
        if (l.kind === 'dim')
          return (
            <div data-rt-line={i} class="whitespace-pre-wrap text-dim">{l.text}</div>
          );
        return (
          <div data-rt-line={i} class="whitespace-pre-wrap text-ink/85">{l.text}</div>
        );
      })
    }
  </div>
  <script type="application/json" data-rt-program set:html={JSON.stringify(program)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-replay-terminal]').forEach((root) => {
    if (root.dataset.rtInit) return;
    root.dataset.rtInit = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const programEl = root.querySelector('[data-rt-program]');
    const body = root.querySelector<HTMLElement>('[data-rt-body]');
    const btn = root.querySelector<HTMLElement>('[data-rt-replay]');
    if (!programEl || !body) return;
    const program = JSON.parse(programEl.textContent || '[]') as { i: number; kind: string; d: number; text: string | null }[];
    const lineEls = [...root.querySelectorAll<HTMLElement>('[data-rt-line]')];
    let timers: number[] = [];
    let played = false;
    const at = (t: number, fn: () => void) => timers.push(window.setTimeout(fn, t));

    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      lineEls.forEach((el) => el.classList.add('demo-hidden'));
      root.querySelectorAll<HTMLElement>('[data-rt-typed]').forEach((el) => (el.textContent = ''));
      body.scrollTop = 0;
      let t = 300;
      for (const step of program) {
        t += step.d;
        const reveal = t;
        at(reveal, () => {
          lineEls[step.i].classList.remove('demo-hidden');
          body.scrollTop = body.scrollHeight;
        });
        if (step.kind === 'cmd' && step.text) {
          const typed = root.querySelector<HTMLElement>(`[data-rt-typed="${step.i}"]`);
          const chars = step.text.split('');
          chars.forEach((c, ci) =>
            at(reveal + 120 + ci * 12, () => {
              if (typed) typed.textContent += c;
            })
          );
          t = reveal + 120 + chars.length * 12 + 120;
        }
      }
    };

    btn?.classList.remove('hidden');
    btn?.addEventListener('click', play);
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting) && !played) {
          played = true;
          play();
          io.disconnect();
        }
      },
      { threshold: 0.3 }
    ).observe(root);
  });
</script>

<style is:global>
  [data-replay-terminal] .demo-hidden {
    display: none;
  }
</style>
