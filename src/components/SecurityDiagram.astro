---
// Structural injection defense — factual vs SECURITY.md: untrusted-ingesting agents
// never co-reside with host-mutating tools; enforced at tool resolution; fails closed.
// Plate SVG at sm+, FlowLedger below sm (same content — fig 01's dual pattern).
import FlowLedger from './FlowLedger.astro';
---

<FlowLedger
  class="sm:hidden"
  rows={[
    { n: 1, title: 'untrusted content', text: 'the web, fetched pages', tone: 'amber' },
    { n: 2, title: 'web-researcher', text: 'quarantine — web tools only, no bash · write · edit' },
    { n: 3, title: 'your agent', text: 'structured summary in — host tools stay clean' },
    { kind: 'blocked', title: 'bash · write · edit', text: 'host-mutating tools — no path from untrusted content' },
    { kind: 'note', text: 'refused where tools are resolved — fails closed, not left to the model' },
  ]}
/>

<svg
  viewBox="0 0 560 190"
  role="img"
  aria-label="Structural prompt-injection defense: untrusted web content flows only into a quarantined web-researcher with web tools; a structured summary crosses to your agent; the path from untrusted content to host-mutating tools like bash, write, and edit is refused at tool resolution and fails closed"
  class="hidden w-full sm:block"
>
  <defs>
    <marker id="arr-sec" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.2"></path>
    </marker>
  </defs>

  <rect x="8" y="30" width="128" height="52" class="fill-surface stroke-amber/70" stroke-width="1.4"></rect>
  <text x="72" y="52" text-anchor="middle" class="fill-amber font-mono text-[11px]">untrusted content</text>
  <text x="72" y="68" text-anchor="middle" class="fill-dim text-[9.5px]">the web, fetched pages</text>

  <line x1="136" y1="56" x2="168" y2="56" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-sec)"></line>

  <rect x="162" y="14" width="180" height="86" class="fill-none stroke-edge" stroke-width="1.2" stroke-dasharray="6 5"></rect>
  <text x="176" y="32" class="fill-dim font-mono text-[10px]">quarantine</text>
  <rect x="180" y="40" width="144" height="48" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
  <text x="252" y="60" text-anchor="middle" class="fill-ink font-mono text-[11px]">web-researcher</text>
  <text x="252" y="76" text-anchor="middle" class="fill-dim text-[9.5px]">web tools only — no bash · write · edit</text>

  <line x1="342" y1="56" x2="418" y2="56" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr-sec)"></line>
  <text x="380" y="46" text-anchor="middle" class="fill-dim text-[9px]">structured summary</text>

  <rect x="420" y="30" width="128" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
  <text x="484" y="52" text-anchor="middle" class="fill-ink font-mono text-[11px]">your agent</text>
  <text x="484" y="68" text-anchor="middle" class="fill-dim text-[9.5px]">host tools stay clean</text>

  <!-- blocked path -->
  <path d="M72,82 L72,146 L232,146" class="fill-none stroke-amber/50" stroke-width="1.2" stroke-dasharray="4 4"></path>
  <rect x="236" y="122" width="180" height="48" class="fill-none stroke-edge" stroke-width="1.3"></rect>
  <text x="326" y="142" text-anchor="middle" class="fill-dim font-mono text-[11px]">bash · write · edit</text>
  <text x="326" y="158" text-anchor="middle" class="fill-dim text-[9.5px]">host-mutating tools</text>
  <g>
    <line x1="219" y1="133" x2="245" y2="159" class="stroke-amber" stroke-width="1.6"></line>
    <line x1="245" y1="133" x2="219" y2="159" class="stroke-amber" stroke-width="1.6"></line>
  </g>
  <text x="326" y="185" text-anchor="middle" class="fill-dim text-[10px]">refused where tools are resolved — fails closed, not left to the model</text>
</svg>
