---
// Living architecture diagram — verified against docs/specs + src/localharness/agent/subagent.py.
// Subagent names are the real ones from code: web-researcher (nests search-verifier), cruncher.
// data-node attributes are lit in sync with the replayed session in DemoSession.astro.
---

<svg
  viewBox="0 0 520 470"
  role="img"
  aria-label="LocalHarness architecture: an orchestrator routes to isolated agents — web-researcher with a nested search-verifier, cruncher, and your own YAML agents — over a typed event bus, a guarded ReAct loop, tools under deny-first permissions, and provider auto-detection against local endpoints"
  class="w-full min-w-[440px]"
>
  <defs>
    <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.2"></path>
    </marker>
  </defs>

  <!-- orchestrator -->
  <g data-node="orchestrator">
    <rect x="130" y="10" width="260" height="46" class="fill-surface stroke-edge" stroke-width="1.5"></rect>
    <text x="260" y="30" text-anchor="middle" class="fill-ink font-mono text-[13px] font-medium">orchestrator</text>
    <text x="260" y="46" text-anchor="middle" class="fill-dim text-[10px]">thin — route · index · escalate</text>
  </g>

  <line x1="260" y1="56" x2="260" y2="76" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- agents -->
  <rect x="14" y="82" width="492" height="112" class="fill-none stroke-edge" stroke-width="1.2" stroke-dasharray="6 5"></rect>
  <text x="28" y="102" class="fill-dim font-mono text-[10px]">agents — isolated context + memory</text>

  <g data-node="agent">
    <rect x="24" y="112" width="80" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
    <text x="64" y="134" text-anchor="middle" class="fill-ink font-mono text-[11px]">default</text>
    <text x="64" y="150" text-anchor="middle" class="fill-dim text-[9.5px]">this session</text>
  </g>
  <g data-node="explore">
    <rect x="114" y="112" width="80" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
    <text x="154" y="134" text-anchor="middle" class="fill-ink font-mono text-[11px]">explore</text>
    <text x="154" y="150" text-anchor="middle" class="fill-dim text-[9.5px]">read-only</text>
  </g>
  <g data-node="web-researcher">
    <rect x="204" y="112" width="122" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
    <text x="265" y="134" text-anchor="middle" class="fill-ink font-mono text-[11px]">web-researcher</text>
    <text x="265" y="150" text-anchor="middle" class="fill-dim text-[9.5px]">nests search-verifier</text>
  </g>
  <g data-node="cruncher">
    <rect x="336" y="112" width="88" height="52" class="fill-surface stroke-edge" stroke-width="1.4"></rect>
    <text x="380" y="134" text-anchor="middle" class="fill-ink font-mono text-[11px]">cruncher</text>
    <text x="380" y="150" text-anchor="middle" class="fill-dim text-[9.5px]">over-window</text>
  </g>
  <g>
    <rect x="434" y="112" width="60" height="52" class="fill-none stroke-edge" stroke-width="1.2" stroke-dasharray="4 4"></rect>
    <text x="464" y="134" text-anchor="middle" class="fill-dim font-mono text-[11px]">yours</text>
    <text x="464" y="150" text-anchor="middle" class="fill-dim text-[9.5px]">yaml</text>
  </g>

  <line x1="260" y1="194" x2="260" y2="214" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- event bus -->
  <g data-node="bus">
    <rect x="14" y="220" width="492" height="34" class="fill-surface stroke-edge" stroke-width="1.5"></rect>
    <text x="260" y="242" text-anchor="middle" class="fill-ink font-mono text-[12px]">typed event bus</text>
  </g>
  <text x="260" y="270" text-anchor="middle" class="fill-dim text-[9.5px]">every action and observation — an append-only jsonl trace</text>

  <line x1="260" y1="278" x2="260" y2="296" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- guarded loop -->
  <g data-node="loop">
    <rect x="130" y="302" width="260" height="46" class="fill-surface stroke-edge" stroke-width="1.5"></rect>
    <text x="260" y="322" text-anchor="middle" class="fill-ink font-mono text-[12px]">react loop</text>
    <text x="260" y="338" text-anchor="middle" class="fill-dim text-[10px]">stuck detection · budgets · compaction</text>
  </g>

  <line x1="260" y1="348" x2="260" y2="366" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- tools -->
  <g data-node="tools">
    <rect x="14" y="372" width="492" height="44" class="fill-surface stroke-edge" stroke-width="1.5"></rect>
    <text x="260" y="390" text-anchor="middle" class="fill-ink font-mono text-[12px]">tools — deny-first permissions</text>
    <text x="260" y="406" text-anchor="middle" class="fill-dim text-[10px]">read · write · edit · glob · grep · bash · agent · web</text>
  </g>

  <line x1="260" y1="416" x2="260" y2="432" class="stroke-dim" stroke-width="1.2" marker-end="url(#arr)"></line>

  <!-- endpoints -->
  <g data-node="provider">
    <rect x="42" y="438" width="100" height="26" class="fill-none stroke-accent/60" stroke-width="1.3"></rect>
    <text x="92" y="455" text-anchor="middle" class="fill-ink font-mono text-[11px]">vLLM</text>
    <rect x="154" y="438" width="100" height="26" class="fill-none stroke-edge" stroke-width="1.3"></rect>
    <text x="204" y="455" text-anchor="middle" class="fill-dim font-mono text-[11px]">Ollama</text>
    <rect x="266" y="438" width="100" height="26" class="fill-none stroke-edge" stroke-width="1.3"></rect>
    <text x="316" y="455" text-anchor="middle" class="fill-dim font-mono text-[11px]">LM Studio</text>
    <rect x="378" y="438" width="100" height="26" class="fill-none stroke-edge" stroke-width="1.3"></rect>
    <text x="428" y="455" text-anchor="middle" class="fill-dim font-mono text-[11px]">llama.cpp</text>
  </g>
</svg>
