---
// Shared closing section: issues / docs / star cards. Owns its full
// <section> wrapper (SectionBand title + data-reveal + container) so `/` and
// /architecture/ can't drift. One instance per page (id="get-involved").
// Title is a SectionBand to match the demo sections' band style (Alex 2026-07-04).
import Chip from './Chip.astro';
import SectionBand from './SectionBand.astro';
---

<section id="get-involved" data-reveal>
  <SectionBand icon="globe" title="Get Involved" />
  <div class="container-site py-16 sm:py-20">
    <h3 class="text-xl font-medium tracking-[-0.01em] text-ink">Become a contributor.</h3>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <a
        href="https://github.com/ahwurm/localharness/issues"
        target="_blank"
        rel="noopener"
        class="group border border-edge bg-surface/60 p-5 transition-colors duration-200 hover:border-accent/40"
      >
        <Chip icon="issue" label="issues" class="border-0 bg-transparent px-0 py-0" />
        <p class="mt-1.5 text-sm text-dim">Bugs and feature requests — welcome.</p>
        <span class="mt-3 inline-block font-mono text-xs text-accent/80 transition-colors group-hover:text-accent">github ↗</span>
      </a>
      <a
        href="https://github.com/ahwurm/localharness/tree/main/docs"
        target="_blank"
        rel="noopener"
        class="group border border-edge bg-surface/60 p-5 transition-colors duration-200 hover:border-accent/40"
      >
        <Chip icon="book" label="docs" class="border-0 bg-transparent px-0 py-0" />
        <p class="mt-1.5 text-sm text-dim">Component specs + reference architectures.</p>
        <span class="mt-3 inline-block font-mono text-xs text-accent/80 transition-colors group-hover:text-accent">docs ↗</span>
      </a>
      <a
        href="https://github.com/ahwurm/localharness"
        target="_blank"
        rel="noopener"
        class="group border border-edge bg-surface/60 p-5 transition-colors duration-200 hover:border-accent/40"
      >
        <Chip icon="star" label="star" class="border-0 bg-transparent px-0 py-0" />
        <p class="mt-1.5 text-sm text-dim">If it's useful, star it — it helps others find it.</p>
        <span class="mt-3 inline-block font-mono text-xs text-accent/80 transition-colors group-hover:text-accent">star on github ↗</span>
      </a>
    </div>
  </div>
</section>
