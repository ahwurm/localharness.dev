      <text x="28" y="476" class="fill-dim font-mono text-[8.5px]">events nothing sends: MemoryGateFired · ExpectationAttached · OutcomeObserved · SurpriseScored · TurnEndMicroPassCompleted</text>
      <text x="28" y="490" class="fill-dim font-mono text-[8.5px]">setting nothing reads: agent.memory.inject_into_context — accepted, does nothing</text>

      <!-- ===== KEY ===== -->
      <text x="16" y="522" class="fill-dim font-mono text-[8.5px]">KEY</text>
      <line x1="44" y1="519" x2="64" y2="519" class="stroke-mem" stroke-width="1.4" marker-end="url(#p5-solid)"></line>
      <text x="70" y="522" class="fill-dim font-mono text-[8.5px]">a fact's life</text>
      <rect x="148" y="515" width="8" height="8" class="fill-none stroke-ink" stroke-width="1.2"></rect>
      <text x="160" y="522" class="fill-dim font-mono text-[8.5px]">shipped</text>
      <rect x="212" y="515" width="8" height="8" class="stroke-dim" fill="url(#p5-hatch)" stroke-width="1"></rect>
      <text x="224" y="522" class="fill-dim font-mono text-[8.5px]">landing</text>
      <rect x="276" y="515" width="8" height="8" class="fill-none stroke-dim" stroke-width="1" stroke-dasharray="2 2"></rect>
      <text x="288" y="522" class="fill-dim font-mono text-[8.5px]">planned</text>
      <rect x="342" y="515" width="8" height="8" class="fill-none stroke-mem/70" stroke-width="1.2" stroke-dasharray="4 3"></rect>
      <text x="354" y="522" class="fill-dim font-mono text-[8.5px]">shipped, off by default</text>
      <text x="1144" y="522" text-anchor="end" class="fill-dim font-mono text-[8.5px]">shipped — every solid box, on main @ 582b69c</text>
    </svg>
  </div>

  <FlowLedger
    class="lg:hidden"
    rows={[
      ...life.map(([label, lines], i) => ({ n: i + 1, icon: (['doc', 'check', 'search', 'clock', 'layers'] as const)[i], title: label, text: lines.join(' ') })),
      { kind: 'note', text: 'one score ranks every fact: S = ln(1 + standing) + truth + stakes — the char budget is the whole gate.' },
      { kind: 'note', text: 'inert: several memory event types nothing sends, and agent.memory.inject_into_context, which nothing reads.' },
    ]}
  />
</figure>
