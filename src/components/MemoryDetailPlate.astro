      <rect x="866" y="170" width="266" height="56" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="999" y="188" text-anchor="middle" class="fill-ink font-mono text-[12px]">gists route</text>
      <text x="999" y="204" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">neighborhood BFS (≤4)</text>
      <text x="999" y="216" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">route retrieval — they never inject</text>

      <rect x="866" y="236" width="266" height="46" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="999" y="254" text-anchor="middle" class="fill-ink font-mono text-[12px]">FTS5</text>
      <text x="999" y="272" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">every token quoted · operators stay literal</text>

