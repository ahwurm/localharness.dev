      <text x="484" y="458" class="fill-dim font-mono text-[8.5px]">planned</text>
    </svg>
  </div>

  <!-- <sm: node-wire rail — the five lifecycle steps + the line invariant -->
  <FlowLedger
    class="lg:hidden"
