---
// DETAIL M·A — inside the memory store: one fact's life (fig. 02 of /plugins/memory/).
// Rebuilt 2026-10-02 against localharness main @ 98682e4 (resonance design). The v0.9.0
// sheet's visibility line (conf ≥ 0.7 AND rs ≥ 0.2), half-life decay and cap-trim are gone
// from the code; today one salience currency ranks every active fact and the char budget is
// the whole gate. Sources: memory/sqlite.py (store_fact, writer_precision,
// settle_writer_outcomes, _render_memory_index_with_ids), memory/salience.py,
// memory/consolidation.py, memory/config.py (archival default off), CHANGELOG 0.16.0 Known
// limitations (the inert events and setting). Badges ①–⑤ ride the lifecycle rail.
// Marker ids p5-*. SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';

const life: [string, string[]][] = [
  ['written', ['a bet: birth truth =', 'the writer’s measured record', 'read back, or MemoryVerifyError']],
  ['seen again', ['same value, other episode →', 'adds the sighter’s weight', 'new value → supersedes; old stays']],
  ['recalled', ['search · get · injected', 'reads bump _staged twins only', 'recalled = proven useful']],
  ['dreamed', ['embed-backfill → digest → bind', '→ fold + settle the ledger', 'any user turn cancels']],
  ['archived', ['below the proven-useful line', 'off by default · nothing deleted', 'restore is one verb']],
];
const lx = (i: number) => 28 + i * 223; // box x; w = 209
---

<figure
  role="img"
  aria-label="Detail M A, a zoom into the memory store: one fact's life, numbered one to five. On the left, the record — one facts-table row: key, value, provenance and source, the writer; truth in log-odds, standing and importance; access counts with staged twins; node kind; status, active or superseded; and an embedding vector. One active row per key is enforced by a partial unique index. In the middle, the currency: every active fact competes on one salience score, S equals the log of one plus standing, plus truth, plus stakes — need from dreaming's resonance, truth moved only by evidence, stakes the one human input — and the character budget is the whole gate: lines render in salience order until the budget is spent, under named groups and above the session shelf, byte-stable between store changes with no clock term. On the right, the writers ledger: bets, confirmed, contradicted, paid and lost; a writer's birth truth is its Laplace-smoothed precision, so a cold writer starts at one half, log-odds zero; each dreaming pass settles paid as recalled and lost as archived without recall. The life: one, written as a bet and read back; two, seen again — the same value from another episode adds the sighter's weight, a new value supersedes and the old row stays; three, recalled by search, get or injection, reads touching staged counters only; four, dreamed over while idle — embed-backfill, digest, bind, fold and settle — cancelled by any user turn; five, archived below the line of the worst proven-useful fact, which is off by default, deletes nothing and is restored with one verb. Drawn as inert: five memory event types still defined that nothing sends, and the inject_into_context setting that nothing reads."
>
  <div class="hidden w-full lg:block" aria-hidden="true">
    <svg viewBox="0 0 1160 536" class="w-full">
      <defs>
        <marker id="p5-solid" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.2" markerHeight="6.2" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-mem" stroke-width="1.4"></path>
        </marker>
        <marker id="p5-dash" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.3"></path>
        </marker>
        <pattern id="p5-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="stroke-dim" stroke-width="1"></line>
        </pattern>
      </defs>

      <!-- ===== header ===== -->
      <rect x="16" y="18" width="28" height="20" class="fill-mem"></rect>
      <text x="30" y="33" text-anchor="middle" class="fill-bg font-mono text-[11px] font-semibold">M·A</text>
      <text x="54" y="34" class="fill-ink font-sans text-[15px] font-semibold">inside the memory store — one fact's life</text>
      <text x="54" y="58" class="fill-dim font-mono text-[9px]">DETAIL M·A · zoom into memory/sqlite.py · owned by the plugin, behind the slot</text>
      <text x="1144" y="16" text-anchor="end" class="fill-dim font-mono text-[8px]">LH-ARCH-001 · DETAIL M·A · SHEET 2 OF 2</text>
      <text x="1144" y="27" text-anchor="end" class="fill-dim font-mono text-[8px]">REV 582b69c · v0.16.0 · 2026-10-02</text>
      <text x="1144" y="58" text-anchor="end" class="fill-dim font-mono text-[9px]">one row · one currency · one ledger</text>
      <line x1="16" y1="76" x2="1144" y2="76" class="stroke-edge" stroke-width="1"></line>

      <!-- ===== THE RECORD ===== -->
      <rect x="16" y="92" width="336" height="208" class="fill-none stroke-mem/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="28" y="85" width="72" height="14" class="fill-bg stroke-mem" stroke-width="1"></rect>
      <text x="64" y="95" text-anchor="middle" class="fill-mem font-mono text-[8px]">THE RECORD</text>
      <rect x="28" y="112" width="312" height="176" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="184" y="130" text-anchor="middle" class="fill-ink font-mono text-[12px]">facts row</text>
      <line x1="40" y1="140" x2="328" y2="140" class="stroke-mem/25" stroke-width="1"></line>
      <text x="184" y="157" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">key · value · provenance · source (the writer)</text>
      <text x="184" y="174" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">truth_logodds · standing · importance</text>
      <text x="184" y="191" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">access_count (+ _staged twins)</text>
      <text x="184" y="208" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">node_kind: fact | gist | schema</text>
      <text x="184" y="225" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">status: active | superseded → superseded_by</text>
      <text x="184" y="242" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">embedding — the resonance vector</text>
      <line x1="40" y1="254" x2="328" y2="254" class="stroke-mem/40" stroke-width="1"></line>
      <text x="184" y="274" text-anchor="middle" class="fill-mem font-mono text-[8.5px]">one active row per key · partial unique index</text>

      <!-- ===== THE CURRENCY ===== -->
      <rect x="368" y="92" width="470" height="208" class="fill-none stroke-mem/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="380" y="85" width="84" height="14" class="fill-bg stroke-mem" stroke-width="1"></rect>
      <text x="422" y="95" text-anchor="middle" class="fill-mem font-mono text-[8px]">THE CURRENCY</text>
      <rect x="380" y="112" width="446" height="72" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="603" y="130" text-anchor="middle" class="fill-ink font-mono text-[12px]">salience — one score, everywhere</text>
      <text x="603" y="146" text-anchor="middle" class="fill-mem font-mono text-[10px] font-semibold">S = ln(1 + standing) + truth + stakes</text>
      <text x="603" y="162" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">need: resonance share mass · truth: log-odds, moved by evidence</text>
      <text x="603" y="175" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">stakes: declared importance, the one human input · no clock term</text>

      <text x="603" y="202" text-anchor="middle" class="fill-mem font-mono text-[9.5px] font-semibold">the char budget is the whole gate</text>
      <line x1="380" y1="210" x2="826" y2="210" class="stroke-mem" stroke-width="2"></line>
      <line x1="380" y1="205" x2="380" y2="215" class="stroke-mem" stroke-width="2"></line>
      <line x1="826" y1="205" x2="826" y2="215" class="stroke-mem" stroke-width="2"></line>

      <rect x="380" y="222" width="446" height="66" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="603" y="239" text-anchor="middle" class="fill-ink font-mono text-[12px]">the injected index</text>
      <text x="603" y="254" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">### Groups → ### Persistent Facts (S order) → ### Recent Session History</text>
      <text x="603" y="267" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">one line per fact · full body via memory_get</text>
      <text x="603" y="280" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">byte-stable between store changes</text>

      <!-- ===== THE LEDGER ===== -->
      <rect x="854" y="92" width="290" height="208" class="fill-none stroke-mem/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="866" y="85" width="72" height="14" class="fill-bg stroke-mem" stroke-width="1"></rect>
      <text x="902" y="95" text-anchor="middle" class="fill-mem font-mono text-[8px]">THE LEDGER</text>
      <rect x="866" y="112" width="266" height="86" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="999" y="130" text-anchor="middle" class="fill-ink font-mono text-[12px]">writers</text>
      <text x="999" y="146" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">bets · confirmed · contradicted · paid · lost</text>
      <text x="999" y="162" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">birth truth = (c + 1) / (c + x + 2)</text>
      <text x="999" y="175" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">Laplace precision, in log-odds</text>
      <text x="999" y="189" text-anchor="middle" class="fill-mem font-mono text-[8.5px]">a cold writer: 0.5 — log-odds 0</text>
      <rect x="866" y="208" width="266" height="80" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
      <text x="999" y="226" text-anchor="middle" class="fill-ink font-mono text-[12px]">bets settle</text>
      <text x="999" y="242" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">paid = rows actually recalled</text>
      <text x="999" y="255" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">lost = archived, never recalled</text>
      <text x="999" y="268" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">recomputed each dreaming pass</text>
      <text x="999" y="281" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">weak sources cannot push belief high</text>

      <!-- ===== the life rail ===== -->
      <g class="fill-none stroke-mem" stroke-width="1.4">
        <path d="M184,288 L184,322 L132,322 L132,338" marker-end="url(#p5-solid)"></path>
        {life.slice(0, -1).map((_, i) => (
          <line x1={lx(i) + 209} y1="384" x2={lx(i + 1) - 1} y2="384" marker-end="url(#p5-solid)"></line>
        ))}
        <path d="M578,338 L578,322 L603,322 L603,290" marker-end="url(#p5-solid)"></path>
      </g>
      <text x="612" y="310" class="fill-dim font-mono text-[8.5px]">recalled into the index</text>

      <rect x="16" y="314" width="1128" height="124" class="fill-none stroke-mem/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="28" y="307" width="82" height="14" class="fill-bg stroke-mem" stroke-width="1"></rect>
      <text x="69" y="317" text-anchor="middle" class="fill-mem font-mono text-[8px]">THE LIFE</text>
      <text x="1132" y="309" text-anchor="end" class="fill-dim font-mono text-[8px]">written to archived — every step contained</text>

      {life.map(([label, lines], i) => (
        <g>
          {i === 4 ? (
            <rect x={lx(i)} y="338" width="209" height="92" class="fill-bg stroke-mem/70" stroke-width="1.3" stroke-dasharray="4 3"></rect>
          ) : (
            <rect x={lx(i)} y="338" width="209" height="92" class="fill-bg stroke-mem/70" stroke-width="1.3"></rect>
          )}
          <text x={lx(i) + 104} y="360" text-anchor="middle" class="fill-ink font-mono text-[12px]">{label}</text>
          {lines.map((l, j) => (
            <text x={lx(i) + 104} y={378 + j * 14} text-anchor="middle" class={j === 2 && i !== 2 ? 'fill-mem font-mono text-[8.5px]' : 'fill-dim font-mono text-[8.5px]'}>{l}</text>
          ))}
        </g>
      ))}

      <g>
        <circle cx="158" cy="322" r="7" class="fill-mem"></circle>
        <text x="158" y="325" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">1</text>
        {life.slice(0, -1).map((_, i) => (
          <g>
            <circle cx={lx(i) + 216} cy="384" r="7" class="fill-mem"></circle>
            <text x={lx(i) + 216} y="387" text-anchor="middle" class="fill-accent-ink font-mono text-[9px] font-semibold">{i + 2}</text>
          </g>
        ))}
      </g>

      <!-- ===== INERT ===== -->
      <rect x="16" y="452" width="1128" height="46" class="fill-none stroke-dim" stroke-width="1" stroke-dasharray="2 3"></rect>
      <rect x="28" y="445" width="196" height="14" class="fill-bg stroke-dim" stroke-width="1"></rect>
