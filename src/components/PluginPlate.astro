      <rect x="28" y="331" width="210" height="14" class="fill-bg stroke-tool" stroke-width="1"></rect>
      <text x="133" y="341" text-anchor="middle" class="fill-tool font-mono text-[8px] tracking-[0.08em]">BUNDLED PLUGINS · BUILTIN_PLUGINS ORDER</text>

      {plugins.map(([name, kind, lines], i) => (
        <a href={BUILT.has(name) ? `/plugins/${name}/` : '#plugins'} tabindex="-1">
          <rect x={colX(i)} y="364" width="208" height="112" class="fill-bg stroke-tool/70" stroke-width="1.3"></rect>
          <text x={colX(i) + 104} y="383" text-anchor="middle" class="fill-tool font-mono text-[12px]">{BUILT.has(name) ? `${name} →` : name}</text>
          <text x={colX(i) + 104} y="397" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">{kind}</text>
          <line x1={colX(i) + 12} y1="405" x2={colX(i) + 196} y2="405" class="stroke-tool/25" stroke-width="1"></line>
          {lines.map((l, j) => (
            <text x={colX(i) + 104} y={421 + j * 13} text-anchor="middle" class="fill-dim font-mono text-[8.5px]">{l}</text>
          ))}
        </a>
      ))}

