      <text x="184" y="62" class="fill-dim font-mono text-[8px]">PLUGINS</text>

      <line x1="16" y1="76" x2="1144" y2="76" class="stroke-edge" stroke-width="1"></line>

      <!-- ===== CORE ===== -->
      <rect x="16" y="92" width="1128" height="206" class="fill-none stroke-accent/45" stroke-width="1" stroke-dasharray="5 5"></rect>
      <rect x="28" y="85" width="36" height="14" class="fill-bg stroke-accent" stroke-width="1"></rect>
      <text x="46" y="95" text-anchor="middle" class="fill-accent font-mono text-[8px] tracking-[0.08em]">CORE</text>
