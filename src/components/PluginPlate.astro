---
// PLATE II — the plugins: a small core, five bundled plugins.
// Same construction as RuntimePlate / LoopPlate (plateTokens.ts vocabulary: dashed group
// containers with name tabs, 1.3 node strokes, accent call edges, numbered badges = flow).
// Top: CORE (the loop, the registry, config, the gate, the plugin machinery, the API) and the
// PORTS core already has. A hairline = the plugin boundary (a plugin reaches core only through
// its PluginContext). Below: the five bundled plugins in BUILTIN_PLUGINS order, each with the
// port it fills; each box links to its plugin page. Bottom: manifest → lifecycle (badges ①–⑦,
// one session's order) and the import rule (core → plugin never; BURN_DOWN empty = closed).
// Every label sourced from localharness main @ 98682e4: docs/specs/09-hooks-plugins.md,
// docs/specs/00-architecture-overview.md §3/§5, SECURITY.md "Plugins",
// tests/unit/test_import_direction.py. Marker ids p6-*. SVG at lg+; FlowLedger below.
import FlowLedger from './FlowLedger.astro';

// [name, kind line, surface lines] — code order (plugins/builtin.py BUILTIN_PLUGINS).
const plugins: [string, string, string[]][] = [
  ['image', 'kind tools · off', ['tool generate_image', 'command generate-image', 'wants_artifacts: pictures', 'needs image.comfyui_url']],
  ['web', 'kind channel · on · [web]', ['the phone app', 'command localharness web', 'channel web · own command', 'serves artifact roots']],
  ['memory', 'kind memory · on', ['fills the memory slot', 'context(turn, budget)', 'memory_search · get · remember', '/memory · localharness memory']],
  ['dispatch', 'kind channel · on · [dispatch]', ['chat — today Discord', 'channel discord', 'make_channel · warn check', 'no tool · no command']],
  ['autoresearch', 'kind dev · on', ['autoresearch · experiment · propose', 'owns proposer: · sentinel:', 'adds nothing to a session', 'the bench stays core']],
];
// The core port each plugin fills, same column.
const ports: [string, string][] = [
  ['ToolRegistry', 'tools(ctx) · bare names'],
  ['CLI mount', 'localharness web'],
  ['MemorySlot', 'slot.py · one occupant'],
  ['start --channel', 'accepted_channels'],
  ['CLI mount', 'manifest cli · lazy'],
];
// PROTOTYPE: plugin pages built so far; the others point back at #plugins until they exist.
const BUILT = new Set(['memory']);
const colX = (i: number) => 28 + i * 224; // box x; w = 208
const lifecycle: [string, string][] = [
  ['manifest', 'in code · frozen'],
  ['discover', 'metadata only'],
  ['load plan', 'one state each'],
  ['configure', 'ready | unconfigured'],
  ['tools', 'declared · checked'],
  ['start', 'then the floor'],
  ['stop', 'reverse order'],
];
const lcX = (i: number) => 30 + i * 160; // box x; w = 140
---

<figure
  role="img"
  aria-label="Plate two of the architecture drawing: the plugins — a small core and five bundled plugins. Core holds the agent loop, the tool registry, the config loader with each plugin's enabled switch and its machine-level-only fields, the permission gate that reads each tool's declared gate family, the plugin machinery — discovery, resolve, the load plan and the lifecycle — and the plugin API module. Core offers ports: the tool registry, the CLI mount, the memory slot, which holds at most one occupant, and the start --channel switch. A hairline marks the plugin boundary: a plugin reaches core only through the plugin context it is handed. Below it the five bundled plugins, in code order: image, kind tools, off by default — the generate_image tool and the generate-image command; web, kind channel — the phone app, served by localharness web; memory, kind memory — it fills the memory slot and adds the memory tools, the /memory slash command and the localharness memory command; dispatch, kind channel — chat, today Discord, through start --channel discord; autoresearch, kind dev — three commands, autoresearch, experiment and propose, and nothing added to a session. Along the bottom, numbered one to seven, each session runs: the manifest declared in code, discovery from metadata only, the load plan giving each plugin one state, then configure, tools, start — after which the capability floor applies — and stop in reverse order; every call is contained, so a plugin that raises is failed for the session and its tools and hooks are removed. The import rule: core never imports a plugin, checked by a test, and the burn-down list of old exceptions is empty — closed; the bundled-plugin list is the one exception."
>
  <div class="hidden w-full lg:block" aria-hidden="true">
    <svg viewBox="0 0 1160 664" class="w-full">
      <defs>
        <marker id="p6-solid" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.2" markerHeight="6.2" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-accent" stroke-width="1.4"></path>
        </marker>
        <marker id="p6-dash" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0.5 L7,4 L0,7.5" class="fill-none stroke-dim" stroke-width="1.3"></path>
        </marker>
        <pattern id="p6-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="stroke-dim" stroke-width="1"></line>
        </pattern>
      </defs>

      <!-- ===== header ===== -->
      <rect x="16" y="18" width="20" height="20" class="fill-accent"></rect>
      <text x="26" y="33" text-anchor="middle" class="fill-accent-ink font-mono text-[12px] font-semibold">II</text>
      <text x="46" y="34" class="fill-ink font-sans text-[15px] font-semibold">The plugins — a small core, five bundled plugins</text>

      <text x="1144" y="16" text-anchor="end" class="fill-dim font-mono text-[8px]">LH-ARCH-001 · PLATE II</text>
      <text x="1144" y="27" text-anchor="end" class="fill-dim font-mono text-[8px]">REV 98682e4 · 2026-10-02</text>
      <text x="1144" y="38" text-anchor="end" class="fill-dim font-mono text-[8px]">PLUGIN_API_VERSION "1" · additive only</text>
      <text x="1144" y="63" text-anchor="end" class="fill-dim font-mono text-[9px]">one manifest · one lifecycle · imports point one way</text>

      <text x="16" y="62" class="fill-dim font-mono text-[8px]">GROUPS</text>
      <rect x="64" y="53" width="10" height="10" class="fill-accent/20 stroke-accent"></rect>
      <text x="78" y="62" class="fill-dim font-mono text-[8px]">CORE</text>
