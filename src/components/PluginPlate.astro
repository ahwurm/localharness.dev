      <rect x="188" y="614" width="52" height="18" class="fill-bg stroke-tool/70" stroke-width="1.2"></rect>
      <text x="214" y="627" text-anchor="middle" class="fill-ink font-mono text-[9px]">plugin</text>
      <text x="250" y="627" class="fill-dim font-mono text-[8.5px]">never — test_import_direction.py scans every import</text>

      <rect x="640" y="614" width="10" height="10" class="fill-accent/20 stroke-accent" stroke-width="1"></rect>
      <path d="M642,619 L644.5,622 L648.5,616" class="fill-none stroke-accent" stroke-width="1.3"></path>
