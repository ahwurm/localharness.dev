      <text x="161" y="145" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">agent/loop.py · reason → act → observe</text>
      <text x="161" y="157" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">asks memory_slot every turn</text>

      <rect x="307" y="114" width="267" height="48" class="fill-bg stroke-accent/70" stroke-width="1.3"></rect>
      <text x="440" y="131" text-anchor="middle" class="fill-ink font-mono text-[12px]">ToolRegistry</text>
      <text x="440" y="145" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">tools/registry.py · pre / post hooks</text>
      <text x="440" y="157" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">capability floor applied after start</text>

      <rect x="586" y="114" width="267" height="48" class="fill-bg stroke-accent/70" stroke-width="1.3"></rect>
      <text x="719" y="131" text-anchor="middle" class="fill-ink font-mono text-[12px]">ConfigLoader</text>
      <text x="719" y="145" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">four layers · &lt;name&gt;.enabled</text>
      <text x="719" y="157" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">GLOBAL_ONLY fields: machine-level</text>

      <rect x="865" y="114" width="267" height="48" class="fill-bg stroke-accent/70" stroke-width="1.3"></rect>
