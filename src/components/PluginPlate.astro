          <text x={colX(i) + 104} y="273" text-anchor="middle" class="fill-dim font-mono text-[8.5px]">{sub}</text>
        </g>
      ))}

      <!-- ===== THE PLUGIN BOUNDARY (hairline) ===== -->
      <line x1="16" y1="316" x2="1144" y2="316" class="stroke-ink/70" stroke-width="1"></line>
      <text x="146" y="311" class="fill-ink font-mono text-[8px] tracking-[0.08em]">PLUGIN BOUNDARY</text>
      <text x="594" y="311" class="fill-dim font-mono text-[8px]">in through ctx</text>
      <text x="816" y="311" class="fill-dim font-mono text-[8px]">core never imports a plugin</text>

      <!-- fills edges: plugin → its core port (drawn under the boxes) -->
      <g class="fill-none stroke-accent" stroke-width="1.4">
        {ports.map((_, i) => (
          <line x1={colX(i) + 104} y1="364" x2={colX(i) + 104} y2="284" marker-end="url(#p6-solid)"></line>
        ))}
      </g>
      <text x="138" y="300" class="fill-dim font-mono text-[8.5px]">fills</text>

